+    TestVisitor() : result_("") {}
+    
+    void visit(const inst::EuropeanOption&) override {
+        result_ = "EuropeanOption visited";
+    }
+    
+    void visit(const inst::DigitalOption&) override {
+        result_ = "DigitalOption visited";
+    }
+    
+    void visit(const inst::BarrierOption&) override {
+        result_ = "BarrierOption visited";
+    }
+    
+    void visit(const inst::ZeroCouponBond&) override {
+        result_ = "ZeroCouponBond visited";
+    }
+    
+    void visit(const inst::Portfolio& portfolio) override {
+        result_ = "Portfolio visited";
+        // Test that we can access positions
+        std::cout << "Portfolio has " << portfolio.size() << " positions" << std::endl;
+    }
+    
+    std::string getResult() const { return result_; }
+};
+
