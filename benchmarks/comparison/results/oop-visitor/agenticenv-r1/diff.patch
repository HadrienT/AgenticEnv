+// PricingVisitor implementation
+void PricingVisitor::visit(const EuropeanOption& option) {
+    double S = market_.spot;
+    double K = option.strike();
+    double T = option.maturity();
+    double r = market_.rate;
+    double sigma = market_.vol;
+    
+    if (T <= 1e-10) {
+        result_ = option.is_call() ? std::max(0.0, S - K) : std::max(0.0, K - S);
+        return;
+    }
+    
+    double d1 = (std::log(S / K) + (r + 0.5 * sigma * sigma) * T) / (sigma * std::sqrt(T));
+    double d2 = d1 - sigma * std::sqrt(T);
+    
+    if (option.is_call()) {
+        result_ = S * norm_cdf(d1) - K * std::exp(-r * T) * norm_cdf(d2);
+    } else {
+        result_ = K * std::exp(-r * T) * norm_cdf(-d2) - S * norm_cdf(-d1);
+    }
+}
+
+void PricingVisitor::visit(const DigitalOption& option) {
+    double S = market_.spot;
+    double K = option.strike();
+    double T = option.maturity();
+    double r = market_.rate;
+    double sigma = market_.vol;
+    double cash = option.cash();
+    
+    if (T <= 1e-10) {
+        result_ = (S > K) ? cash : 0.0;
+        return;
+    }
+    
+    double d2 = (std::log(S / K) + (r - 0.5 * sigma * sigma) * T) / (sigma * std::sqrt(T));
+    result_ = cash * std::exp(-r * T) * norm_cdf(d2);
+}
+
+void PricingVisitor::visit(const BarrierOption& option) {
+    double S = market_.spot;
+    double K = option.strike();
+    double B = option.barrier();
+    double T = option.maturity();
+    double r = market_.rate;
+    double sigma = market_.vol;
+    
+    // Rubinstein-Reiner formula for down-and-out call
+    if (T <= 1e-10) {
+        result_ = (S > K && S > B) ? (S - K) : 0.0;
+        return;
+    }
+    
+    // Simplified version for down-and-out call
+    double d1 = (std::log(S / K) + (r + 0.5 * sigma * sigma) * T) / (sigma * std::sqrt(T));
+    double d2 = d1 - sigma * std::sqrt(T);
+    double d3 = (std::log(S / B) + (r + 0.5 * sigma * sigma) * T) / (sigma * std::sqrt(T));
+    double d4 = d3 - sigma * std::sqrt(T);
+    
+    double call_price = S * norm_cdf(d1) - K * std::exp(-r * T) * norm_cdf(d2);
+    double knock_out = S * std::pow(B / S, 2 * (r + 0.5 * sigma * sigma) / (sigma * sigma)) * 
+                       (norm_cdf(d3) - norm_cdf(d4));
+    
+    result_ = call_price - knock_out;
+}
+
+void PricingVisitor::visit(const ZeroCouponBond& bond) {
+    double T = bond.maturity();
+    double r = market_.rate;
+    double notional = bond.notional();
+    
+    result_ = notional * std::exp(-r * T);
+}
+
+void PricingVisitor::visit(const Portfolio& portfolio) {
+    double total = 0.0;
+    for (const auto& pos : portfolio.positions()) {
+        // Create a temporary visitor to calculate the value of each position
+        PricingVisitor temp_visitor(market_);
+        pos.item->accept(temp_visitor);
+        total += temp_visitor.result() * pos.quantity;
+    }
+    result_ = total;
+}
