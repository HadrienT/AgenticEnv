+#include <iostream>
+#include <iomanip>
+#include "quantModeling/engines/analytic/heston_cos.hpp"
+#include "quantModeling/models/equity/heston.hpp"
+
+int main() {
+    // Test case from Andersen's paper
+    // v0 = theta = 0.04, kappa = 0.5, xi = 1, rho = -0.9, T = 10, forward = 100, strike = 100
+    quantModeling::HestonParams params{0.04, 0.5, 0.04, 1.0, -0.9};
+    double forward = 100.0;
+    double strike = 100.0;
+    double ttm = 10.0;
+    double discount_factor = 1.0;
+    
+    std::cout << std::fixed << std::setprecision(6);
+    std::cout << "Heston COS Pricing Test Case" << std::endl;
+    std::cout << "Parameters:" << std::endl;
+    std::cout << "  v0 = " << params.v0 << std::endl;
+    std::cout << "  kappa = " << params.kappa << std::endl;
+    std::cout << "  theta = " << params.theta << std::endl;
+    std::cout << "  xi = " << params.xi << std::endl;
+    std::cout << "  rho = " << params.rho << std::endl;
+    std::cout << "  T = " << ttm << std::endl;
+    std::cout << "  Forward = " << forward << std::endl;
+    std::cout << "  Strike = " << strike << std::endl;
+    std::cout << "  Discount factor = " << discount_factor << std::endl;
+    std::cout << std::endl;
+    
+    double price = quantModeling::heston_cos_price(forward, strike, ttm, discount_factor, params, true);
+    std::cout << "COS price (call): " << price << std::endl;
+    std::cout << "Expected (from literature): 13.0847" << std::endl;
+    std::cout << "Difference: " << (price - 13.0847) << std::endl;
+    
+    return 0;
+}
