diff --git a/tests/testGap.cpp b/tests/testGap.cpp
new file mode 100644
index 0000000..c505f67
--- /dev/null
+++ b/tests/testGap.cpp
@@ -0,0 +1,91 @@
+#include <gtest/gtest.h>
+#include "quantModeling/engines/analytic/gap.hpp"
+#include "quantModeling/instruments/equity/gap.hpp"
+#include "quantModeling/pricers/inputs.hpp"
+#include "quantModeling/pricers/registry.hpp"
+#include "quantModeling/pricers/adapters/equity_gap.hpp"
+#include <memory>
+
+namespace quantModeling
+{
+
+    class GapTest : public ::testing::Test
+    {
+    protected:
+        void SetUp() override
+        {
+            // Common setup for all tests
+        }
+    };
+
+    TEST_F(GapTest, GapCallPrice)
+    {
+        GapBSInput input;
+        input.spot = 100.0;
+        input.strike = 95.0;
+        input.trigger = 105.0;
+        input.maturity = 1.0;
+        input.rate = 0.05;
+        input.dividend = 0.02;
+        input.vol = 0.20;
+        input.is_call = true;
+        input.notional = 1.0;
+
+        PricingResult result = price_equity_gap_bs_analytic(input);
+        
+        // Basic sanity check - price should be positive for a call option
+        EXPECT_GT(result.npv, 0.0);
+        EXPECT_GT(result.delta, -1.0);
+        EXPECT_LT(result.delta, 1.0);
+    }
+
+    TEST_F(GapTest, GapPutPrice)
+    {
+        GapBSInput input;
+        input.spot = 100.0;
+        input.strike = 105.0;
+        input.trigger = 95.0;
+        input.maturity = 1.0;
+        input.rate = 0.05;
+        input.dividend = 0.02;
+        input.vol = 0.20;
+        input.is_call = false;
+        input.notional = 1.0;
+
+        PricingResult result = price_equity_gap_bs_analytic(input);
+        
+        // Basic sanity check - price should be positive for a put option
+        EXPECT_GT(result.npv, 0.0);
+        EXPECT_GT(result.delta, -1.0);
+        EXPECT_LT(result.delta, 1.0);
+    }
+
+    TEST_F(GapTest, RegistryIntegration)
+    {
+        GapBSInput input;
+        input.spot = 100.0;
+        input.strike = 100.0;
+        input.trigger = 90.0;
+        input.maturity = 1.0;
+        input.rate = 0.05;
+        input.dividend = 0.02;
+        input.vol = 0.20;
+        input.is_call = true;
+        input.notional = 1.0;
+
+        PricingRequest request;
+        request.instrument = InstrumentKind::EquityGapOption;
+        request.model = ModelKind::BlackScholes;
+        request.engine = EngineKind::Analytic;
+        request.input = input;
+
+        const auto &registry = default_registry();
+        PricingResult result = registry.price(request);
+        
+        // Basic sanity check - price should be positive
+        EXPECT_GT(result.npv, 0.0);
+        EXPECT_GT(result.delta, -1.0);
+        EXPECT_LT(result.delta, 1.0);
+    }
+
+} // namespace quantModeling
