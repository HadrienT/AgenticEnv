index 0000000..c81a89a
--- /dev/null
+++ b/src/pricers/adapters/equity_gap.cpp
@@ -0,0 +1,49 @@
+#include "quantModeling/pricers/adapters/equity_gap.hpp"
+
+#include "quantModeling/engines/analytic/gap.hpp"
+#include "quantModeling/instruments/equity/gap.hpp"
+#include "quantModeling/models/equity/black_scholes.hpp"
+#include "quantModeling/pricers/context.hpp"
+#include "quantModeling/pricers/pricer.hpp"
+
+#include <memory>
+
+namespace quantModeling
+{
+
+    PricingResult price_equity_gap_bs_analytic(const GapBSInput &in)
+    {
+        auto payoff = std::make_shared<GapPayoff>(
+            in.is_call ? OptionType::Call : OptionType::Put,
+            static_cast<Real>(in.strike),
+            static_cast<Real>(in.trigger));
+
+        auto exercise = std::make_shared<EuropeanExercise>(
+            static_cast<Real>(in.maturity));
+
+        GapOption opt(payoff, exercise, static_cast<Real>(in.trigger), static_cast<Real>(in.notional));
+
+        auto model = std::make_shared<BlackScholesModel>(
+            static_cast<Real>(in.spot),
+            static_cast<Real>(in.rate),
+            static_cast<Real>(in.dividend),
+            static_cast<Real>(in.vol));
+
+        MarketView market = {};
+        PricingSettings settings = {
+            in.n_paths,
+            in.seed,
+            true,
+            in.tree_steps,
+            in.pde_space_steps,
+            in.pde_time_steps};
+        settings.mc_device = in.device;
+        settings.mc_rng = in.rng;
+
+        PricingContext ctx{market, settings, model};
+
+        BSGapAnalyticEngine analytic_engine(ctx);
+        return price(opt, analytic_engine);
+    }
+
+} // namespace quantModeling
