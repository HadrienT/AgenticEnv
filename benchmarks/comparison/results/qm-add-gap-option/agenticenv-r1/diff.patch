diff --git a/src/engines/analytic/gap.cpp b/src/engines/analytic/gap.cpp
new file mode 100644
index 0000000..db31408
--- /dev/null
+++ b/src/engines/analytic/gap.cpp
@@ -0,0 +1,137 @@
+#include "quantModeling/engines/analytic/gap.hpp"
+#include "quantModeling/core/math.hpp"
+#include "quantModeling/core/results.hpp"
+#include "quantModeling/pricers/inputs.hpp"
+#include <cmath>
+
+namespace quantModeling
+{
+    namespace
+    {
+        // Black-Scholes formula for gap options
+        // For a gap call: payoff is (S_T - K) if S_T > trigger, 0 otherwise
+        // For a gap put: payoff is (K - S_T) if S_T < trigger, 0 otherwise
+        Real black_scholes_gap_call(Real spot, Real strike, Real trigger, Time maturity,
+                                    Real rate, Real dividend, Real vol)
+        {
+            const Real d1 = (std::log(spot / strike) + (rate - dividend + 0.5 * vol * vol) * maturity) / (vol * std::sqrt(maturity));
+            const Real d2 = d1 - vol * std::sqrt(maturity);
+            
+            // For gap call, we need to compute the probability that S_T > trigger
+            // and the expected value of (S_T - K) given S_T > trigger
+            const Real N_d1 = cumulative_normal(d1);
+            const Real N_d2 = cumulative_normal(d2);
+            
+            // The gap call payoff is (S_T - K) when S_T > trigger, 0 otherwise
+            // This is equivalent to: (S_T - K) * 1_{S_T > trigger}
+            // The expected value is: E[(S_T - K) * 1_{S_T > trigger}] = E[S_T * 1_{S_T > trigger}] - K * P(S_T > trigger)
+            
+            // For a gap call, we compute the expected payoff directly:
+            // E[(S_T - K) * 1_{S_T > trigger}] = S_0 * e^{-q * T} * N(d1') - K * N(d2')
+            // where d1' and d2' are adjusted for the trigger level
+            
+            // Let's compute the correct Black-Scholes gap call formula
+            const Real d1_trigger = (std::log(spot / trigger) + (rate - dividend + 0.5 * vol * vol) * maturity) / (vol * std::sqrt(maturity));
+            const Real d2_trigger = d1_trigger - vol * std::sqrt(maturity);
+            
+            // The gap call price is: S_0 * e^{-q * T} * N(d1') - K * N(d2')
+            // But we need to be more careful about the definition of gap options
+            // A gap call pays (S_T - K) if S_T > trigger, 0 otherwise
+            // This is equivalent to: (S_T - K) * 1_{S_T > trigger}
+            // The expected value is: E[(S_T - K) * 1_{S_T > trigger}] = E[S_T * 1_{S_T > trigger}] - K * P(S_T > trigger)
+            
+            // For a standard call option, we have:
+            // E[S_T * 1_{S_T > K}] = S_0 * e^{-q * T} * N(d1) where d1 = (ln(S_0/K) + (r-q+sigma^2/2)*T) / (sigma*sqrt(T))
+            // P(S_T > K) = N(d2) where d2 = d1 - sigma*sqrt(T)
+            
+            // For gap options, we need to compute:
+            // E[S_T * 1_{S_T > trigger}] = S_0 * e^{-q * T} * N(d1_trigger) where d1_trigger = (ln(S_0/trigger) + (r-q+sigma^2/2)*T) / (sigma*sqrt(T))
+            // P(S_T > trigger) = N(d2_trigger) where d2_trigger = d1_trigger - sigma*sqrt(T)
+            
+            // The gap call payoff is (S_T - K) when S_T > trigger, so:
+            // E[(S_T - K) * 1_{S_T > trigger}] = E[S_T * 1_{S_T > trigger}] - K * P(S_T > trigger)
+            // = S_0 * e^{-q * T} * N(d1_trigger) - K * N(d2_trigger)
+            
+            const Real call_price = spot * std::exp(-dividend * maturity) * cumulative_normal(d1_trigger) - 
+                                    strike * cumulative_normal(d2_trigger);
+            
+            return call_price;
+        }
+
+        Real black_scholes_gap_put(Real spot, Real strike, Real trigger, Time maturity,
+                                   Real rate, Real dividend, Real vol)
+        {
+            const Real d1 = (std::log(spot / strike) + (rate - dividend + 0.5 * vol * vol) * maturity) / (vol * std::sqrt(maturity));
+            const Real d2 = d1 - vol * std::sqrt(maturity);
+            
+            // For a gap put, payoff is (K - S_T) if S_T < trigger, 0 otherwise
+            // This is equivalent to: (K - S_T) * 1_{S_T < trigger}
+            // The expected value is: E[(K - S_T) * 1_{S_T < trigger}] = K * P(S_T < trigger) - E[S_T * 1_{S_T < trigger}]
+            
+            // Let's compute d1' and d2' for the trigger level
+            const Real d1_trigger = (std::log(spot / trigger) + (rate - dividend + 0.5 * vol * vol) * maturity) / (vol * std::sqrt(maturity));
+            const Real d2_trigger = d1_trigger - vol * std::sqrt(maturity);
+            
+            // For gap put: E[(K - S_T) * 1_{S_T < trigger}] = K * N(-d1_trigger) - S_0 * e^{-q * T} * N(-d2_trigger)
+            const Real put_price = strike * cumulative_normal(-d1_trigger) - 
+                                   spot * std::exp(-dividend * maturity) * cumulative_normal(-d2_trigger);
+            
+            return put_price;
+        }
+    }
+
+    PricingResult BSGapAnalyticEngine::price(const GapBSInput &input) const
+    {
+        PricingResult result;
+        
+        if (input.is_call)
+        {
+            result.npv = black_scholes_gap_call(input.spot, input.strike, input.trigger, input.maturity,
+                                                input.rate, input.dividend, input.vol);
+        }
+        else
+        {
+            result.npv = black_scholes_gap_put(input.spot, input.strike, input.trigger, input.maturity,
+                                               input.rate, input.dividend, input.vol);
+        }
+        
+        // For gap options, we can compute the delta as the derivative of the price with respect to spot
+        // This is a simplified approach - in practice, gap options have more complex Greeks
+        const Real eps = 1e-6;
+        const Real spot_up = input.spot * (1.0 + eps);
+        const Real spot_down = input.spot * (1.0 - eps);
+        
+        Real npv_up, npv_down;
+        if (input.is_call)
+        {
+            npv_up = black_scholes_gap_call(spot_up, input.strike, input.trigger, input.maturity,
+                                           input.rate, input.dividend, input.vol);
+            npv_down = black_scholes_gap_call(spot_down, input.strike, input.trigger, input.maturity,
+                                             input.rate, input.dividend, input.vol);
+        }
+        else
+        {
+            npv_up = black_scholes_gap_put(spot_up, input.strike, input.trigger, input.maturity,
+                                          input.rate, input.dividend, input.vol);
+            npv_down = black_scholes_gap_put(spot_down, input.strike, input.trigger, input.maturity,
+                                            input.rate, input.dividend, input.vol);
+        }
+        
+        result.delta = (npv_up - npv_down) / (2.0 * input.spot * eps);
+        
+        // For simplicity, we'll set other Greeks to 0
+        result.gamma = 0.0;
+        result.vega = 0.0;
+        result.theta = 0.0;
+        result.rho = 0.0;
+        
+        return result;
+    }
+
+    PricingResult price_gap_bs_analytic(const GapBSInput &input)
+    {
+        BSGapAnalyticEngine engine;
+        return engine.price(input);
+    }
+
+} // namespace quantModeling
