diff --git a/src/engines/analytic/gap.cpp b/src/engines/analytic/gap.cpp
new file mode 100644
index 0000000..2e4098b
--- /dev/null
+++ b/src/engines/analytic/gap.cpp
@@ -0,0 +1,97 @@
+#include "quantModeling/engines/analytic/gap.hpp"
+#include "quantModeling/instruments/equity/gap.hpp"
+#include "quantModeling/models/equity/black_scholes.hpp"
+#include "quantModeling/utils/stats.hpp"
+#include <cmath>
+
+namespace quantModeling
+{
+    void BSGapAnalyticEngine::visit(const GapOption &opt)
+    {
+        const auto &m = require_model<ILocalVolModel>("BSGapAnalyticEngine");
+        const Real S0 = m.spot0();
+        const Real r = m.rate_r();
+        const Real q = m.yield_q();
+        const Real v = m.vol_sigma();
+
+        const Real T = opt.exercise->dates().front();
+        const Real K = opt.payoff->strike();
+        const Real trigger = opt.trigger;
+        const Real notional = opt.notional;
+
+        // Forward and discount factors
+        const Real df_r = m.discount_curve().discount(T);
+        const Real df_q = std::exp(-q * T);
+        const Real F = S0 * df_q / df_r; // forward under continuous carry
+
+        const Real stddev = v * std::sqrt(T);
+        const Real lnFK = std::log(F / K);
+
+        const Real d1 = (lnFK + 0.5 * stddev * stddev) / stddev;
+        const Real d2 = d1 - stddev;
+
+        PricingResult out;
+        out.diagnostics = "BS analytic gap option (flat r,q,sigma)";
+
+        // For gap options, we compute the expected payoff directly
+        // Gap call: (S_T - K) if S_T > trigger, 0 otherwise
+        // Gap put: (K - S_T) if S_T < trigger, 0 otherwise
+        
+        if (opt.payoff->type() == OptionType::Call)
+        {
+            // Gap call: (S_T - K) if S_T > trigger, 0 otherwise
+            // This is equivalent to: E[(S_T - K) * 1_{S_T > trigger}]
+            // = E[S_T * 1_{S_T > trigger}] - K * P(S_T > trigger)
+            
+            // Probability that S_T > trigger
+            Real d_trigger = (std::log(F / trigger) + 0.5 * v * v * T) / (v * std::sqrt(T));
+            Real prob_above_trigger = norm_cdf(d_trigger);
+            
+            // E[S_T * 1_{S_T > trigger}] = F * N(d1') - trigger * N(d2')
+            // where d1' = (ln(F/trigger) + v^2*T/2) / (v*sqrt(T)) and d2' = d1' - v*sqrt(T)
+            Real d1_trigger = (std::log(F / trigger) + 0.5 * v * v * T) / (v * std::sqrt(T));
+            Real d2_trigger = d1_trigger - v * std::sqrt(T);
+            
+            Real conditional_expectation = F * norm_cdf(d1_trigger) - trigger * norm_cdf(d2_trigger);
+            
+            // The expected payoff is:
+            // E[(S_T - K) * 1_{S_T > trigger}] = E[S_T * 1_{S_T > trigger}] - K * P(S_T > trigger)
+            Real expected_payoff = conditional_expectation - K * prob_above_trigger;
+            
+            out.npv = notional * df_r * expected_payoff;
+            
+            // For delta, we compute the derivative of the NPV with respect to S0
+            // This is the probability that S_T > trigger for a call
+            out.greeks.delta = notional * df_q * prob_above_trigger;
+        }
+        else
+        {
+            // Gap put: (K - S_T) if S_T < trigger, 0 otherwise
+            // This is equivalent to: E[(K - S_T) * 1_{S_T < trigger}]
+            // = K * P(S_T < trigger) - E[S_T * 1_{S_T < trigger}]
+            
+            // Probability that S_T < trigger
+            Real d_trigger = (std::log(F / trigger) - 0.5 * v * v * T) / (v * std::sqrt(T));
+            Real prob_below_trigger = norm_cdf(d_trigger);
+            
+            // E[S_T * 1_{S_T < trigger}] = F * N(-d1') - trigger * N(-d2')
+            // where d1' = (ln(F/trigger) - v^2*T/2) / (v*sqrt(T)) and d2' = d1' - v*sqrt(T)
+            Real d1_trigger = (std::log(F / trigger) - 0.5 * v * v * T) / (v * std::sqrt(T));
+            Real d2_trigger = d1_trigger - v * std::sqrt(T);
+            
+            Real conditional_expectation = F * norm_cdf(-d1_trigger) - trigger * norm_cdf(-d2_trigger);
+            
+            // The expected payoff is:
+            // E[(K - S_T) * 1_{S_T < trigger}] = K * P(S_T < trigger) - E[S_T * 1_{S_T < trigger}]
+            Real expected_payoff = K * prob_below_trigger - conditional_expectation;
+            
+            out.npv = notional * df_r * expected_payoff;
+            
+            // For delta, we compute the derivative of the NPV with respect to S0
+            // This is the negative probability that S_T < trigger for a put
+            out.greeks.delta = notional * df_q * (-prob_below_trigger);
+        }
+
+        res_ = out;
+    }
+} // namespace quantModeling
