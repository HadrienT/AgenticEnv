diff --git a/src/pricers/adapters/equity_gap.cpp b/src/pricers/adapters/equity_gap.cpp
new file mode 100644
index 0000000..df3ea96
--- /dev/null
+++ b/src/pricers/adapters/equity_gap.cpp
@@ -0,0 +1,34 @@
+#include "quantModeling/pricers/adapters/equity_gap.hpp"
+#include "quantModeling/pricers/registry.hpp"
+#include "quantModeling/engines/analytic/gap.hpp"
+#include "quantModeling/instruments/equity/gap.hpp"
+#include "quantModeling/instruments/equity/vanilla.hpp"
+#include "quantModeling/models/equity/black_scholes.hpp"
+#include "quantModeling/utils/stats.hpp"
+#include <cmath>
+
+namespace quantModeling
+{
+    PricingResult price_equity_gap_bs_analytic(const GapBSInput &in)
+    {
+        // Create the payoff
+        auto payoff = std::make_shared<GapPayoff>(in.is_call ? OptionType::Call : OptionType::Put, in.strike, in.trigger);
+        
+        // Create the exercise
+        auto exercise = std::make_shared<EuropeanExercise>(in.maturity);
+        
+        // Create the GapOption instrument
+        GapOption option(payoff, exercise, in.trigger, in.notional);
+        
+        // Create the model
+        BlackScholesModel model(in.spot, in.rate, in.dividend, in.vol);
+        
+        // Create the engine
+        BSGapAnalyticEngine engine(model);
+        
+        // Visit the instrument
+        engine.visit(option);
+        
+        return engine.result();
+    }
+} // namespace quantModeling
