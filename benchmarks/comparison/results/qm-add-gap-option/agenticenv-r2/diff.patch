--- /dev/null
+++ b/include/quantModeling/instruments/equity/gap.hpp
@@ -0,0 +1,53 @@
+#ifndef INSTRUMENT_EQUITY_GAP_HPP
+#define INSTRUMENT_EQUITY_GAP_HPP
+
+#include <memory>
+#include "quantModeling/instruments/base.hpp"
+
+namespace quantModeling
+{
+    struct GapOption final : Instrument
+    {
+        std::shared_ptr<const IPayoff> payoff;
+        std::shared_ptr<const IExercise> exercise;
+        Real trigger;
+        Real notional = 1.0;
+
+        GapOption(std::shared_ptr<const IPayoff> payoff,
+                  std::shared_ptr<const IExercise> exercise,
+                  Real trigger, Real notional = 1.0)
+            : payoff(std::move(payoff)), exercise(std::move(exercise)), trigger(trigger), notional(notional) {}
+
+        void accept(IInstrumentVisitor &v) const override { v.visit(*this); }
+    };
+
+    struct GapPayoff final : IPayoff
+    {
+        OptionType t_;
+        Real K_;
+        Real trigger_;
+
+        GapPayoff(OptionType t, Real K, Real trigger)
+            : t_(t), K_(K), trigger_(trigger) {}
+
+        OptionType type() const override { return t_; }
+        Real strike() const override { return K_; }
+        Real trigger() const { return trigger_; }
+
+        Real operator()(Real spot) const override
+        {
+            if (t_ == OptionType::Call)
+            {
+                // Gap call pays (S_T - strike) if S_T > trigger, and 0 otherwise
+                return (spot > trigger_) ? (spot - K_) : 0.0;
+            }
+            else
+            {
+                // Gap put pays (strike - S_T) if S_T < trigger, and 0 otherwise
+                return (spot < trigger_) ? (K_ - spot) : 0.0;
+            }
+        }
+    };
+} // namespace quantModeling
+
+#endif
