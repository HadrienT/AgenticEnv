diff --git a/tests/testGap.cpp b/tests/testGap.cpp
new file mode 100644
index 0000000..e44ef9c
--- /dev/null
+++ b/tests/testGap.cpp
@@ -0,0 +1,122 @@
+#include <gtest/gtest.h>
+#include "quantModeling/pricers/registry.hpp"
+#include "quantModeling/pricers/adapters/equity_gap.hpp"
+#include "quantModeling/instruments/equity/gap.hpp"
+#include "quantModeling/instruments/equity/vanilla.hpp"
+#include "quantModeling/models/equity/black_scholes.hpp"
+#include "quantModeling/engines/analytic/gap.hpp"
+
+using namespace quantModeling;
+
+TEST(GapOptionTest, GapCall)
+{
+    // Test gap call option
+    GapBSInput input;
+    input.spot = 100.0;
+    input.strike = 100.0;
+    input.trigger = 110.0;
+    input.maturity = 1.0;
+    input.rate = 0.05;
+    input.dividend = 0.02;
+    input.vol = 0.2;
+    input.is_call = true;
+    input.notional = 1000.0;
+
+    auto result = price_equity_gap_bs_analytic(input);
+    
+    // Basic sanity check - should be positive but less than vanilla call
+    EXPECT_GT(result.npv, 0.0);
+    EXPECT_GT(result.greeks.delta, 0.0);
+    EXPECT_TRUE(std::isfinite(result.npv));
+    EXPECT_TRUE(std::isfinite(result.greeks.delta));
+}
+
+TEST(GapOptionTest, GapPut)
+{
+    // Test gap put option
+    GapBSInput input;
+    input.spot = 100.0;
+    input.strike = 100.0;
+    input.trigger = 90.0;
+    input.maturity = 1.0;
+    input.rate = 0.05;
+    input.dividend = 0.02;
+    input.vol = 0.2;
+    input.is_call = false;
+    input.notional = 1000.0;
+
+    auto result = price_equity_gap_bs_analytic(input);
+    
+    // Basic sanity check - should be positive but less than vanilla put
+    EXPECT_GT(result.npv, 0.0);
+    EXPECT_LT(result.greeks.delta, 0.0);
+    EXPECT_TRUE(std::isfinite(result.npv));
+    EXPECT_TRUE(std::isfinite(result.greeks.delta));
+}
+
+TEST(GapOptionTest, GapOptionVsVanilla)
+{
+    // Compare gap option with vanilla option for same parameters
+    GapBSInput gap_input;
+    gap_input.spot = 100.0;
+    gap_input.strike = 100.0;
+    gap_input.trigger = 100.0;  // Trigger at strike
+    gap_input.maturity = 1.0;
+    gap_input.rate = 0.05;
+    gap_input.dividend = 0.02;
+    gap_input.vol = 0.2;
+    gap_input.is_call = true;
+    gap_input.notional = 1000.0;
+
+    auto gap_result = price_equity_gap_bs_analytic(gap_input);
+    
+    // Vanilla option with same parameters
+    VanillaBSInput vanilla_input;
+    vanilla_input.spot = 100.0;
+    vanilla_input.strike = 100.0;
+    vanilla_input.maturity = 1.0;
+    vanilla_input.rate = 0.05;
+    vanilla_input.dividend = 0.02;
+    vanilla_input.vol = 0.2;
+    vanilla_input.is_call = true;
+    
+    auto vanilla_result = price_equity_vanilla_bs(vanilla_input, EngineKind::Analytic);
+    
+    // Gap option should be less than or equal to vanilla option
+    EXPECT_LE(gap_result.npv, vanilla_result.npv);
+    EXPECT_TRUE(std::isfinite(gap_result.npv));
+}
+
+TEST(GapOptionTest, TriggerEffect)
+{
+    // Test that trigger affects the price
+    GapBSInput input1;
+    input1.spot = 100.0;
+    input1.strike = 100.0;
+    input1.trigger = 90.0;
+    input1.maturity = 1.0;
+    input1.rate = 0.05;
+    input1.dividend = 0.02;
+    input1.vol = 0.2;
+    input1.is_call = true;
+    input1.notional = 1000.0;
+
+    GapBSInput input2;
+    input2.spot = 100.0;
+    input2.strike = 100.0;
+    input2.trigger = 110.0;
+    input2.maturity = 1.0;
+    input2.rate = 0.05;
+    input2.dividend = 0.02;
+    input2.vol = 0.2;
+    input2.is_call = true;
+    input2.notional = 1000.0;
+
+    auto result1 = price_equity_gap_bs_analytic(input1);
+    auto result2 = price_equity_gap_bs_analytic(input2);
+    
+    // Higher trigger should generally result in lower price
+    EXPECT_LE(result2.npv, result1.npv);
+    EXPECT_TRUE(std::isfinite(result1.npv));
+    EXPECT_TRUE(std::isfinite(result2.npv));
+}
