diff --git a/src/market.cpp b/src/market.cpp
index caa5200..4f9f4aa 100644
--- a/src/market.cpp
+++ b/src/market.cpp
@@ -1 +1,159 @@
-#include "market.hpp"
+#include "../include/market.hpp"
+#include <stdexcept>
+#include <algorithm>
+#include <iostream>
+#include <functional>
+
+namespace mkt {
+
+// Observer implementation
+void Observer::observe(const std::shared_ptr<Observable>& o) {
+    if (o) {
+        o->add_observer(std::shared_ptr<Observer>(this));
+    }
+}
+
+void Observer::stop_observing(const std::shared_ptr<Observable>& o) {
+    if (o) {
+        o->remove_observer(std::shared_ptr<Observer>(this));
+    }
+}
+
+// Observable implementation
+void Observable::notify() {
+    // Create a copy of observers to avoid issues with observers removing themselves during notification
+    std::unordered_set<std::shared_ptr<Observer>> observers_copy;
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        observers_copy = observers_;
+    }
+    
+    // Notify all observers
+    for (const auto& observer : observers_copy) {
+        if (observer) {
+            observer->update();
+        }
+    }
+}
+
+void Observable::add_observer(const std::shared_ptr<Observer>& o) {
+    if (o) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        observers_.insert(o);
+    }
+}
+
+void Observable::remove_observer(const std::shared_ptr<Observer>& o) {
+    if (o) {
+        std::lock_guard<std::mutex> lock(mutex_);
+        observers_.erase(o);
+    }
+}
+
+// Quote implementation
+Quote::Quote(double v) : value_(v) {}
+
+double Quote::value() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return value_;
+}
+
+void Quote::set(double v) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (value_ != v) {
+        value_ = v;
+        notify();
+    }
+}
+
+// LazyObject implementation
+double LazyObject::value() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (dirty_.load()) {
+        cached_value_.store(compute());
+        computations_.fetch_add(1);
+        dirty_.store(false);
+    }
+    return cached_value_.load();
+}
+
+long LazyObject::computations() const {
+    return computations_.load();
+}
+
+void LazyObject::update() {
+    dirty_.store(true);
+}
+
+void LazyObject::add_dependency(const std::shared_ptr<Observable>& o) {
+    if (o) {
+        std::lock_guard<std::mutex> lock(dependencies_mutex_);
+        dependencies_.insert(o);
+        o->add_observer(std::shared_ptr<Observer>(this));
+    }
+}
+
+void LazyObject::remove_dependency(const std::shared_ptr<Observable>& o) {
+    if (o) {
+        std::lock_guard<std::mutex> lock(dependencies_mutex_);
+        dependencies_.erase(o);
+        o->remove_observer(std::shared_ptr<Observer>(this));
+    }
+}
+
+// EngineFactory implementation
+EngineFactory& EngineFactory::instance() {
+    static EngineFactory instance;
+    return instance;
+}
+
+void EngineFactory::add(const std::string& key, std::function<std::unique_ptr<Engine>()> maker) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    makers_[key] = maker;
+}
+
+std::unique_ptr<Engine> EngineFactory::create(const std::string& key) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto it = makers_.find(key);
+    if (it == makers_.end()) {
+        throw std::invalid_argument("Unknown engine key: " + key);
+    }
+    return it->second();
+}
+
+std::vector<std::string> EngineFactory::keys() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::vector<std::string> result;
+    result.reserve(makers_.size());
+    for (const auto& pair : makers_) {
+        result.push_back(pair.first);
+    }
+    std::sort(result.begin(), result.end());
+    return result;
+}
+
+// MemoEngine implementation
+MemoEngine::MemoEngine(std::unique_ptr<Engine> inner) : inner_(std::move(inner)), cache_() {}
+
+double MemoEngine::price(double spot, double strike, double vol) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto key = std::make_tuple(spot, strike, vol);
+    auto it = cache_.find(key);
+    if (it != cache_.end()) {
+        return it->second;
+    }
+    double result = inner_->price(spot, strike, vol);
+    cache_[key] = result;
+    return result;
+}
+
+std::string MemoEngine::name() const {
+    return "memo(" + inner_->name() + ")";
+}
+
+void MemoEngine::clear() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    cache_.clear();
+}
+
+}  // namespace mkt
