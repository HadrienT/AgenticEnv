@@ -0,0 +1,43 @@
+#include "include/market.hpp"
+#include <iostream>
+#include <vector>
+
+// Test Observer/Observable pattern
+class TestObserver : public mkt::Observer {
+private:
+    int id;
+public:
+    TestObserver(int i) : id(i) {}
+    void update() override {
+        std::cout << "Observer " << id << " notified!" << std::endl;
+    }
+};
+
+class TestObservable : public mkt::Observable {
+public:
+    void triggerNotification() {
+        notify();
+    }
+};
+
+int main() {
+    // Test Observer/Observable
+    auto observable = std::make_shared<TestObservable>();
+    auto observer1 = std::make_shared<TestObserver>(1);
+    auto observer2 = std::make_shared<TestObserver>(2);
+    
+    // Add observers
+    observer1->observe(observable);
+    observer2->observe(observable);
+    
+    // Trigger notification
+    observable->triggerNotification();
+    
+    // Remove one observer
+    observer1->stop_observing(observable);
+    
+    // Trigger notification again
+    observable->triggerNotification();
+    
+    return 0;
+}
