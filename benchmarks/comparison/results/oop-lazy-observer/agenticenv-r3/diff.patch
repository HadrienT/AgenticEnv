diff --git a/src/market.cpp b/src/market.cpp
index caa5200..0067329 100644
--- a/src/market.cpp
+++ b/src/market.cpp
@@ -1 +1,146 @@
 #include "market.hpp"
+#include <stdexcept>
+#include <algorithm>
+#include <iostream>
+
+namespace mkt {
+
+// Observer implementation
+void Observer::observe(const std::shared_ptr<Observable>& o) {
+    if (o) {
+        auto self = std::shared_ptr<Observer>(this);
+        o->observers_.push_back(self);
+    }
+}
+
+void Observer::stop_observing(const std::shared_ptr<Observable>& o) {
+    if (o) {
+        // Remove this observer from the observable's set
+        auto& observers = o->observers_;
+        for (auto it = observers.begin(); it != observers.end(); ++it) {
+            if (auto obs = it->lock()) {
+                // Compare raw pointers to check if it's the same observer
+                if (obs.get() == this) {
+                    observers.erase(it);
+                    break;
+                }
+            }
+        }
+    }
+}
+
+// Observable implementation
+void Observable::notify() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    // Create a copy of observers to avoid issues with modification during iteration
+    std::vector<std::weak_ptr<Observer>> observers_copy = observers_;
+    
+    for (auto it = observers_copy.begin(); it != observers_copy.end();) {
+        if (auto obs = it->lock()) {
+            obs->update();
+            ++it;
+        } else {
+            // Remove expired weak_ptr
+            it = observers_copy.erase(it);
+        }
+    }
+    
+    // Update the actual observers set with the cleaned copy
+    std::lock_guard<std::mutex> lock2(mutex_);
+    observers_ = std::move(observers_copy);
+}
+
+// Quote implementation
+Quote::Quote(double v) : value_(v) {}
+
+double Quote::value() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return value_;
+}
+
+void Quote::set(double v) {
+    {
+        std::lock_guard<std::mutex> lock(mutex_);
+        if (value_ == v) return;
+        value_ = v;
+    }
+    notify();
+}
+
+// LazyObject implementation
+double LazyObject::value() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (dirty_.load()) {
+        cached_value_.store(compute());
+        computations_.fetch_add(1);
+        dirty_.store(false);
+    }
+    return cached_value_.load();
+}
+
+long LazyObject::computations() const {
+    return computations_.load();
+}
+
+void LazyObject::update() {
+    dirty_.store(true);
+}
+
+// EngineFactory implementation
+EngineFactory& EngineFactory::instance() {
+    static EngineFactory factory;
+    return factory;
+}
+
+void EngineFactory::add(const std::string& key, std::function<std::unique_ptr<Engine>()> maker) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    makers_[key] = std::move(maker);
+}
+
+std::unique_ptr<Engine> EngineFactory::create(const std::string& key) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto it = makers_.find(key);
+    if (it == makers_.end()) {
+        throw std::invalid_argument("Unknown engine key: " + key);
+    }
+    return it->second();
+}
+
+std::vector<std::string> EngineFactory::keys() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::vector<std::string> result;
+    result.reserve(makers_.size());
+    for (const auto& pair : makers_) {
+        result.push_back(pair.first);
+    }
+    std::sort(result.begin(), result.end());
+    return result;
+}
+
+// MemoEngine implementation
+MemoEngine::MemoEngine(std::unique_ptr<Engine> inner) : inner_(std::move(inner)) {}
+
+double MemoEngine::price(double spot, double strike, double vol) const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto key = std::make_tuple(spot, strike, vol);
+    // Linear search through cache (simple approach)
+    for (const auto& entry : cache_) {
+        if (entry.first == key) {
+            return entry.second;
+        }
+    }
+    double result = inner_->price(spot, strike, vol);
+    cache_.push_back({key, result});
+    return result;
+}
+
+std::string MemoEngine::name() const {
+    return "memo(" + inner_->name() + ")";
+}
+
+void MemoEngine::clear() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    cache_.clear();
+}
+
+}  // namespace mkt
