 #include "market.hpp"
+#include <stdexcept>
+#include <algorithm>
+#include <iostream>
+
+namespace mkt {
+
+// Observer implementation
+void Observer::observe(const std::shared_ptr<Observable>& o) {
+    if (o) {
+        // Create a shared_ptr to this observer using enable_shared_from_this
+        auto self = shared_from_this();
+        o->observers_.insert(self);
+    }
+}
+
+void Observer::stop_observing(const std::shared_ptr<Observable>& o) {
+    if (o) {
+        // Remove this observer from the observable's set
+        auto self = shared_from_this();
+        auto& observers = o->observers_;
+        for (auto it = observers.begin(); it != observers.end(); ++it) {
+            if (auto obs = it->lock()) {
+                if (obs.get() == self.get()) {
+                    observers.erase(it);
+                    break;
+                }
+            }
+        }
+    }
+}
+
+// Observable implementation
+void Observable::notify() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    // Create a copy of observers to avoid issues with modification during iteration
+    std::set<std::weak_ptr<Observer>, WeakPtrCompare> observers_copy = observers_;
+    for (auto it = observers_copy.begin(); it != observers_copy.end();) {
+        if (auto obs = it->lock()) {
+            obs->update();
+            ++it;
+        } else {
+            // Remove expired weak_ptr
+            it = observers_copy.erase(it);
+        }
+    }
+    // Update the actual observers set with the cleaned copy
+    observers_ = observers_copy;
+}
+
+// Quote implementation
+Quote::Quote(double v) : value_(v) {}
+
+double Quote::value() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return value_;
+}
+
+void Quote::set(double v) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (value_ != v) {
+        value_ = v;
+        notify();
+    }
+}
+
+// LazyObject implementation - stub for now
+double LazyObject::value() {
+    return 0.0;
+}
+
+// Factory implementation
+template<typename T>
+std::unordered_map<std::string, std::function<std::unique_ptr<T>()>> Factory<T>::factories_;
+
+template<typename T>
+void Factory<T>::register_type(const std::string& name, std::function<std::unique_ptr<T>()> factory) {
+    factories_[name] = factory;
+}
+
+template<typename T>
+std::unique_ptr<T> Factory<T>::create(const std::string& name) {
+    auto it = factories_.find(name);
+    if (it == factories_.end()) {
+        throw std::invalid_argument("Unknown factory type: " + name);
+    }
+    return it->second();
+}
+
+template<typename T>
+std::vector<std::string> Factory<T>::list() {
+    std::vector<std::string> result;
+    result.reserve(factories_.size());
+    for (const auto& pair : factories_) {
+        result.push_back(pair.first);
+    }
+    std::sort(result.begin(), result.end());
+    return result;
+}
+
+// MemoEngine implementation
+MemoEngine::MemoEngine(std::unique_ptr<Engine> inner) : inner_(std::move(inner)) {}
+
+double MemoEngine::price(double spot, double strike, double vol) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto key = std::make_tuple(spot, strike, vol);
+    auto it = cache_.find(key);
+    if (it != cache_.end()) {
+        return it->second;
+    }
+    double result = inner_->price(spot, strike, vol);
+    cache_[key] = result;
+    return result;
+}
+
+}  // namespace mkt
