+// Custom hash for tuple to avoid compilation issues
+namespace std {
+template<>
+struct hash<std::tuple<double, double, double>> {
+    std::size_t operator()(const std::tuple<double, double, double>& t) const {
+        // Simple hash combining the three values
+        std::size_t h1 = std::hash<double>{}(std::get<0>(t));
+        std::size_t h2 = std::hash<double>{}(std::get<1>(t));
+        std::size_t h3 = std::hash<double>{}(std::get<2>(t));
+        return h1 ^ (h2 << 1) ^ (h3 << 2);
+    }
+};
+}
