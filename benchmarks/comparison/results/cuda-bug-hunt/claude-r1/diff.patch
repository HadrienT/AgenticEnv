+// Runs every batch on the current device. The caller's McResult::paths is 0 on failure.
+static McResult simulate(double S, double K, double r, double sigma, double T, int n, unsigned long long nPaths,
+                         unsigned int seed) {
+    const double nan = std::numeric_limits<double>::quiet_NaN();
+    const McResult failed = {nan, nan, 0};
+
+    const size_t slots = size_t(kBlocks) * kThreads;
+    Tally* d = nullptr;
+    cudaError_t e = cudaSuccess;
+    for (int attempt = 0; attempt < kMaxAttempts; attempt++) {
+        e = cudaMalloc(&d, slots * sizeof(Tally));
+        if (e == cudaSuccess || !busy(e)) break;
+        waitForDevice(attempt);
     }
+    if (e != cudaSuccess) {
+        report("cudaMalloc", e);
+        return failed;
+    }
+
+    const double dt = T / n;
+    const double drift = (r - 0.5 * sigma * sigma) * dt, vol = sigma * sqrt(dt);
+    const unsigned long long stepsPerPath = (unsigned long long)n;
+    const unsigned long long maxBatch = kStepsPerLaunch > stepsPerPath ? kStepsPerLaunch / stepsPerPath : 1;
+
+    std::vector<Tally> h(slots);
+    double sum = 0, sq = 0;
+    unsigned long long count = 0;
+    for (unsigned long long done = 0; done < nPaths;) {
+        const unsigned long long left = nPaths - done;
+        const unsigned long long batch = left < maxBatch ? left : maxBatch;
+
+        // A batch is a pure function of (seed, path range), so a retry repeats it exactly.
+        for (int attempt = 0; attempt < kMaxAttempts; attempt++) {
+            cudaGetLastError();
+            asian_kernel<<<kBlocks, kThreads>>>(S, K, drift, vol, n, done, batch, seed, d);
+            e = cudaGetLastError();
+            if (e == cudaSuccess) e = cudaMemcpy(h.data(), d, slots * sizeof(Tally), cudaMemcpyDeviceToHost);
+            if (e == cudaSuccess || !busy(e)) break;
+            waitForDevice(attempt);
+        }
+        if (e != cudaSuccess) {
+            report("batch", e);
+            cudaFree(d);
+            return failed;
+        }
+
+        // Fixed order: the rounding of the total is the same in every run.
+        double batchSum = 0, batchSq = 0;
+        for (size_t i = 0; i < slots; i++) {
+            batchSum += h[i].sum;
+            batchSq += h[i].sq;
+            count += h[i].count;
+        }
+        sum += batchSum;
+        sq += batchSq;
+        done += batch;
+    }
+    cudaFree(d);
+
+    const double N = double(count);
+    const double m = sum / N;
+    const double df = exp(-r * T);
+    // Undefined for one path. Rounding can push a true zero variance slightly below zero.
+    double se = nan;
+    if (count > 1) {
+        const double v = (sq / N - m * m) * (N / (N - 1));
+        se = v > 0 ? df * sqrt(v / N) : 0;
+    }
+    return {df * m, se, count};
 }
 
