+// Simple test to verify the logic of the fixed CUDA code
+#include <iostream>
+#include <iomanip>
+#include <cmath>
+
+// Test the key mathematical components
+int main() {
+    std::cout << std::fixed << std::setprecision(6);
+    
+    // Test time step calculation
+    double T_total = 1.0;
+    int n = 12;
+    double dt_correct = T_total / n;  // Should be 1/12 = 0.083333
+    double dt_wrong = T_total / (n - 1);  // Was wrong: 1/11 = 0.090909
+    
+    std::cout << "Time step calculations:\n";
+    std::cout << "Correct dt = T/n = " << dt_correct << "\n";
+    std::cout << "Wrong dt = T/(n-1) = " << dt_wrong << "\n\n";
+    
+    // Test Asian option pricing components
+    double S = 100.0, K = 100.0, r = 0.05, sigma = 0.2, T = 1.0;
+    int n_paths = 1000000;
+    
+    // Test drift calculation
+    double drift = (r - 0.5 * sigma * sigma) * dt_correct;
+    std::cout << "Drift calculation:\n";
+    std::cout << "r = " << r << ", sigma = " << sigma << "\n";
+    std::cout << "Drift = (r - 0.5*sigma^2) * dt = (" << r << " - 0.5*" << sigma << "^2) * " << dt_correct << " = " << drift << "\n\n";
+    
+    // Test standard error calculation logic
+    double sum = 100000.0;  // Example sum of payoffs
+    double sq_sum = 1500000.0;  // Example sum of squares
+    double count = n_paths;
+    
+    double mean = sum / count;
+    double variance = sq_sum / count - mean * mean;
+    double std_error = sqrt(variance / count);
+    
+    std::cout << "Standard error calculation:\n";
+    std::cout << "sum = " << sum << ", sq_sum = " << sq_sum << ", count = " << count << "\n";
+    std::cout << "mean = " << mean << "\n";
+    std::cout << "variance = " << sq_sum << "/" << count << " - " << mean << "^2 = " << variance << "\n";
+    std::cout << "std_error = sqrt(" << variance << "/" << count << ") = " << std_error << "\n";
+    
+    return 0;
+}
