+// Simple verification that the fix addresses the main issues
+#include <iostream>
+#include <cmath>
+
+// Test the time step calculation
+int main() {
+    double T = 1.0;
+    int n = 12;
+    
+    // Old (incorrect) way
+    double old_dt = T / (n - 1);
+    std::cout << "Old dt = T/(n-1) = " << T << "/(" << n << "-1) = " << old_dt << std::endl;
+    
+    // New (correct) way
+    double new_dt = T / n;
+    std::cout << "New dt = T/n = " << T << "/" << n << " = " << new_dt << std::endl;
+    
+    // Verify they're different
+    std::cout << "Are they different? " << (std::abs(old_dt - new_dt) > 1e-10 ? "YES" : "NO") << std::endl;
+    
+    return 0;
+}
