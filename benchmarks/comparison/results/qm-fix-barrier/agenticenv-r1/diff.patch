+#include <iostream>
+#include <iomanip>
+#include <cmath>
+#include "quantModeling/pricers/registry.hpp"
+
+using namespace quantModeling;
+
+int main() {
+    // Reproduce the exact case mentioned in the issue:
+    // Down-and-out call with spot 100, strike 100, barrier 90, rate 5%, dividend 2%, vol 20%, 1 year
+    
+    BarrierBSInput in{};
+    in.spot = 100.0;
+    in.strike = 100.0;
+    in.maturity = 1.0;
+    in.rate = 0.05;
+    in.dividend = 0.02;
+    in.vol = 0.20;
+    in.is_call = true;
+    in.barrier_type = BarrierType::DownAndOut;
+    in.barrier_level = 90.0;
+    in.rebate = 0.0;
+    in.n_paths = 1000000;  // High number of paths to see convergence
+    in.seed = 42;
+    in.brownian_bridge = true;
+    
+    PricingRequest request{
+        InstrumentKind::EquityBarrierOption,
+        ModelKind::BlackScholes,
+        EngineKind::MonteCarlo,
+        PricingInput{in}};
+    
+    auto result = default_registry().price(request);
+    
+    std::cout << "Monte Carlo price with Brownian bridge: " << std::fixed << std::setprecision(6) << result.npv << std::endl;
+    std::cout << "Diagnostic: " << result.diagnostics << std::endl;
+    
+    // Also test without Brownian bridge for comparison
+    in.brownian_bridge = false;
+    auto result_discrete = default_registry().price(request);
+    std::cout << "Monte Carlo price without Brownian bridge: " << std::fixed << std::setprecision(6) << result_discrete.npv << std::endl;
+    
+    // Let's also test with a known analytical solution for comparison
+    // For a down-and-out call, we can compare with the Rubinstein-Reiner formula
+    // But first, let's understand what the issue is by looking at the math
+    
+    return 0;
+}
