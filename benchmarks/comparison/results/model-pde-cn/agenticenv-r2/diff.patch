--- a/src/pde.cpp
+++ b/src/pde.cpp
@@ -1,5 +1,150 @@
 #include "pde.hpp"
+#include <vector>
+#include <algorithm>
+#include <cmath>
 #include <stdexcept>
+
 namespace model {
-PdeResult pde_price(Kind, double, double, double, double, double, double, int, int) { throw std::logic_error("not implemented"); }
+
+// Helper function to compute payoff
+double payoff(Kind kind, double S, double K) {
+    switch (kind) {
+        case Kind::EuropeanCall:
+            return std::max(S - K, 0.0);
+        case Kind::EuropeanPut:
+            return std::max(K - S, 0.0);
+        case Kind::AmericanPut:
+            return std::max(K - S, 0.0);
+        case Kind::DigitalCall:
+            return (S > K) ? 1.0 : 0.0;
+        default:
+            return 0.0;
+    }
 }
+
+// Function to solve the Black-Scholes PDE using Crank-Nicolson method with proper American option handling
+PdeResult pde_price(Kind kind, double S, double K, double r, double q, double sigma, double T, int nS, int nT) {
+    // Validate inputs
+    if (nS <= 0 || nT <= 0 || T <= 0 || sigma <= 0) {
+        throw std::invalid_argument("Invalid parameters");
+    }
+    
+    // Set up the log-space grid
+    double log_K = std::log(K);
+    double log_S = std::log(S);
+    
+    // Define the log-space grid range (covering 6 standard deviations)
+    double log_S_min = log_K - 3.0;
+    double log_S_max = log_K + 3.0;
+    double dlog_S = (log_S_max - log_S_min) / (nS - 1);
+    
+    // Time step
+    double dt = T / nT;
+    
+    // Define the coefficients for Crank-Nicolson scheme
+    double alpha = 0.5 * sigma * sigma;
+    double beta = r - q;
+    
+    // Create coefficient vectors for tridiagonal matrix
+    std::vector<double> a(nS, 0.0);
+    std::vector<double> b(nS, 0.0);
+    std::vector<double> c(nS, 0.0);
+    
+    // Fill in the coefficients for the tridiagonal matrix
+    for (int i = 1; i < nS - 1; ++i) {
+        // For a proper Crank-Nicolson scheme in log-space, we need to be more careful
+        double dlog_S_i = dlog_S;
+        double dlog_S_i_plus_1 = dlog_S;
+        
+        // Crank-Nicolson coefficients for Black-Scholes PDE in log-space
+        // The standard form is: u_t = alpha * u_xx + beta * u_x + gamma * u
+        // where alpha = 0.5 * sigma^2, beta = r - q, gamma = -r
+        a[i] = -0.25 * alpha * dt / (dlog_S_i * dlog_S_i_plus_1) - 0.25 * beta * dt / dlog_S_i;
+        b[i] = 1.0 + 0.5 * alpha * dt / (dlog_S_i * dlog_S_i_plus_1) + r * dt;
+        c[i] = -0.25 * alpha * dt / (dlog_S_i * dlog_S_i_plus_1) + 0.25 * beta * dt / dlog_S_i;
+    }
+    
+    // Boundary conditions - for Black-Scholes PDE in log-space
+    // Left boundary (log_S_min) - for European options, this is a fixed boundary
+    a[0] = 0.0;
+    b[0] = 1.0;
+    c[0] = 0.0;
+    
+    // Right boundary (log_S_max) - for European options, this is a fixed boundary
+    a[nS-1] = 0.0;
+    b[nS-1] = 1.0;
+    c[nS-1] = 0.0;
+    
+    // Initialize the solution vector
+    std::vector<double> u(nS);
+    std::vector<double> u_new(nS);
+    
+    // Set up initial conditions (payoff at maturity)
+    for (int i = 0; i < nS; ++i) {
+        double log_S_i = log_S_min + i * dlog_S;
+        double S_i = std::exp(log_S_i);
+        u[i] = payoff(kind, S_i, K);
+    }
+    
+    // Time stepping using Crank-Nicolson
+    for (int t = nT - 1; t >= 0; --t) {
+        // Apply Crank-Nicolson scheme
+        for (int i = 1; i < nS - 1; ++i) {
+            u_new[i] = a[i] * u[i-1] + b[i] * u[i] + c[i] * u[i+1];
+        }
+        
+        // Apply boundary conditions
+        u_new[0] = u[0];
+        u_new[nS-1] = u[nS-1];
+        
+        // For American options, check early exercise using a proper method
+        if (kind == Kind::AmericanPut) {
+            // For American put, we need to ensure proper early exercise handling
+            // We'll use a simple but effective approach: check early exercise at each step
+            for (int i = 0; i < nS; ++i) {
+                double log_S_i = log_S_min + i * dlog_S;
+                double S_i = std::exp(log_S_i);
+                double early_exercise_value = K - S_i;
+                u_new[i] = std::max(u_new[i], early_exercise_value);
+            }
+        }
+        
+        u = u_new;
+    }
+    
+    // Interpolate to get the value at the requested spot
+    double log_S_target = std::log(S);
+    int i_left = static_cast<int>((log_S_target - log_S_min) / dlog_S);
+    i_left = std::max(0, std::min(i_left, nS - 2));
+    int i_right = i_left + 1;
+    
+    double weight = (log_S_target - (log_S_min + i_left * dlog_S)) / dlog_S;
+    
+    double value = (1.0 - weight) * u[i_left] + weight * u[i_right];
+    
+    // Calculate delta and gamma using finite differences
+    double eps = 1e-6;
+    double log_S_plus = std::log(S * (1.0 + eps));
+    double log_S_minus = std::log(S * (1.0 - eps));
+    
+    int i_plus = static_cast<int>((log_S_plus - log_S_min) / dlog_S);
+    int i_minus = static_cast<int>((log_S_minus - log_S_min) / dlog_S);
+    
+    i_plus = std::max(0, std::min(i_plus, nS - 2));
+    i_minus = std::max(0, std::min(i_minus, nS - 2));
+    
+    double weight_plus = (log_S_plus - (log_S_min + i_plus * dlog_S)) / dlog_S;
+    double weight_minus = (log_S_minus - (log_S_min + i_minus * dlog_S)) / dlog_S;
+    
+    double value_plus = (1.0 - weight_plus) * u[i_plus] + weight_plus * u[i_plus + 1];
+    double value_minus = (1.0 - weight_minus) * u[i_minus] + weight_minus * u[i_minus + 1];
+    
+    double delta = (value_plus - value_minus) / (2.0 * S * eps);
+    
+    // Calculate gamma
+    double gamma = (value_plus - 2.0 * value + value_minus) / (S * S * eps * eps);
+    
+    return {value, delta, gamma};
+}
+
+}  // namespace model
