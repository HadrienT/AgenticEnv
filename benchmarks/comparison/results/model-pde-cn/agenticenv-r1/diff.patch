+// Helper function to compute payoff
+double payoff(Kind kind, double S, double K) {
+    switch (kind) {
+        case Kind::EuropeanCall:
+            return std::max(S - K, 0.0);
+        case Kind::EuropeanPut:
+            return std::max(K - S, 0.0);
+        case Kind::AmericanPut:
+            return std::max(K - S, 0.0);
+        case Kind::DigitalCall:
+            return (S > K) ? 1.0 : 0.0;
+        default:
+            return 0.0;
+    }
 }
+
+// Thomas algorithm for solving tridiagonal systems
+void solve_tridiagonal(const std::vector<double>& a, const std::vector<double>& b, 
+                       const std::vector<double>& c, const std::vector<double>& d,
+                       std::vector<double>& x) {
+    int n = static_cast<int>(b.size());
+    std::vector<double> p(n, 0.0);
+    std::vector<double> q(n, 0.0);
+    
+    // Forward elimination
+    p[0] = c[0] / b[0];
+    q[0] = d[0] / b[0];
+    
+    for (int i = 1; i < n; ++i) {
+        double denom = b[i] - a[i] * p[i-1];
+        p[i] = c[i] / denom;
+        q[i] = (d[i] - a[i] * q[i-1]) / denom;
+    }
+    
+    // Backward substitution
+    x[n-1] = q[n-1];
+    for (int i = n - 2; i >= 0; --i) {
+        x[i] = q[i] - p[i] * x[i+1];
+    }
+}
