+private:
+    friend class Var;
+    friend class Recorder;
+    // An operation with its local partials, captured when it is recorded so
+    // the sweep never recomputes them. Unused parents are slot 0 with weight 0.
+    struct Node {
+        std::size_t parent[2] = {0, 0};
+        double weight[2] = {0.0, 0.0};
+        double adjoint = 0.0;
+    };
+    std::size_t record(std::size_t p0, double w0, std::size_t p1, double w1);
+    void check(std::size_t slot) const;
+    // Slot 0 is a hidden sink, not a recorded node: it absorbs the writes of
+    // unused parents so the sweep need not branch on a node's arity. Node i of
+    // the public numbering (a Mark, size()) lives in slot i + 1.
+    std::vector<Node> nodes_ = std::vector<Node>(1);
 };
+// A Var refers to a node of the tape of the thread that created it, so it must
+// be used on that thread only. A Var whose node was dropped by rewind or clear
+// keeps its value(), but any other use of it is an error: it throws
+// std::out_of_range as long as its slot is unoccupied. Once newer nodes reuse
+// the slot this can no longer be detected, so keep nothing recorded after a
+// mark across a rewind to it.
 class Var {
 public:
     Var(double value = 0.0);           // records a new input node
