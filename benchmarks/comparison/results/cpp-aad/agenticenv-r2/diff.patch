+int main() {
+    using namespace aad;
+    
+    // Simple test
+    Var x(2.0);
+    Var y(3.0);
+    Var z = x + y;
+    Var w = x * y;
+    
+    std::cout << "x = " << x.value() << std::endl;
+    std::cout << "y = " << y.value() << std::endl;
+    std::cout << "z = x + y = " << z.value() << std::endl;
+    std::cout << "w = x * y = " << w.value() << std::endl;
+    
+    // Test backward pass
+    Tape::active().propagate(w);
+    std::cout << "adjoint of x = " << x.adjoint() << std::endl;
+    std::cout << "adjoint of y = " << y.adjoint() << std::endl;
+    
+    return 0;
+}
