+
+// Thread-local tape storage
+thread_local Tape* active_tape = nullptr;
+
+// Implementation of Tape methods
+Tape& Tape::active() {
+    if (active_tape == nullptr) {
+        active_tape = new Tape();
+    }
+    return *active_tape;
 }
+
+std::size_t Tape::size() const {
+    return nodes.size();
+}
+
+void Tape::reserve(std::size_t nodes) {
+    reserved_size = nodes;
+    if (nodes > 0) {
+        this->nodes.reserve(nodes);
+    }
+}
+
+Tape::Mark Tape::mark() const {
+    return Mark{current_pos};
+}
+
+void Tape::rewind(Mark m) {
+    // Clear nodes after the mark
+    while (nodes.size() > m.pos) {
+        Node* node = nodes.back();
+        nodes.pop_back();
+        delete node;
+    }
+    current_pos = m.pos;
+}
+
+void Tape::clear() {
+    // Delete all nodes
+    for (Node* node : nodes) {
+        delete node;
+    }
+    nodes.clear();
+    input_indices.clear();
+    current_pos = 0;
+}
+
+void Tape::reset_adjoints() {
+    for (Node* node : nodes) {
+        node->adjoint = 0.0;
+    }
+}
+
+void Tape::recordInput(Node* node) {
+    input_indices.push_back(nodes.size());
+    nodes.push_back(node);
+    current_pos = nodes.size();
+}
+
+void Tape::propagate(const Var& output) {
+    // Reset all adjoints to 0
+    reset_adjoints();
+    
+    // Seed the output node with 1.0
+    output.node->adjoint = 1.0;
+    
+    // Backward pass: traverse nodes in reverse order
+    for (std::size_t i = nodes.size(); i > 0; --i) {
+        Node* node = nodes[i - 1];
+        
+        // Propagate adjoint to dependencies
+        for (const auto& dep : node->dependencies) {
+            Node* dep_node = dep.first;
+            double grad_contribution = dep.second * node->adjoint;
+            dep_node->adjoint += grad_contribution;
+        }
+    }
+}
+
+// Implementation of Var methods
+Var::Var(double value) {
+    Tape& tape = Tape::active();
+    Node* node = new Node(value);
+    tape.recordInput(node);
+    this->node = node;
+}
+
+double Var::value() const {
+    return node->value;
+}
+
+double Var::adjoint() const {
+    return node->adjoint;
+}
+
+Var& Var::operator+=(const Var& other) {
+    Tape& tape = Tape::active();
+    node = tape.recordOp(2, node, other.node, [](double a, double b) { return a + b; }, 
+                         [](double a, double b, double grad) { return grad; }, 
+                         [](double a, double b, double grad) { return grad; });
+    return *this;
+}
+
+Var& Var::operator-=(const Var& other) {
+    Tape& tape = Tape::active();
+    node = tape.recordOp(2, node, other.node, [](double a, double b) { return a - b; }, 
+                         [](double a, double b, double grad) { return grad; }, 
+                         [](double a, double b, double grad) { return -grad; });
+    return *this;
+}
+
+Var& Var::operator*=(const Var& other) {
+    Tape& tape = Tape::active();
+    node = tape.recordOp(2, node, other.node, [](double a, double b) { return a * b; }, 
+                         [](double a, double b, double grad) { return grad * b; }, 
+                         [](double a, double b, double grad) { return grad * a; });
+    return *this;
+}
+
+Var& Var::operator/=(const Var& other) {
+    Tape& tape = Tape::active();
+    node = tape.recordOp(2, node, other.node, [](double a, double b) { return a / b; }, 
+                         [](double a, double b, double grad) { return grad / b; }, 
+                         [](double a, double b, double grad) { return -grad * a / (b * b); });
+    return *this;
+}
+
+}  // namespace aad
