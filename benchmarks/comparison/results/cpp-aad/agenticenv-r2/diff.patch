+
 Var exp(const Var&);
 Var log(const Var&);
 Var sqrt(const Var&);
 Var pow(const Var&, double);
 Var normal_cdf(const Var&);        // standard normal CDF
 Var max(const Var&, const Var&);   // derivative of the larger argument; of the first at a tie
-}  // namespace aad
+
+// Template implementations
+template<typename Op, typename Grad1, typename Grad2>
+Node* Tape::recordOp(std::size_t n_args, Node* arg1, Node* arg2, Op op, Grad1 grad1, Grad2 grad2) {
+    // Create new node for the result
+    double result_value = op(arg1->value, arg2->value);
+    Node* result_node = new Node(result_value);
+    
+    // Add dependencies
+    result_node->dependencies.push_back({arg1, grad1(arg1->value, arg2->value, 1.0)});
+    result_node->dependencies.push_back({arg2, grad2(arg1->value, arg2->value, 1.0)});
+    
+    // Add to nodes list
+    nodes.push_back(result_node);
+    current_pos = nodes.size();
+    
+    return result_node;
+}
+
+template<typename Op, typename Grad>
+Node* Tape::recordOp(std::size_t n_args, Node* arg, Op op, Grad grad) {
+    // Create new node for the result
+    double result_value = op(arg->value);
+    Node* result_node = new Node(result_value);
+    
+    // Add dependency
+    result_node->dependencies.push_back({arg, grad(arg->value, 1.0)});
+    
+    // Add to nodes list
+    nodes.push_back(result_node);
+    current_pos = nodes.size();
+    
+    return result_node;
+}
+
+}  // namespace aad
