+    Var z = x + y;
+    Var w = x * y;
+    Var v = z + w;
+    
+    // Test propagation
+    Tape::active().propagate(v);
+    
+    std::cout << "x.value() = " << x.value() << std::endl;
+    std::cout << "x.adjoint() = " << x.adjoint() << std::endl;
+    std::cout << "y.value() = " << y.value() << std::endl;
+    std::cout << "y.adjoint() = " << y.adjoint() << std::endl;
+    
+    // Test that derivatives are computed correctly
+    // For v = (x+y) + (x*y) = x + y + x*y
+    // dv/dx = 1 + y = 1 + 3 = 4
+    // dv/dy = 1 + x = 1 + 2 = 3
+    assert(std::abs(x.adjoint() - 4.0) < 1e-10);
+    assert(std::abs(y.adjoint() - 3.0) < 1e-10);
+    
+    // Test more complex expression
+    Var a(1.0);
+    Var b(2.0);
+    Var c = a * a + b * b;
+    
+    Tape::active().propagate(c);
+    
+    std::cout << "a.value() = " << a.value() << std::endl;
+    std::cout << "a.adjoint() = " << a.adjoint() << std::endl;
+    std::cout << "b.value() = " << b.value() << std::endl;
+    std::cout << "b.adjoint() = " << b.adjoint() << std::endl;
+    
+    // For c = a^2 + b^2
+    // dc/da = 2*a = 2*1 = 2
+    // dc/db = 2*b = 2*2 = 4
+    assert(std::abs(a.adjoint() - 2.0) < 1e-10);
+    assert(std::abs(b.adjoint() - 4.0) < 1e-10);
+    
+    std::cout << "All tests passed!" << std::endl;
+    return 0;
+}
