+
+void Tape::propagate(const Var& output) {
+    // Reset adjoints
+    reset_adjoints();
+    
+    // Seed the output adjoint with 1.0
+    if (output.id_ < adjoints_.size()) {
+        adjoints_[output.id_] = 1.0;
+    }
+    
+    // Backward pass - process nodes in reverse order
+    for (auto it = nodes_.rbegin(); it != nodes_.rend(); ++it) {
+        const Node& node = *it;
+        double adjoint = adjoints_[node.result_id];
+        
+        switch (node.op) {
+            case Node::OpType::ADD:
+                if (node.arg1_id < adjoints_.size()) adjoints_[node.arg1_id] += adjoint;
+                if (node.arg2_id < adjoints_.size()) adjoints_[node.arg2_id] += adjoint;
+                break;
+            case Node::OpType::SUB:
+                if (node.arg1_id < adjoints_.size()) adjoints_[node.arg1_id] += adjoint;
+                if (node.arg2_id < adjoints_.size()) adjoints_[node.arg2_id] -= adjoint;
+                break;
+            case Node::OpType::MUL:
+                if (node.arg1_id < adjoints_.size()) adjoints_[node.arg1_id] += adjoint * node.arg2_val;
+                if (node.arg2_id < adjoints_.size()) adjoints_[node.arg2_id] += adjoint * node.arg1_val;
+                break;
+            case Node::OpType::DIV:
+                if (node.arg1_id < adjoints_.size()) adjoints_[node.arg1_id] += adjoint / node.arg2_val;
+                if (node.arg2_id < adjoints_.size()) adjoints_[node.arg2_id] -= adjoint * node.arg1_val / (node.arg2_val * node.arg2_val);
+                break;
+            case Node::OpType::NEG:
+                if (node.arg1_id < adjoints_.size()) adjoints_[node.arg1_id] -= adjoint;
+                break;
+            case Node::OpType::EXP:
+                if (node.arg1_id < adjoints_.size()) adjoints_[node.arg1_id] += adjoint * std::exp(node.arg1_val);
+                break;
+            case Node::OpType::LOG:
+                if (node.arg1_id < adjoints_.size()) adjoints_[node.arg1_id] += adjoint / node.arg1_val;
+                break;
+            case Node::OpType::SQRT:
+                if (node.arg1_id < adjoints_.size()) adjoints_[node.arg1_id] += adjoint / (2.0 * std::sqrt(node.arg1_val));
+                break;
+            case Node::OpType::POW:
+                if (node.arg1_id < adjoints_.size()) {
+                    double base = node.arg1_val;
+                    double exp = node.arg2_val;
+                    adjoints_[node.arg1_id] += adjoint * exp * std::pow(base, exp - 1.0);
+                }
+                break;
+            case Node::OpType::NORMAL_CDF:
+                if (node.arg1_id < adjoints_.size()) {
+                    double x = node.arg1_val;
+                    double pdf = 1.0 / std::sqrt(2.0 * M_PI) * std::exp(-0.5 * x * x);
+                    adjoints_[node.arg1_id] += adjoint * pdf;
+                }
+                break;
+            case Node::OpType::MAX:
