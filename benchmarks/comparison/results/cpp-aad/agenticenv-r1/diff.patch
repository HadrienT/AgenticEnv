+    Var x(2.0);
+    Var y(3.0);
+    
+    // Record some operations
+    Var z = x + y;
+    Var w = x * y;
+    
+    // Mark the current position
+    auto mark = Tape::active().mark();
+    
+    // Record more operations
+    Var v = z + w;
+    Var u = v * 2.0;
+    
+    // Check tape size
+    std::size_t initial_size = Tape::active().size();
+    std::cout << "Initial tape size: " << initial_size << "\n";
+    
+    // Rewind to the mark
+    Tape::active().rewind(mark);
+    
+    // Check that tape size is reduced
+    std::size_t after_rewind_size = Tape::active().size();
+    std::cout << "Tape size after rewind: " << after_rewind_size << "\n";
+    
+    // Verify that we can still compute derivatives correctly
+    // Only the operations before the mark should be in the tape
+    Tape::active().propagate(v);
+    
+    // The tape should now only contain the operations before the mark
+    // So we should be able to compute derivatives correctly
+    std::cout << "x.value() = " << x.value() << ", x.adjoint() = " << x.adjoint() << "\n";
