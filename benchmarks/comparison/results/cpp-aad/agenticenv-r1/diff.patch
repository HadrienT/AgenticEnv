+#include "include/aad.hpp"
+#include <iostream>
+#include <cassert>
+#include <cmath>
+
+int main() {
+    using namespace aad;
+    
+    std::cout << "Running comprehensive tests for AAD implementation...\n";
+    
+    // Test 1: Basic arithmetic operations
+    {
+        Var x(2.0);
+        Var y(3.0);
+        Var z = x + y;
+        Var w = x * y;
+        Var v = z + w;
+        
+        Tape::active().propagate(v);
+        
+        // For v = (x+y) + (x*y) = x + y + x*y
+        // dv/dx = 1 + y = 1 + 3 = 4
+        // dv/dy = 1 + x = 1 + 2 = 3
+        assert(std::abs(x.adjoint() - 4.0) < 1e-10);
+        assert(std::abs(y.adjoint() - 3.0) < 1e-10);
+        std::cout << "✓ Basic arithmetic operations test passed\n";
+    }
+    
+    // Test 2: Complex expression with functions
+    {
+        Var a(1.0);
+        Var b(2.0);
+        Var c = a * a + b * b;
+        Var d = exp(a) + log(b);
+        Var e = sqrt(c) + d;
+        
+        Tape::active().propagate(e);
+        
+        // For e = sqrt(a^2 + b^2) + exp(a) + log(b)
+        // de/da = a/sqrt(a^2 + b^2) + exp(a) = 1/sqrt(5) + e^1 = 1/sqrt(5) + e
+        // de/db = b/sqrt(a^2 + b^2) + 1/b = 2/sqrt(5) + 1/2
+        assert(std::abs(a.adjoint() - (1.0/std::sqrt(5.0) + std::exp(1.0))) < 1e-10);
+        assert(std::abs(b.adjoint() - (2.0/std::sqrt(5.0) + 0.5)) < 1e-10);
+        std::cout << "✓ Complex expression with functions test passed\n";
+    }
+    
+    // Test 3: Unary operations
+    {
+        Var x(5.0);
+        Var y = -x;
+        Var z = exp(y);
+        
+        Tape::active().propagate(z);
+        
+        // For z = exp(-x)
+        // dz/dx = -exp(-x) = -exp(-5)
+        assert(std::abs(x.adjoint() - (-std::exp(-5.0))) < 1e-10);
+        std::cout << "✓ Unary operations test passed\n";
+    }
+    
+    // Test 4: Division and power operations
+    {
+        Var x(4.0);
+        Var y(2.0);
+        Var z = x / y;
+        Var w = pow(x, 2.0);
+        Var v = z + w;
+        
+        Tape::active().propagate(v);
+        
+        // For v = x/y + x^2
+        // dv/dx = 1/y + 2*x = 1/2 + 2*4 = 0.5 + 8 = 8.5
+        // dv/dy = -x/y^2 = -4/4 = -1
+        assert(std::abs(x.adjoint() - 8.5) < 1e-10);
+        assert(std::abs(y.adjoint() - (-1.0)) < 1e-10);
+        std::cout << "✓ Division and power operations test passed\n";
+    }
+    
+    // Test 5: Max function
+    {
+        Var x(3.0);
+        Var y(5.0);
+        Var z = max(x, y);
+        
+        Tape::active().propagate(z);
+        
+        // For z = max(x, y) where y > x, so dz/dy = 1, dz/dx = 0
+        assert(std::abs(x.adjoint() - 0.0) < 1e-10);
+        assert(std::abs(y.adjoint() - 1.0) < 1e-10);
+        std::cout << "✓ Max function test passed\n";
+    }
+    
+    // Test 6: Implicit conversion from double
+    {
+        Var x(2.0);
+        Var y = x * 2.0;  // implicit conversion from double to Var
+        Var z = 1.0 + x;  // implicit conversion from double to Var
+        
+        Tape::active().propagate(z);
+        
+        // For z = 1 + x
+        // dz/dx = 1
+        assert(std::abs(x.adjoint() - 1.0) < 1e-10);
+        std::cout << "✓ Implicit conversion test passed\n";
+    }
+    
+    std::cout << "All comprehensive tests passed!\n";
+    return 0;
+}
