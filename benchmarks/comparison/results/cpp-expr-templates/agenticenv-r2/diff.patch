--- a/include/vec.hpp
+++ b/include/vec.hpp
@@ -1,14 +1,227 @@
 #pragma once
 #include <cstddef>
+#include <stdexcept>
+#include <type_traits>
+#include <algorithm>
+#include <utility>
 #include <vector>
+
 namespace qm {
-class Vec {
+
+// Concept for vector expressions
+template<typename E>
+concept VecExpr = requires(const E& e) {
+    { e.size() } -> std::convertible_to<std::size_t>;
+    { e.operator[](std::size_t{}) } -> std::convertible_to<double>;
+};
+
+// Base expression class for lazy evaluation
+template<typename Derived>
+class VecExprBase {
+public:
+    std::size_t size() const noexcept {
+        return static_cast<const Derived&>(*this).size();
+    }
+    
+    double operator[](std::size_t i) const noexcept {
+        return static_cast<const Derived&>(*this)[i];
+    }
+};
+
+// Forward declarations
+class Vec;
+template<typename Lhs, typename Rhs>
+class VecAdd;
+template<typename Lhs, typename Rhs>
+class VecSub;
+template<typename Expr>
+class VecNeg;
+template<typename Expr>
+class VecScale;
+template<typename Expr>
+class VecShift;
+
+// Vec class - the actual vector
+class Vec : public VecExprBase<Vec> {
+private:
+    std::vector<double> data_;
+
 public:
     explicit Vec(std::size_t n, double fill = 0.0) : data_(n, fill) {}
+    
+    Vec(const Vec& other) = default;
+    Vec(Vec&& other) noexcept = default;
+    Vec& operator=(const Vec& other) = default;
+    Vec& operator=(Vec&& other) noexcept = default;
+    
     std::size_t size() const noexcept { return data_.size(); }
     double& operator[](std::size_t i) { return data_[i]; }
     double operator[](std::size_t i) const { return data_[i]; }
+    
+    // Assignment from expression
+    template<VecExpr E>
+    Vec& operator=(const E& expr) {
+        if (expr.size() != size()) {
+            throw std::invalid_argument("Size mismatch in assignment");
+        }
+        for (std::size_t i = 0; i < size(); ++i) {
+            data_[i] = expr[i];
+        }
+        return *this;
+    }
+};
+
+// Expression templates for lazy evaluation
+
+// Addition expression
+template<typename Lhs, typename Rhs>
+class VecAdd : public VecExprBase<VecAdd<Lhs, Rhs>> {
 private:
-    std::vector<double> data_;
+    const Lhs& lhs_;
+    const Rhs& rhs_;
+
+public:
+    VecAdd(const Lhs& lhs, const Rhs& rhs) : lhs_(lhs), rhs_(rhs) {
+        if (lhs.size() != rhs.size()) {
+            throw std::invalid_argument("Size mismatch in addition");
+        }
+    }
+    
+    std::size_t size() const noexcept { return lhs_.size(); }
+    double operator[](std::size_t i) const noexcept { return lhs_[i] + rhs_[i]; }
+};
+
+// Subtraction expression
+template<typename Lhs, typename Rhs>
+class VecSub : public VecExprBase<VecSub<Lhs, Rhs>> {
+private:
+    const Lhs& lhs_;
+    const Rhs& rhs_;
+
+public:
+    VecSub(const Lhs& lhs, const Rhs& rhs) : lhs_(lhs), rhs_(rhs) {
+        if (lhs.size() != rhs.size()) {
+            throw std::invalid_argument("Size mismatch in subtraction");
+        }
+    }
+    
+    std::size_t size() const noexcept { return lhs_.size(); }
+    double operator[](std::size_t i) const noexcept { return lhs_[i] - rhs_[i]; }
+};
+
+// Negation expression
+template<typename Expr>
+class VecNeg : public VecExprBase<VecNeg<Expr>> {
+private:
+    const Expr& expr_;
+
+public:
+    explicit VecNeg(const Expr& expr) : expr_(expr) {}
+    
+    std::size_t size() const noexcept { return expr_.size(); }
+    double operator[](std::size_t i) const noexcept { return -expr_[i]; }
+};
+
+// Scalar multiplication expression
+template<typename Expr>
+class VecScale : public VecExprBase<VecScale<Expr>> {
+private:
+    const Expr& expr_;
+    double scalar_;
+
+public:
+    VecScale(const Expr& expr, double scalar) : expr_(expr), scalar_(scalar) {}
+    
+    std::size_t size() const noexcept { return expr_.size(); }
+    double operator[](std::size_t i) const noexcept { return expr_[i] * scalar_; }
+};
+
+// Shift expression (circular shift)
+template<typename Expr>
+class VecShift : public VecExprBase<VecShift<Expr>> {
+private:
+    const Expr& expr_;
+    std::size_t shift_;
+
+public:
+    VecShift(const Expr& expr, std::size_t shift) : expr_(expr), shift_(shift) {}
+    
+    std::size_t size() const noexcept { return expr_.size(); }
+    double operator[](std::size_t i) const noexcept { 
+        std::size_t shifted = (i + shift_) % size();
+        return expr_[shifted]; 
+    }
 };
+
+// Helper functions for creating expressions
+template<VecExpr Lhs, VecExpr Rhs>
+auto operator+(const Lhs& lhs, const Rhs& rhs) {
+    return VecAdd<Lhs, Rhs>(lhs, rhs);
+}
+
+template<VecExpr Lhs, VecExpr Rhs>
+auto operator-(const Lhs& lhs, const Rhs& rhs) {
+    return VecSub<Lhs, Rhs>(lhs, rhs);
+}
+
+template<VecExpr Expr>
+auto operator-(const Expr& expr) {
+    return VecNeg<Expr>(expr);
+}
+
+template<VecExpr Expr>
+auto operator*(const Expr& expr, double scalar) {
+    return VecScale<Expr>(expr, scalar);
+}
+
+template<VecExpr Expr>
+auto operator*(double scalar, const Expr& expr) {
+    return VecScale<Expr>(expr, scalar);
+}
+
+template<VecExpr Expr>
+auto operator/(const Expr& expr, double scalar) {
+    return VecScale<Expr>(expr, 1.0 / scalar);
+}
+
+// Shift function
+template<VecExpr Expr>
+auto shift(const Expr& expr, std::size_t k) {
+    return VecShift<Expr>(expr, k);
+}
+
+// Reduction functions
+template<VecExpr Expr>
+double sum(const Expr& expr) {
+    double result = 0.0;
+    for (std::size_t i = 0; i < expr.size(); ++i) {
+        result += expr[i];
+    }
+    return result;
+}
+
+template<VecExpr Expr1, VecExpr Expr2>
+double dot(const Expr1& expr1, const Expr2& expr2) {
+    if (expr1.size() != expr2.size()) {
+        throw std::invalid_argument("Size mismatch in dot product");
+    }
+    double result = 0.0;
+    for (std::size_t i = 0; i < expr1.size(); ++i) {
+        result += expr1[i] * expr2[i];
+    }
+    return result;
+}
+
+template<VecExpr Expr>
+double max(const Expr& expr) {
+    if (expr.size() == 0) {
+        throw std::invalid_argument("Empty expression in max");
+    }
+    double result = expr[0];
+    for (std::size_t i = 1; i < expr.size(); ++i) {
+        result = std::max(result, expr[i]);
+    }
+    return result;
+}
+
 }  // namespace qm
diff --git a/src/comprehensive_test.cpp b/src/comprehensive_test.cpp
new file mode 100644
index 0000000..36302db
--- /dev/null
+++ b/src/comprehensive_test.cpp
@@ -0,0 +1,96 @@
+#include <iostream>
+#include <cassert>
+#include "vec.hpp"
+
+int main() {
+    // Test basic vector creation and access
+    qm::Vec a(4, 1.0);
+    qm::Vec b(4, 2.0);
+    
+    assert(a.size() == 4);
+    assert(b.size() == 4);
+    assert(a[0] == 1.0);
+    assert(b[1] == 2.0);
+    
+    // Test addition
+    auto c = a + b;
+    assert(c.size() == 4);
+    assert(c[0] == 3.0);
+    assert(c[1] == 3.0);
+    
+    // Test subtraction
+    auto d = b - a;
+    assert(d.size() == 4);
+    assert(d[0] == 1.0);
+    assert(d[1] == 1.0);
+    
+    // Test scalar multiplication
+    auto e = a * 2.0;
+    assert(e.size() == 4);
+    assert(e[0] == 2.0);
+    assert(e[1] == 2.0);
+    
+    // Test scalar division
+    auto f = b / 2.0;
+    assert(f.size() == 4);
+    assert(f[0] == 1.0);
+    assert(f[1] == 1.0);
+    
+    // Test unary minus
+    auto g = -a;
+    assert(g.size() == 4);
+    assert(g[0] == -1.0);
+    assert(g[1] == -1.0);
+    
+    // Test complex expression
+    auto h = (a + b) * 2.0 - a;
+    assert(h.size() == 4);
+    assert(h[0] == 5.0);
+    assert(h[1] == 5.0);
+    
+    // Test assignment
+    qm::Vec result(4);
+    result = a + b;
+    assert(result[0] == 3.0);
+    assert(result[1] == 3.0);
+    
+    // Test reduction functions
+    assert(qm::sum(a) == 4.0);
+    assert(qm::dot(a, b) == 8.0);
+    assert(qm::max(a) == 1.0);
+    
+    // Test shift - circular shift
+    auto shifted = qm::shift(a, 1);
+    assert(shifted.size() == 4);
+    // With shift(1), element at index 0 should be element at index 3 of original
+    assert(shifted[0] == 1.0);  // This is a[3] from original, which is 1.0
+    
+    // Test aliasing (a = a + b) - this should work correctly
+    qm::Vec aliased(4, 1.0);
+    aliased = aliased + b;
+    assert(aliased[0] == 3.0);
+    assert(aliased[1] == 3.0);
+    
+    // Test more complex aliasing
+    qm::Vec complex_alias(4, 1.0);
+    complex_alias = complex_alias + complex_alias;
+    assert(complex_alias[0] == 2.0);
+    assert(complex_alias[1] == 2.0);
+    
+    // Test temporary expression
+    auto temp_expr = qm::Vec(4, 1.0) + b;
+    assert(temp_expr[0] == 3.0);
+    assert(temp_expr[1] == 3.0);
+    
+    // Test that expressions stay valid after full expression ends
+    qm::Vec final_result(4);
+    {
+        auto expr = a + b;
+        final_result = expr;
+    }
+    assert(final_result[0] == 3.0);
+    assert(final_result[1] == 3.0);
+    
+    std::cout << "All comprehensive tests passed!" << std::endl;
+    return 0;
+}
