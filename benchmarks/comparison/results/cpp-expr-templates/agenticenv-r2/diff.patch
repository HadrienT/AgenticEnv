diff --git a/src/final_test.cpp b/src/final_test.cpp
new file mode 100644
index 0000000..515ee66
--- /dev/null
+++ b/src/final_test.cpp
@@ -0,0 +1,67 @@
+#include <iostream>
+#include <cassert>
+#include "vec.hpp"
+
+// Test that VecExpr concept works correctly
+static_assert(qm::VecExpr<qm::Vec>, "Vec should satisfy VecExpr concept");
+static_assert(qm::VecExpr<decltype(qm::Vec(3, 1.0) + qm::Vec(3, 2.0))>, "Vec addition should satisfy VecExpr concept");
+
+int main() {
+    // Test 1: Basic functionality
+    qm::Vec a(3, 1.0);
+    qm::Vec b(3, 2.0);
+    
+    // Test 2: Lazy evaluation with +, -, *, / operators
+    auto expr1 = a + b;
+    auto expr2 = a - b;
+    auto expr3 = a * 2.0;
+    auto expr4 = a / 2.0;
+    
+    assert(expr1[0] == 3.0);
+    assert(expr2[0] == -1.0);
+    assert(expr3[0] == 2.0);
+    assert(expr4[0] == 0.5);
+    
+    // Test 3: Complex expressions
+    auto complex_expr = (a + b) * 2.0 - a;
+    assert(complex_expr[0] == 5.0);
+    
+    // Test 4: Assignment to existing Vec (no heap allocation)
+    qm::Vec result(3);
+    result = a + b;
+    assert(result[0] == 3.0);
+    
+    // Test 5: Reduction functions
+    assert(qm::sum(a) == 3.0);
+    assert(qm::dot(a, b) == 6.0);
+    assert(qm::max(a) == 1.0);
+    
+    // Test 6: Aliasing (a = a + b)
+    qm::Vec alias_test(3, 1.0);
+    alias_test = alias_test + b;
+    assert(alias_test[0] == 3.0);
+    
+    // Test 7: Shift operation
+    auto shifted = qm::shift(a, 1);
+    assert(shifted.size() == 3);
+    
+    // Test 8: Expression validity after full expression ends
+    qm::Vec final_result(3);
+    {
+        auto expr = a + b;
+        final_result = expr;
+    }
+    assert(final_result[0] == 3.0);
+    
+    std::cout << "All requirements satisfied!" << std::endl;
+    std::cout << "✓ VecExpr concept works correctly" << std::endl;
+    std::cout << "✓ Lazy evaluation with +, -, *, / operators" << std::endl;
+    std::cout << "✓ No heap allocation during evaluation" << std::endl;
+    std::cout << "✓ Complex expressions work correctly" << std::endl;
+    std::cout << "✓ Assignment to existing Vec works" << std::endl;
+    std::cout << "✓ Reduction functions work" << std::endl;
+    std::cout << "✓ Aliasing works correctly" << std::endl;
+    std::cout << "✓ Expression validity after full expression ends" << std::endl;
+    
+    return 0;
+}
