@@ -0,0 +1,380 @@
+// Self-contained test for qm::Vec; prints each failed check and exits non-zero.
+#include "vec.hpp"
+
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <limits>
+#include <new>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+// --- allocation counter -----------------------------------------------------
+static std::atomic<long> g_allocations{0};
+
+void* operator new(std::size_t n) {
+    ++g_allocations;
+    if (void* p = std::malloc(n ? n : 1)) return p;
+    throw std::bad_alloc{};
+}
+void* operator new[](std::size_t n) { return operator new(n); }
+void operator delete(void* p) noexcept { std::free(p); }
+void operator delete(void* p, std::size_t) noexcept { std::free(p); }
+void operator delete[](void* p) noexcept { std::free(p); }
+void operator delete[](void* p, std::size_t) noexcept { std::free(p); }
+
+template <class F>
+static long allocations_in(F&& f) {
+    const long before = g_allocations.load();
+    f();
+    return g_allocations.load() - before;
+}
+
+// --- minimal harness --------------------------------------------------------
+static int g_failures = 0;
+#define CHECK(cond)                                                     \
+    do {                                                                \
+        if (!(cond)) {                                                  \
+            std::printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); \
+            ++g_failures;                                               \
+        }                                                               \
+    } while (0)
+#define CHECK_MISMATCH(...)                  \
+    do {                                     \
+        bool thrown = false;                 \
+        try {                                \
+            __VA_ARGS__;                     \
+        } catch (const std::invalid_argument&) { \
+            thrown = true;                   \
+        }                                    \
+        CHECK(thrown && #__VA_ARGS__);       \
+    } while (0)
+
+using qm::Vec;
+using qm::VecExpr;
+
+static Vec make(std::vector<double> values) {
+    Vec v(values.size());
+    for (std::size_t i = 0; i < values.size(); ++i) v[i] = values[i];
+    return v;
+}
+
+template <class E>
+static bool equals(const E& e, std::vector<double> expected) {
+    if (e.size() != expected.size()) return false;
+    for (std::size_t i = 0; i < expected.size(); ++i)
+        if (e[i] != expected[i]) return false;
+    return true;
+}
+
+// --- compile-time contract --------------------------------------------------
+template <class A, class B>
+concept Addable = requires(A a, B b) { a + b; };
+template <class A, class B>
+concept Subtractable = requires(A a, B b) { a - b; };
+template <class A, class B>
+concept Multipliable = requires(A a, B b) { a * b; };
+template <class A, class B>
+concept Divisible = requires(A a, B b) { a / b; };
+
+static_assert(VecExpr<Vec> && VecExpr<Vec&> && VecExpr<const Vec&> && VecExpr<Vec&&>);
+static_assert(!VecExpr<double> && !VecExpr<int> && !VecExpr<std::string>);
+static_assert(!VecExpr<std::vector<double>> && !VecExpr<void>);
+static_assert(VecExpr<decltype(std::declval<Vec&>() + std::declval<Vec&>())>);
+static_assert(VecExpr<decltype(std::declval<Vec&>() * 2.0)>);
+static_assert(VecExpr<decltype(-std::declval<Vec&>())>);
+static_assert(VecExpr<decltype(qm::shift(std::declval<Vec&>(), 1))>);
+
+static_assert(Addable<Vec&, Vec&> && Subtractable<Vec&, Vec>);
+static_assert(!Addable<Vec&, int> && !Addable<int, Vec&> && !Addable<Vec&, double>);
+static_assert(!Addable<Vec&, std::string> && !Addable<std::string, Vec&>);
+static_assert(!Addable<Vec&, std::vector<double>> && !Subtractable<Vec&, int>);
+static_assert(Multipliable<Vec&, double> && Multipliable<double, Vec&> && Divisible<Vec&, double>);
+static_assert(!Multipliable<Vec&, Vec&> && !Divisible<Vec&, Vec&> && !Divisible<double, Vec&>);
+static_assert(!Multipliable<Vec&, std::string> && !Divisible<Vec&, std::string>);
+
+// Expressions are cheap values that convert to Vec implicitly.
+static_assert(std::is_convertible_v<decltype(std::declval<Vec&>() + std::declval<Vec&>()), Vec>);
+static_assert(std::is_nothrow_move_constructible_v<Vec>);
+static_assert(!std::is_convertible_v<std::size_t, Vec>);
+
+// --- functions returning expressions built from their own locals ------------
+static auto from_temporaries(const Vec& b) { return (Vec(b.size(), 1.0) + b) * 2.0; }
+static auto from_local_expr(const Vec& b) {
+    auto local = Vec(b.size(), 1.0) + b;
+    return local * 2.0;
+}
+static auto from_local_exprs(const Vec& b) {
+    auto x = b + b;
+    auto y = -x;
+    auto z = y - x;
+    return qm::shift(z, 1) + x;
+}
+static auto from_moved_local(const Vec& b) {
+    Vec local(b.size(), 5.0);
+    return std::move(local) + b;
+}
+static auto from_shifted_temporary(const Vec& b) { return qm::shift(Vec(b.size(), 3.0) - b, 1); }
+static const Vec const_value() { return make({1, 2, 3}); }
+
+static void test_arithmetic() {
+    const Vec b = make({1, 2, 3}), c = make({10, 20, 30}), d = make({5, 5, 5});
+    CHECK(equals(b + c, {11, 22, 33}));
+    CHECK(equals(c - b, {9, 18, 27}));
+    CHECK(equals(-b, {-1, -2, -3}));
+    CHECK(equals(b * 2.0, {2, 4, 6}));
+    CHECK(equals(2.0 * b, {2, 4, 6}));
+    CHECK(equals(b / 2.0, {0.5, 1, 1.5}));
+    CHECK(equals(b + c * 2.0 - d, {16, 37, 58}));
+    CHECK(equals(-(b + c) / 2.0 * 2.0, {-11, -22, -33}));
+    Vec one = make({1});
+    CHECK(equals(one / 3.0, {1.0 / 3.0}));  // a real division, not * (1 / 3)
+    CHECK((b + c).size() == 3 && (-b).size() == 3 && qm::shift(b, 1).size() == 3);
+}
+
+static void test_laziness() {
+    Vec b = make({1, 2}), c = make({3, 4});
+    auto e = b + c;
+    b[0] = 100;
+    CHECK(equals(e, {103, 6}));
+}
+
+static void test_allocations() {
+    constexpr std::size_t n = 1000;
+    Vec a(n), b(n, 1.0), c(n, 2.0), d(n, 3.0);
+
+    CHECK(allocations_in([&] { a = b + c * 2.0 - d; }) == 0);
+    CHECK(a[n - 1] == 2.0);
+    CHECK(allocations_in([&] { a = a + b; }) == 0);
+    CHECK(allocations_in([&] { a = b - a; }) == 0);
+    CHECK(allocations_in([&] { a = -a * 2.0 / 4.0 + a; }) == 0);
+    CHECK(allocations_in([&] { a = b; }) == 0);
+    CHECK(allocations_in([&] { a = qm::shift(b, 1) + c; }) == 0);  // shifts another Vec
+    CHECK(allocations_in([&] { a = qm::shift(a, 0); }) == 0);      // a shift of 0 moves nothing
+    CHECK(allocations_in([&] { (void)qm::sum(b + c); }) == 0);
+    CHECK(allocations_in([&] { (void)qm::dot(b + c, d); }) == 0);
+    CHECK(allocations_in([&] { (void)qm::max(-b); }) == 0);
+
+    long constructed = allocations_in([&] { Vec x = b + c * 2.0 - d; CHECK(x[0] == 2.0); });
+    CHECK(constructed == 1);
+    CHECK(allocations_in([&] { Vec x(b); CHECK(x[0] == 1.0); }) == 1);
+    CHECK(allocations_in([&] { Vec x(n, 1.0); CHECK(x[0] == 1.0); }) == 1);
+    CHECK(allocations_in([&] { Vec x(qm::shift(b, 3)); CHECK(x[0] == 1.0); }) == 1);
+
+    // Temporary operands add no allocation of their own beyond their own Vec.
+    Vec spare(n, 4.0);
+    CHECK(allocations_in([&] { a = std::move(spare) + b; }) == 0);
+    CHECK(a[0] == 5.0);
+
+    // Copying and reusing an expression that owns a buffer does not allocate.
+    auto owning = Vec(n, 1.0) + b;
+    CHECK(allocations_in([&] {
+              a = owning + c;
+              auto copy = owning;
+              a = copy * 2.0;
+          }) == 0);
+    CHECK(a[0] == 4.0);
+}
+
+static void test_lifetime() {
+    const Vec b = make({1, 2, 3});
+    const Vec c = make({4, 5, 6});
+    {
+        auto e = (b + c) * 2.0;
+        CHECK(equals(e, {10, 14, 18}));
+    }
+    {
+        auto e = Vec(3, 1.0) + b;
+        CHECK(equals(e, {2, 3, 4}));
+    }
+    {
+        auto e = b + Vec(3, 1.0);
+        CHECK(equals(e, {2, 3, 4}));
+    }
+    {
+        auto e = (Vec(3, 1.0) + Vec(3, 2.0)) * 2.0 - (-Vec(3, 1.0));
+        CHECK(equals(e, {7, 7, 7}));
+    }
+    {
+        auto e = from_temporaries(b);
+        CHECK(equals(e, {4, 6, 8}));
+    }
+    {
+        auto e = from_local_expr(b);
+        CHECK(equals(e, {4, 6, 8}));
+    }
+    {
+        auto e = from_local_exprs(b);
+        // x = {2,4,6}, z = -2x = {-4,-8,-12}, shifted = {-8,-12,-4}
+        CHECK(equals(e, {-6, -8, 2}));
+    }
+    {
+        auto e = from_moved_local(b);
+        CHECK(equals(e, {6, 7, 8}));
+    }
+    {
+        auto e = from_shifted_temporary(b);
+        CHECK(equals(e, {1, 0, 2}));
+    }
+    {
+        auto e = const_value() + b;  // a const temporary cannot be moved from
+        CHECK(equals(e, {2, 4, 6}));
+    }
+    {
+        auto outer = [&] {
+            auto inner = Vec(3, 1.0) * 2.0;
+            auto copy = inner;  // the two copies share one buffer
+            return copy + inner;
+        }();
+        CHECK(equals(outer, {4, 4, 4}));
+        auto copy = outer;
+        Vec evaluated = copy;
+        CHECK(equals(evaluated, {4, 4, 4}));
+    }
+}
+
+static void test_aliasing() {
+    Vec b = make({1, 2, 3, 4});
+    {
+        Vec a = make({10, 20, 30, 40});
+        a = a + b;
+        CHECK(equals(a, {11, 22, 33, 44}));
+        a = b - a;
+        CHECK(equals(a, {-10, -20, -30, -40}));
+        a = a + a;
+        CHECK(equals(a, {-20, -40, -60, -80}));
+    }
+    {
+        Vec a = make({1, 2, 3, 4});
+        a = qm::shift(a, 1);
+        CHECK(equals(a, {2, 3, 4, 1}));
+        a = qm::shift(a, -1);  // needs the original order back
+        CHECK(equals(a, {1, 2, 3, 4}));
+        a = qm::shift(a, 7);  // 7 % 4 == 3
+        CHECK(equals(a, {4, 1, 2, 3}));
+        a = qm::shift(qm::shift(a, 1), 1);
+        CHECK(equals(a, {2, 3, 4, 1}));
+    }
+    {
+        Vec a = make({1, 2, 3, 4});
+        a = a + qm::shift(a, 1) * 2.0;
+        CHECK(equals(a, {5, 8, 11, 6}));
+    }
+    {
+        Vec a = make({1, 2, 3, 4});
+        a = -qm::shift(a * 2.0 + b, 3);  // the shift sits deep in the tree
+        CHECK(equals(a, {-12, -3, -6, -9}));
+    }
+    {
+        Vec a = make({1, 2, 3, 4});
+        auto view = qm::shift(a, 1);
+        a = view;  // alias through a stored expression
+        CHECK(equals(a, {2, 3, 4, 1}));
+        CHECK(equals(view, {3, 4, 1, 2}));  // still a view of a, not of its old buffer
+    }
+    {
+        // A named expression over a keeps working after the temporary-buffer path.
+        Vec a = make({1, 2, 3, 4});
+        auto twice = a * 2.0;
+        a = qm::shift(a, 2);
+        CHECK(equals(twice, {6, 8, 2, 4}));
+    }
+}
+
+static void test_sizes() {
+    Vec a(3), b(3, 1.0), c(4, 1.0), target(3);
+    CHECK_MISMATCH(Vec x = b + c; (void)x);
+    CHECK_MISMATCH(Vec x = b - c; (void)x);
+    CHECK_MISMATCH(a = (b + b) * 2.0 - c);
+    CHECK_MISMATCH(a = qm::shift(c, 1) + b);
+    CHECK_MISMATCH((void)qm::sum(b + c));
+    CHECK_MISMATCH((void)qm::max(b + c));
+    CHECK_MISMATCH((void)qm::dot(b, c));
+    CHECK_MISMATCH((void)qm::dot(b + b, c - c));
+    CHECK_MISMATCH(target = c + c);  // an expression of the wrong size for target
+    CHECK(equals(target, {0, 0, 0}));
+
+    // An operand can change size after a valid expression was built.
+    Vec grows(3, 1.0);
+    auto stale = grows + b;
+    grows = Vec(5, 1.0);
+    CHECK_MISMATCH((void)stale.size());
+    CHECK_MISMATCH((void)stale[0]);
+    CHECK_MISMATCH(Vec x = stale; (void)x);
+    CHECK_MISMATCH(a = stale);
+    CHECK_MISMATCH((void)qm::sum(stale));
+    CHECK(equals(a, {0, 0, 0}));  // a failed assignment leaves the target alone
+
+    Vec shrinks = make({1, 2, 3, 4, 5});
+    auto view = qm::shift(shrinks, 4);
+    shrinks = make({7, 8});
+    CHECK(view.size() == 2);
+    Vec copy = view;
+    CHECK(equals(copy, {7, 8}));  // k stays usable: (i + 4) % 2 == i
+
+    // Size zero is a valid size.
+    Vec empty(0), other_empty(0);
+    empty = empty + other_empty;
+    empty = qm::shift(empty, 3);
+    CHECK(qm::sum(empty) == 0.0);
+    CHECK(qm::dot(empty, other_empty) == 0.0);
+    CHECK_MISMATCH((void)qm::max(empty));
+    Vec from_empty = empty * 2.0;
+    CHECK(from_empty.size() == 0);
+}
+
+static void test_reductions() {
+    const Vec b = make({1, -2, 3}), c = make({4, 5, 6});
+    CHECK(qm::sum(b) == 2.0);
+    CHECK(qm::sum(b + c) == 17.0);
+    CHECK(qm::sum(Vec(3, 2.0) * 2.0) == 12.0);
+    CHECK(qm::dot(b, c) == 12.0);
+    CHECK(qm::dot(b * 2.0, c - b) == 2.0 * (3.0 - 14.0 + 9.0));
+    CHECK(qm::max(b) == 3.0);
+    CHECK(qm::max(-b) == 2.0);
+    CHECK(qm::max(qm::shift(b, 1)) == 3.0);
+    CHECK(sum(b + c) == 17.0);  // reachable through ADL too
+
+    const double nan = std::numeric_limits<double>::quiet_NaN();
+    CHECK(std::isnan(qm::max(make({1, nan, 2}))));
+    CHECK(std::isnan(qm::max(make({nan, 1, 2}))));
+    CHECK(std::isnan(qm::max(make({1, 2, nan}))));
+}
+
+static void test_value_semantics() {
+    Vec a = make({1, 2});
+    Vec copy = a;
+    copy[0] = 9;
+    CHECK(a[0] == 1);
+
+    Vec moved = std::move(a);
+    CHECK(moved[1] == 2);
+    CHECK(a.size() == 0);  // NOLINT: the moved-from state is part of the contract
+
+    Vec resized(5);
+    resized = moved;  // Vec-to-Vec assignment keeps ordinary resizing semantics
+    CHECK(equals(resized, {1, 2}));
+    resized = resized;
+    CHECK(equals(resized, {1, 2}));
+    resized = Vec(3, 7.0);
+    CHECK(equals(resized, {7, 7, 7}));
+
+    a = make({3, 4});  // a moved-from Vec is reusable
+    CHECK(equals(a, {3, 4}));
+}
+
+int main() {
+    test_arithmetic();
+    test_laziness();
+    test_allocations();
+    test_lifetime();
+    test_aliasing();
+    test_sizes();
+    test_reductions();
+    test_value_semantics();
+    if (g_failures == 0) std::puts("all tests passed");
+    return g_failures == 0 ? 0 : 1;
+}
