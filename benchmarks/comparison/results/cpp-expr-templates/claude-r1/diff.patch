+
+// Expression nodes implement, besides size():
+//   get(i, n)            element i, given the already validated size n; a
+//                        parent passes n down so that no node has to recompute it
+//   alias(target, moved) whether the node reads `target` at an index other than
+//                        the one being written; `moved` is set under a shift
+template <class Derived>
+class Expr : public detail::ExprTag {
+public:
+    double operator[](std::size_t i) const {
+        const auto& self = static_cast<const Derived&>(*this);
+        return self.get(i, self.size());
+    }
+};
+
+class VecRef : public Expr<VecRef> {
+public:
+    explicit VecRef(const Vec& v) noexcept : v_(&v) {}
+    std::size_t size() const noexcept { return v_->size(); }
+    double get(std::size_t i, std::size_t) const noexcept { return (*v_)[i]; }
+    bool alias(const Vec* target, bool moved) const noexcept { return moved && v_ == target; }
+
+private:
+    const Vec* v_;
+};
+
+class VecOwned : public Expr<VecOwned> {
+public:
+    explicit VecOwned(Vec v) noexcept : data_(std::move(v.data_)), size_(v.size_) {}
+    std::size_t size() const noexcept { return size_; }
+    double get(std::size_t i, std::size_t) const noexcept { return data_[i]; }
+    // The buffer left its Vec for good, so no assignment can target it.
+    bool alias(const Vec*, bool) const noexcept { return false; }
+
+private:
+    std::shared_ptr<const double[]> data_;
+    std::size_t size_;
+};
+
+namespace detail {
+template <class E>
+auto capture(E&& e) {
+    using T = std::remove_cvref_t<E>;
+    if constexpr (!std::derived_from<T, Vec>) {
+        return T(std::forward<E>(e));
+    } else if constexpr (std::is_lvalue_reference_v<E>) {
+        return VecRef(e);
+    } else {
+        return VecOwned(Vec(std::forward<E>(e)));  // copies only a const rvalue
+    }
+}
+
+template <class E>
+using capture_t = decltype(capture(std::declval<E>()));
+}  // namespace detail
+
+template <class L, class R, class Op>
+class BinaryExpr : public Expr<BinaryExpr<L, R, Op>> {
+public:
+    BinaryExpr(L l, R r) : l_(std::move(l)), r_(std::move(r)) { (void)size(); }
+
+    std::size_t size() const {
+        const std::size_t n = l_.size();
+        if (n != r_.size()) detail::throw_size_mismatch();
+        return n;
+    }
+    double get(std::size_t i, std::size_t n) const noexcept {
+        return Op{}(l_.get(i, n), r_.get(i, n));
+    }
+    bool alias(const Vec* target, bool moved) const noexcept {
+        return l_.alias(target, moved) || r_.alias(target, moved);
+    }
+
+private:
+    L l_;
+    R r_;
+};
+
+template <class E, class Op>
+class MapExpr : public Expr<MapExpr<E, Op>> {
+public:
+    MapExpr(E e, Op op) : e_(std::move(e)), op_(op) {}
+
+    std::size_t size() const { return e_.size(); }
+    double get(std::size_t i, std::size_t n) const noexcept { return op_(e_.get(i, n)); }
+    bool alias(const Vec* target, bool moved) const noexcept { return e_.alias(target, moved); }
+
+private:
+    E e_;
+    Op op_;
+};
+
+template <class E>
+class ShiftExpr : public Expr<ShiftExpr<E>> {
+public:
+    ShiftExpr(E e, std::ptrdiff_t k) : e_(std::move(e)), k_(normalize(k, e_.size())) {}
+
+    std::size_t size() const { return e_.size(); }
+    double get(std::size_t i, std::size_t n) const noexcept { return e_.get((i + k_) % n, n); }
+    bool alias(const Vec* target, bool moved) const noexcept {
+        return e_.alias(target, moved || k_ != 0);
+    }
+
+private:
+    static std::size_t normalize(std::ptrdiff_t k, std::size_t n) noexcept {
+        if (n == 0) return 0;
+        const auto m = static_cast<std::ptrdiff_t>(n);
+        return static_cast<std::size_t>(((k % m) + m) % m);
+    }
+
+    E e_;
+    std::size_t k_;  // in [0, n) for the size seen here, so i + k_ cannot wrap
+};
+
+namespace detail {
+struct Negate {
+    double operator()(double x) const noexcept { return -x; }
+};
+struct Multiply {
+    double factor;
+    double operator()(double x) const noexcept { return x * factor; }
+};
+struct Divide {
+    double divisor;
+    double operator()(double x) const noexcept { return x / divisor; }
+};
+
+template <class Op, class L, class R>
+auto binary(L&& l, R&& r) {
+    return BinaryExpr<capture_t<L>, capture_t<R>, Op>(capture(std::forward<L>(l)),
+                                                      capture(std::forward<R>(r)));
+}
+}  // namespace detail
+
+template <VecExpr L, VecExpr R>
+auto operator+(L&& l, R&& r) {
+    return detail::binary<std::plus<>>(std::forward<L>(l), std::forward<R>(r));
+}
+
+template <VecExpr L, VecExpr R>
+auto operator-(L&& l, R&& r) {
+    return detail::binary<std::minus<>>(std::forward<L>(l), std::forward<R>(r));
+}
+
+template <VecExpr E>
+auto operator-(E&& e) {
+    return MapExpr(detail::capture(std::forward<E>(e)), detail::Negate{});
+}
+
+template <VecExpr E>
+auto operator*(E&& e, double factor) {
+    return MapExpr(detail::capture(std::forward<E>(e)), detail::Multiply{factor});
+}
+
+template <VecExpr E>
+auto operator*(double factor, E&& e) {
+    return MapExpr(detail::capture(std::forward<E>(e)), detail::Multiply{factor});
+}
+
+template <VecExpr E>
+auto operator/(E&& e, double divisor) {
+    return MapExpr(detail::capture(std::forward<E>(e)), detail::Divide{divisor});
