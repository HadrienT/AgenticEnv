+
+// Lazy view whose element i is e[(i + k) % n]. A negative k shifts the other
+// way. Assigning a shifted view of a Vec to that same Vec goes through one
+// temporary buffer, since the view reads elements the loop would overwrite.
+template <VecExpr E>
+auto shift(E&& e, std::ptrdiff_t k) {
+    return ShiftExpr<detail::capture_t<E>>(detail::capture(std::forward<E>(e)), k);
+}
+
+template <VecExpr E>
+double sum(const E& e) {
+    const auto x = detail::capture(e);
+    const std::size_t n = x.size();
+    double total = 0.0;
+    for (std::size_t i = 0; i < n; ++i) total += x.get(i, n);
+    return total;
+}
+
+template <VecExpr L, VecExpr R>
+double dot(const L& l, const R& r) {
+    const auto x = detail::capture(l);
+    const auto y = detail::capture(r);
+    const std::size_t n = x.size();
+    if (n != y.size()) detail::throw_size_mismatch();
+    double total = 0.0;
+    for (std::size_t i = 0; i < n; ++i) total += x.get(i, n) * y.get(i, n);
+    return total;
+}
+
+// Throws std::invalid_argument on an empty expression. NaN propagates, wherever
+// it appears.
+template <VecExpr E>
+double max(const E& e) {
+    const auto x = detail::capture(e);
+    const std::size_t n = x.size();
+    if (n == 0) throw std::invalid_argument("qm::max: empty expression");
+    double best = x.get(0, n);
+    for (std::size_t i = 1; i < n && !std::isnan(best); ++i) {
+        const double value = x.get(i, n);
+        if (std::isnan(value) || value > best) best = value;
+    }
+    return best;
+}
+
 }  // namespace qm
