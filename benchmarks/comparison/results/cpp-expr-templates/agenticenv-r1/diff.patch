+    double operator[](std::size_t i) const { return -expr_[i]; }
+};
+
+template<typename Expr>
+class VecScale : public VecExprBase<VecScale<Expr>> {
+private:
+    const Expr& expr_;
+    double scalar_;
+    
+public:
+    VecScale(const Expr& expr, double scalar) : expr_(expr), scalar_(scalar) {}
+    
