+// Free functions for expression operations
+template<VecExpr Lhs, VecExpr Rhs>
+auto operator+(const Lhs& lhs, const Rhs& rhs) {
+    return VecAdd<Lhs, Rhs>(lhs, rhs);
+}
+
+template<VecExpr Lhs, VecExpr Rhs>
+auto operator-(const Lhs& lhs, const Rhs& rhs) {
+    return VecSub<Lhs, Rhs>(lhs, rhs);
+}
+
+template<VecExpr Expr>
+auto operator-(const Expr& expr) {
+    return VecNeg<Expr>(expr);
+}
+
+template<VecExpr Expr>
+auto operator*(const Expr& expr, double scalar) {
+    return VecScale<Expr>(expr, scalar);
+}
+
+template<VecExpr Expr>
+auto operator*(double scalar, const Expr& expr) {
+    return VecScale<Expr>(expr, scalar);
+}
+
+template<VecExpr Expr>
+auto operator/(const Expr& expr, double scalar) {
+    return VecScale<Expr>(expr, 1.0 / scalar);
+}
+
+// Reduction operations
+template<VecExpr Expr>
+double sum(const Expr& expr) {
+    double result = 0.0;
+    for (std::size_t i = 0; i < expr.size(); ++i) {
+        result += expr[i];
+    }
+    return result;
+}
+
+template<VecExpr Expr1, VecExpr Expr2>
+double dot(const Expr1& expr1, const Expr2& expr2) {
+    if (expr1.size() != expr2.size()) {
+        throw std::invalid_argument("Size mismatch in dot product");
+    }
+    double result = 0.0;
+    for (std::size_t i = 0; i < expr1.size(); ++i) {
+        result += expr1[i] * expr2[i];
+    }
+    return result;
+}
+
+template<VecExpr Expr>
+double max(const Expr& expr) {
+    if (expr.size() == 0) {
+        throw std::invalid_argument("Empty expression in max");
+    }
+    double result = expr[0];
+    for (std::size_t i = 1; i < expr.size(); ++i) {
+        result = std::max(result, expr[i]);
+    }
+    return result;
+}
+
+// Scalar operations for Vec
+inline Vec operator*(const Vec& expr, double scalar) {
+    return Vec(VecScale<Vec>(expr, scalar));
+}
+
+inline Vec operator*(double scalar, const Vec& expr) {
+    return Vec(VecScale<Vec>(expr, scalar));
+}
+
+inline Vec operator/(const Vec& expr, double scalar) {
+    return Vec(VecScale<Vec>(expr, 1.0 / scalar));
+}
+
+// Shift function
+template<VecExpr Expr>
+auto shift(const Expr& expr, std::size_t k) {
+    return VecShift<Expr>(expr, k);
+}
