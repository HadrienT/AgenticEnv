+// Concept for vector expressions
+template<typename E>
+concept VecExpr = requires(const E& e) {
+    { e.size() } -> std::convertible_to<std::size_t>;
+    { e[0] } -> std::convertible_to<double>;
+};
+
+// Base expression class for lazy evaluation
+template<typename Derived>
+class VecExprBase {
+public:
+    std::size_t size() const { return static_cast<const Derived&>(*this).size(); }
+    
+    // Assignment operator for expressions
+    template<VecExpr Other>
+    Derived& operator=(const Other& other) {
+        static_assert(std::is_same_v<Derived, Other>, "Assignment to different types");
+        static_cast<Derived&>(*this) = other;
+        return static_cast<Derived&>(*this);
+    }
+    
+    // Compound assignment operators
+    template<VecExpr Other>
+    Derived& operator+=(const Other& other) {
+        static_cast<Derived&>(*this) += other;
+        return static_cast<Derived&>(*this);
+    }
+    
+    template<VecExpr Other>
+    Derived& operator-=(const Other& other) {
+        static_cast<Derived&>(*this) -= other;
+        return static_cast<Derived&>(*this);
+    }
+    
+    // Arithmetic operators with scalars
+    Derived operator*(double scalar) const {
+        return static_cast<const Derived&>(*this) * scalar;
+    }
+    
+    Derived operator/(double scalar) const {
+        return static_cast<const Derived&>(*this) / scalar;
+    }
+};
+
+// Expression templates for binary operations
+template<typename Lhs, typename Rhs>
+class VecAdd : public VecExprBase<VecAdd<Lhs, Rhs>> {
+private:
+    const Lhs& lhs_;
+    const Rhs& rhs_;
+    
+public:
+    VecAdd(const Lhs& lhs, const Rhs& rhs) : lhs_(lhs), rhs_(rhs) {
+        if (lhs.size() != rhs.size()) {
+            throw std::invalid_argument("Size mismatch in addition");
+        }
+    }
+    
+    std::size_t size() const { return lhs_.size(); }
+    double operator[](std::size_t i) const { return lhs_[i] + rhs_[i]; }
+};
+
+template<typename Lhs, typename Rhs>
+class VecSub : public VecExprBase<VecSub<Lhs, Rhs>> {
+private:
+    const Lhs& lhs_;
+    const Rhs& rhs_;
