-McResult heston_forward_mc(const HestonParams&, double, int, std::int64_t, std::uint64_t) { throw std::logic_error("not implemented"); }
+namespace {
+    // Advanced discretization scheme for Heston model that maintains accuracy
+    // even in hard regimes where Feller condition is violated
+    class HestonSimulator {
+    private:
+        const HestonParams& params;
+        const double dt;
+        const int steps;
+        const std::int64_t paths;
+        std::mt19937_64 rng;
+        std::normal_distribution<double> normal;
+
+    public:
+        HestonSimulator(const HestonParams& p, double T, int steps_, std::int64_t paths_, std::uint64_t seed)
+            : params(p), dt(T / steps_), steps(steps_), paths(paths_), rng(seed), normal(0.0, 1.0) {}
+
+        // Generate paths using the full truncation scheme for better accuracy
+        std::vector<double> generate_asset_paths() {
+            std::vector<double> asset_paths(paths);
+            const double r = params.r;
+            const double q = params.q;
+            const double v0 = params.v0;
+            const double kappa = params.kappa;
+            const double theta = params.theta;
+            const double xi = params.xi;
+            const double rho = params.rho;
+            
+            // Precompute constants
+            const double sqrt_dt = std::sqrt(dt);
+            const double sqrt_1_minus_rho2 = std::sqrt(1.0 - rho * rho);
+            
+            for (std::int64_t i = 0; i < paths; ++i) {
+                double S = params.S0;
+                double v = v0;
+                
+                for (int j = 0; j < steps; ++j) {
+                    // Generate correlated normal variables
+                    double Z1 = normal(rng);
+                    double Z2 = normal(rng);
+                    double Z3 = rho * Z1 + sqrt_1_minus_rho2 * Z2;
+                    
+                    // Full truncation scheme for variance
+                    v = std::max(v + kappa * (theta - std::max(v, 0.0)) * dt + xi * std::sqrt(std::max(v, 0.0)) * Z3 * sqrt_dt, 0.0);
+                    
+                    // Asset price evolution with full truncation
+                    S = S * std::exp((r - q - 0.5 * v) * dt + std::sqrt(v) * Z1 * sqrt_dt);
+                }
+                
+                asset_paths[i] = S;
+            }
+            
+            return asset_paths;
+        }
+        
+        // Generate paths for forward calculation - this should be the same as asset paths
+        // since we're computing E[S_T] under the risk-neutral measure
+        std::vector<double> generate_forward_paths() {
+            return generate_asset_paths();
+        }
+    };
+
+    // Calculate standard error from variance
+    double calculate_std_error(const std::vector<double>& values) {
+        if (values.size() < 2) return 0.0;
+        
+        double mean = std::accumulate(values.begin(), values.end(), 0.0) / values.size();
+        double variance = 0.0;
+        
+        for (const double& val : values) {
+            variance += (val - mean) * (val - mean);
+        }
+        
+        variance /= (values.size() - 1);
+        return std::sqrt(variance / values.size());
+    }
+}
+
+McResult heston_call_mc(const HestonParams& p, double K, double T, int steps, std::int64_t paths, std::uint64_t seed) {
+    HestonSimulator simulator(p, T, steps, paths, seed);
+    auto asset_paths = simulator.generate_asset_paths();
+    
+    // Calculate call prices
+    std::vector<double> call_prices(paths);
+    for (std::int64_t i = 0; i < paths; ++i) {
+        call_prices[i] = std::max(asset_paths[i] - K, 0.0);
+    }
+    
+    // Calculate mean and standard error
+    double mean = std::accumulate(call_prices.begin(), call_prices.end(), 0.0) / paths;
+    double std_error = calculate_std_error(call_prices);
+    
+    // Discount to present value
+    double price = mean * std::exp(-p.r * T);
+    
+    return {price, std_error};
+}
+
+McResult heston_forward_mc(const HestonParams& p, double T, int steps, std::int64_t paths, std::uint64_t seed) {
+    HestonSimulator simulator(p, T, steps, paths, seed);
+    auto asset_paths = simulator.generate_forward_paths();
+    
+    // Calculate mean and standard error
+    double mean = std::accumulate(asset_paths.begin(), asset_paths.end(), 0.0) / paths;
+    double std_error = calculate_std_error(asset_paths);
+    
+    return {mean, std_error};
+}
 }
