+#include "include/heston.hpp"
+#include <iostream>
+#include <iomanip>
+#include <cmath>
+
+int main() {
+    // Test with simpler parameters to verify implementation
+    mc::HestonParams params{
+        .S0 = 100.0,    // Initial stock price
+        .r = 0.05,      // Risk-free rate
+        .q = 0.0,       // No dividend yield
+        .v0 = 0.04,     // Initial variance
+        .kappa = 1.0,   // Mean reversion speed
+        .theta = 0.04,  // Long-term variance
+        .xi = 0.5,      // Volatility of variance
+        .rho = -0.5     // Correlation
+    };
+    
+    double K = 100.0;  // Strike price
+    double T = 10.0;   // Time to maturity (as in problem)
+    int steps = 80;    // 8 steps per year for 10 years (as in problem)
+    std::int64_t paths = 100000;  // 100k paths for better accuracy
+    std::uint64_t seed = 12345;
+    
+    std::cout << std::fixed << std::setprecision(6);
+    std::cout << "Testing Heston Model Implementation\n";
+    std::cout << "====================================\n";
+    std::cout << "Parameters:\n";
+    std::cout << "  S0 = " << params.S0 << "\n";
+    std::cout << "  r = " << params.r << "\n";
+    std::cout << "  q = " << params.q << "\n";
+    std::cout << "  v0 = " << params.v0 << "\n";
+    std::cout << "  kappa = " << params.kappa << "\n";
+    std::cout << "  theta = " << params.theta << "\n";
+    std::cout << "  xi = " << params.xi << "\n";
+    std::cout << "  rho = " << params.rho << "\n";
+    std::cout << "  T = " << T << "\n";
+    std::cout << "  steps = " << steps << "\n";
+    std::cout << "  paths = " << paths << "\n";
+    std::cout << "\n";
+    
+    // Test call option pricing
+    auto call_result = mc::heston_call_mc(params, K, T, steps, paths, seed);
+    std::cout << "Call Option Result:\n";
+    std::cout << "  Price = " << call_result.price << "\n";
+    std::cout << "  Std Error = " << call_result.std_error << "\n";
+    
+    // Test forward calculation
+    auto forward_result = mc::heston_forward_mc(params, T, steps, paths, seed);
+    std::cout << "\nForward Result:\n";
+    std::cout << "  Forward Price = " << forward_result.price << "\n";
+    std::cout << "  Std Error = " << forward_result.std_error << "\n";
+    
+    // Check martingale property: E[S_T] should match forward price
+    double forward_price = params.S0 * std::exp((params.r - params.q) * T);
+    std::cout << "\nMartingale Check:\n";
+    std::cout << "  Forward Price (S0 * exp((r-q)*T)) = " << forward_price << "\n";
+    std::cout << "  E[S_T] from MC = " << forward_result.price << "\n";
+    std::cout << "  Difference = " << std::abs(forward_result.price - forward_price) << "\n";
+    
+    return 0;
+}
