@@ -0,0 +1,46 @@
+#include "include/heston.hpp"
+#include <iostream>
+#include <chrono>
+
+int main() {
+    mc::HestonParams params{
+        .S0 = 100.0,
+        .r = 0.05,
+        .q = 0.02,
+        .v0 = 0.04,
+        .kappa = 0.5,
+        .theta = 0.04,
+        .xi = 1.0,
+        .rho = -0.9
+    };
+    
+    // Test performance with 1M paths and 80 steps as required
+    const int steps = 80;
+    const std::int64_t paths = 1000000;
+    const double T = 10.0;
+    const double K = 100.0;
+    
+    auto start = std::chrono::high_resolution_clock::now();
+    
+    auto result1 = mc::heston_call_mc(params, K, T, steps, paths, 12345);
+    auto result2 = mc::heston_forward_mc(params, T, steps, paths, 12345);
+    
+    auto end = std::chrono::high_resolution_clock::now();
+    auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);
+    
+    std::cout << "Performance test:" << std::endl;
+    std::cout << "Paths: " << paths << std::endl;
+    std::cout << "Steps: " << steps << std::endl;
+    std::cout << "Time: " << duration.count() << " ms" << std::endl;
+    std::cout << "Call price: " << result1.price << " +/- " << result1.std_error << std::endl;
+    std::cout << "Forward price: " << result2.price << " +/- " << result2.std_error << std::endl;
+    
+    // Check if performance target is met (20 seconds max)
+    if (duration.count() <= 20000) {
+        std::cout << "✓ Performance target met!" << std::endl;
+    } else {
+        std::cout << "✗ Performance target NOT met!" << std::endl;
+    }
+    
+    return 0;
+}
