 #include "heston.hpp"
-#include <stdexcept>
+#include <random>
+#include <cmath>
+#include <algorithm>
+#include <numeric>
+#include <limits>
+
 namespace mc {
-McResult heston_call_mc(const HestonParams&, double, double, int, std::int64_t, std::uint64_t) { throw std::logic_error("not implemented"); }
-McResult heston_forward_mc(const HestonParams&, double, int, std::int64_t, std::uint64_t) { throw std::logic_error("not implemented"); }
+namespace {
+    // Full truncation scheme for Heston variance process
+    inline double variance_step(double v, double kappa, double theta, double xi, double dw_v, double dt) {
+        // Full truncation scheme for variance process
+        double v_new = v + kappa * (theta - std::max(0.0, v)) * dt + xi * std::sqrt(std::max(0.0, v)) * dw_v;
+        return std::max(0.0, v_new);
+    }
+
+    // Generate correlated normal random variables
+    inline void correlated_normal(double z1, double z2, double rho, double& z1_new, double& z2_new) {
+        z1_new = z1;
+        z2_new = rho * z1 + std::sqrt(1.0 - rho * rho) * z2;
+    }
 }
+
+McResult heston_call_mc(const HestonParams& p, double K, double T, int steps, std::int64_t paths, std::uint64_t seed) {
+    // Initialize random number generator
+    std::mt19937_64 rng(seed);
+    std::normal_distribution<double> dist(0.0, 1.0);
+    
+    // Calculate time step
+    double dt = T / steps;
+    
+    // Precompute constants for performance
+    double drift = (p.r - p.q) * dt;
+    double sqrt_dt = std::sqrt(dt);
+    double sqrt_one_minus_rho_sq = std::sqrt(1.0 - p.rho * p.rho);
+    
+    // Storage for results
+    std::vector<double> payoffs(paths);
+    
+    // Monte Carlo simulation
+    for (std::int64_t i = 0; i < paths; ++i) {
+        // Initialize asset price and variance
+        double S = p.S0;
+        double v = p.v0;
+        
+        // Generate correlated Brownian motions
+        double dw_S = dist(rng);
+        double dw_v = dist(rng);
+        double dw_S_corr, dw_v_corr;
+        correlated_normal(dw_S, dw_v, p.rho, dw_S_corr, dw_v_corr);
+        
+        // Simulate path
+        for (int j = 0; j < steps; ++j) {
+            // Update variance using full truncation scheme
+            v = variance_step(v, p.kappa, p.theta, p.xi, dw_v_corr, dt);
+            
+            // Update asset price
+            double diffusion = std::sqrt(std::max(0.0, v)) * dw_S_corr;
+            S *= std::exp(drift + diffusion);
+            
+            // Generate new Brownian motions for next step
+            dw_S = dist(rng);
+            dw_v = dist(rng);
+            correlated_normal(dw_S, dw_v, p.rho, dw_S_corr, dw_v_corr);
+        }
+        
+        // Calculate payoff
+        payoffs[i] = std::max(0.0, S - K);
+    }
+    
+    // Calculate mean and standard error
+    double mean = std::accumulate(payoffs.begin(), payoffs.end(), 0.0) / paths;
+    double variance = 0.0;
+    for (double payoff : payoffs) {
+        variance += (payoff - mean) * (payoff - mean);
+    }
+    variance /= (paths - 1);
+    double std_error = std::sqrt(variance / paths);
+    
+    // Discount to present value
+    double price = mean * std::exp(-p.r * T);
+    
+    return {price, std_error};
+}
+
+McResult heston_forward_mc(const HestonParams& p, double T, int steps, std::int64_t paths, std::uint64_t seed) {
+    // Initialize random number generator
+    std::mt19937_64 rng(seed);
+    std::normal_distribution<double> dist(0.0, 1.0);
+    
+    // Calculate time step
+    double dt = T / steps;
+    
+    // Precompute constants for performance
+    double drift = (p.r - p.q) * dt;
+    double sqrt_dt = std::sqrt(dt);
+    double sqrt_one_minus_rho_sq = std::sqrt(1.0 - p.rho * p.rho);
+    
+    // Storage for results
+    std::vector<double> prices(paths);
+    
+    // Monte Carlo simulation
+    for (std::int64_t i = 0; i < paths; ++i) {
+        // Initialize asset price and variance
+        double S = p.S0;
+        double v = p.v0;
+        
+        // Generate correlated Brownian motions
+        double dw_S = dist(rng);
+        double dw_v = dist(rng);
+        double dw_S_corr, dw_v_corr;
+        correlated_normal(dw_S, dw_v, p.rho, dw_S_corr, dw_v_corr);
+        
+        // Simulate path
+        for (int j = 0; j < steps; ++j) {
+            // Update variance using full truncation scheme
+            v = variance_step(v, p.kappa, p.theta, p.xi, dw_v_corr, dt);
+            
+            // Update asset price
+            double diffusion = std::sqrt(std::max(0.0, v)) * dw_S_corr;
+            S *= std::exp(drift + diffusion);
+            
+            // Generate new Brownian motions for next step
+            dw_S = dist(rng);
+            dw_v = dist(rng);
+            correlated_normal(dw_S, dw_v, p.rho, dw_S_corr, dw_v_corr);
+        }
+        
+        // Store final price
+        prices[i] = S;
+    }
+    
+    // Calculate mean and standard error
+    double mean = std::accumulate(prices.begin(), prices.end(), 0.0) / paths;
+    double variance = 0.0;
+    for (double price : prices) {
+        variance += (price - mean) * (price - mean);
+    }
+    variance /= (paths - 1);
+    double std_error = std::sqrt(variance / paths);
+    
+    return {mean, std_error};
+}
+
+}  // namespace mc
