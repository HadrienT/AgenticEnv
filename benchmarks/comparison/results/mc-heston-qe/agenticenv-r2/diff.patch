+#include "include/heston.hpp"
+#include <iostream>
+#include <iomanip>
+
+int main() {
+    mc::HestonParams params{
+        .S0 = 100.0,
+        .r = 0.05,
+        .q = 0.02,
+        .v0 = 0.04,
+        .kappa = 0.5,
+        .theta = 0.04,
+        .xi = 1.0,
+        .rho = -0.9
+    };
+    
+    std::cout << std::fixed << std::setprecision(6);
+    std::cout << "Parameters:" << std::endl;
+    std::cout << "S0: " << params.S0 << std::endl;
+    std::cout << "r: " << params.r << std::endl;
+    std::cout << "q: " << params.q << std::endl;
+    std::cout << "v0: " << params.v0 << std::endl;
+    std::cout << "kappa: " << params.kappa << std::endl;
+    std::cout << "theta: " << params.theta << std::endl;
+    std::cout << "xi: " << params.xi << std::endl;
+    std::cout << "rho: " << params.rho << std::endl;
+    std::cout << std::endl;
+    
+    // Test with the challenging parameters from the requirements
+    auto result1 = mc::heston_call_mc(params, 100.0, 10.0, 80, 10000, 12345);
+    auto result2 = mc::heston_forward_mc(params, 10.0, 80, 10000, 12345);
+    
+    std::cout << "Call price: " << result1.price << " +/- " << result1.std_error << std::endl;
+    std::cout << "Forward price: " << result2.price << " +/- " << result2.std_error << std::endl;
+    
+    // Test with simpler parameters to see if it works
+    mc::HestonParams simple_params{
+        .S0 = 100.0,
+        .r = 0.05,
+        .q = 0.02,
+        .v0 = 0.04,
+        .kappa = 1.0,
+        .theta = 0.04,
+        .xi = 0.5,
+        .rho = -0.5
+    };
+    
+    std::cout << "\nSimple parameters test:" << std::endl;
+    auto result3 = mc::heston_call_mc(simple_params, 100.0, 1.0, 10, 10000, 12345);
+    auto result4 = mc::heston_forward_mc(simple_params, 1.0, 10, 10000, 12345);
+    
+    std::cout << "Call price (simple): " << result3.price << " +/- " << result3.std_error << std::endl;
+    std::cout << "Forward price (simple): " << result4.price << " +/- " << result4.std_error << std::endl;
+    
+    return 0;
+}
