diff --git a/test_edge_cases.cpp b/test_edge_cases.cpp
new file mode 100644
index 0000000..1c8e030
--- /dev/null
+++ b/test_edge_cases.cpp
@@ -0,0 +1,57 @@
+#include "include/ticks.hpp"
+#include <iostream>
+#include <vector>
+#include <string>
+
+int main() {
+    std::cout << "Testing edge cases..." << std::endl;
+    
+    // Test empty vector in rolling_mean
+    std::vector<double> empty_values;
+    auto result1 = ticks::rolling_mean(empty_values, 1);
+    std::cout << "Empty rolling_mean result size: " << result1.size() << std::endl;
+    
+    // Test invalid window size in rolling_mean
+    std::vector<double> values = {1.0, 2.0, 3.0};
+    auto result2 = ticks::rolling_mean(values, 0);
+    std::cout << "Zero window rolling_mean result size: " << result2.size() << std::endl;
+    
+    auto result3 = ticks::rolling_mean(values, 5);  // window larger than vector
+    std::cout << "Large window rolling_mean result size: " << result3.size() << std::endl;
+    
+    // Test Book with empty orders
+    ticks::Book book;
+    try {
+        auto best = book.best();
+        std::cout << "Unexpected success in empty book" << std::endl;
+    } catch (const std::domain_error& e) {
+        std::cout << "Correctly caught exception for empty book: " << e.what() << std::endl;
+    }
+    
+    // Test add_and_improvement on empty book
+    double improvement = book.add_and_improvement({100.0, 10});
+    std::cout << "Improvement on empty book: " << improvement << std::endl;
+    
+    // Test middle_word with empty vector
+    std::vector<std::string> empty_words;
+    auto middle = ticks::middle_word(empty_words);
+    std::cout << "Middle word of empty vector: '" << middle << "'" << std::endl;
+    
+    // Test middle_word with single element
+    std::vector<std::string> single_word = {"  hello  "};
+    auto middle2 = ticks::middle_word(single_word);
+    std::cout << "Middle word of single element: '" << middle2 << "'" << std::endl;
+    
+    // Test append_negated with empty vector
+    std::vector<double> empty_v;
+    ticks::append_negated(empty_v);
+    std::cout << "Append negated on empty vector size: " << empty_v.size() << std::endl;
+    
+    // Test archive_label with empty string
+    std::vector<std::string> archive;
+    std::string label = ticks::archive_label("", archive);
+    std::cout << "Archive label for empty string: " << label << std::endl;
+    
+    std::cout << "All edge case tests passed!" << std::endl;
+    return 0;
+}
