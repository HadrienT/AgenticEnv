+// Implied volatility solver using a robust hybrid approach
+double implied_vol(double price, double S, double K, double r, double q, double T, bool is_call) {
+    // Handle edge cases
+    if (S <= 0 || K <= 0 || T <= 0) {
+        return std::numeric_limits<double>::quiet_NaN();
+    }
+    
+    // Calculate intrinsic value
+    const double intrinsic = is_call ? std::max(0.0, S - K) : std::max(0.0, K - S);
+    const double discounted_intrinsic = is_call ? std::max(0.0, S * std::exp(-q * T) - K * std::exp(-r * T)) : 
+                                              std::max(0.0, K * std::exp(-r * T) - S * std::exp(-q * T));
+    
+    // If price is below intrinsic value, no valid volatility exists
+    if (price <= discounted_intrinsic) {
+        return std::numeric_limits<double>::quiet_NaN();
+    }
+    
+    // If price is very close to intrinsic, return a small volatility
+    if (price - discounted_intrinsic < 1e-15) {
+        return 1e-8;
+    }
+    
+    // Calculate the maximum possible price (upper bound)
+    const double max_price = is_call ? S * std::exp(-q * T) : K * std::exp(-r * T);
+    if (price >= max_price) {
+        return std::numeric_limits<double>::quiet_NaN();
+    }
+    
+    // For very small time values, use a different approach
+    if (T < 1e-8) {
+        // For very short maturities, use a simple approximation
+        const double forward = S * std::exp((r - q) * T);
+        const double moneyness = std::log(forward / K);
+        const double vol = std::abs(moneyness) / (4.0 * std::sqrt(T));
+        return std::max(0.01, std::min(5.0, vol));
+    }
+    
+    // Use a hybrid approach: start with a good initial guess and then switch to Newton-Raphson
+    double sigma_low = 0.01;
+    double sigma_high = 5.0;
+    
+    // Initial guess using a simple approximation
+    double sigma_guess = 0.2;
+    const double forward = S * std::exp((r - q) * T);
+    const double moneyness = std::log(forward / K);
+    
+    // Use a simple approximation for initial guess
+    if (std::abs(moneyness) > 1e-10 && T > 1e-10) {
+        sigma_guess = std::sqrt(2.0 * std::abs(moneyness) / T);
+    }
+    
+    // Ensure the initial guess is within bounds
+    sigma_guess = std::max(sigma_low, std::min(sigma_high, sigma_guess));
+    
+    // Use a robust root-finding algorithm
+    const double tolerance = 1e-12;
+    const int max_iterations = 50;
+    
+    double sigma = sigma_guess;
+    
+    // Newton-Raphson iteration with safeguards
+    for (int i = 0; i < max_iterations; ++i) {
+        double price_guess = bs_price(S, K, r, q, sigma, T, is_call);
+        double vega = bs_vega(S, K, r, q, sigma, T);
+        
+        // If vega is too small, we're near the boundary - use bisection
+        if (vega < 1e-20) {
+            // Binary search approach
+            double low = sigma_low;
+            double high = sigma_high;
+            double low_price = bs_price(S, K, r, q, low, T, is_call);
+            double high_price = bs_price(S, K, r, q, high, T, is_call);
+            
+            // Make sure we have a bracket
+            if (price < low_price) {
+                // Price is too low, increase sigma
+                sigma = low + (high - low) * 0.3;
+            } else if (price > high_price) {
+                // Price is too high, decrease sigma
+                sigma = low + (high - low) * 0.7;
+            } else {
+                // We have a bracket, use it
+                while (high - low > 1e-10) {
+                    double mid = (low + high) / 2.0;
+                    double mid_price = bs_price(S, K, r, q, mid, T, is_call);
+                    if (mid_price < price) {
+                        low = mid;
+                    } else {
+                        high = mid;
+                    }
+                }
+                sigma = (low + high) / 2.0;
+            }
+            break;
+        }
+        
+        // Newton step
+        double diff = price_guess - price;
+        double new_sigma = sigma - diff / vega;
+        
+        // Apply bounds
+        new_sigma = std::max(sigma_low, std::min(sigma_high, new_sigma));
+        
+        // Check for convergence
+        if (std::abs(new_sigma - sigma) < tolerance * std::abs(sigma)) {
+            sigma = new_sigma;
+            break;
+        }
+        
+        sigma = new_sigma;
+    }
+    
+    // Final validation
+    if (sigma < sigma_low || sigma > sigma_high) {
+        return std::numeric_limits<double>::quiet_NaN();
+    }
+    
+    return sigma;
+}
