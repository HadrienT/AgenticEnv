+// Black-Scholes price function
+double bs_price(double S, double K, double r, double q, double sigma, double T, bool is_call) {
+    if (S <= 0 || K <= 0 || sigma <= 0 || T <= 0) {
+        return 0.0;
+    }
+    
+    const double d1 = (std::log(S / K) + (r - q + 0.5 * sigma * sigma) * T) / (sigma * std::sqrt(T));
+    const double d2 = d1 - sigma * std::sqrt(T);
+    
+    const double N_d1 = is_call ? 
+        0.5 * (1.0 + std::erf(d1 / std::sqrt(2.0))) : 
+        0.5 * (1.0 - std::erf(d1 / std::sqrt(2.0)));
+        
+    const double N_d2 = is_call ? 
+        0.5 * (1.0 + std::erf(d2 / std::sqrt(2.0))) : 
+        0.5 * (1.0 - std::erf(d2 / std::sqrt(2.0)));
+    
+    const double price = is_call ? 
+        S * std::exp(-q * T) * N_d1 - K * std::exp(-r * T) * N_d2 :
+        K * std::exp(-r * T) * N_d2 - S * std::exp(-q * T) * N_d1;
+    
+    return price;
 }
+
+// Black-Scholes vega function (derivative of price w.r.t. sigma)
+double bs_vega(double S, double K, double r, double q, double sigma, double T) {
+    if (S <= 0 || K <= 0 || sigma <= 0 || T <= 0) {
+        return 0.0;
+    }
+    
+    const double d1 = (std::log(S / K) + (r - q + 0.5 * sigma * sigma) * T) / (sigma * std::sqrt(T));
+    const double pdf_d1 = 1.0 / std::sqrt(2.0 * M_PI) * std::exp(-0.5 * d1 * d1);
+    
+    return S * std::exp(-q * T) * std::sqrt(T) * pdf_d1;
+}
