+#include "iv.hpp"
+#include <iostream>
+#include <chrono>
+#include <random>
+#include <cmath>
+
+// Test function to verify accuracy
+bool test_accuracy() {
+    const double tolerance = 1e-7;
+    const double S = 100.0;
+    const double r = 0.05;
+    const double q = 0.02;
+    
+    // Test cases with known volatilities
+    struct TestCase {
+        double K;
+        double T;
+        double sigma;
+        bool is_call;
+    };
+    
+    TestCase test_cases[] = {
+        {100.0, 1.0, 0.2, true},   // ATM call
+        {100.0, 1.0, 0.3, false},  // ATM put
+        {90.0, 1.0, 0.25, true},   // ITM call
+        {110.0, 1.0, 0.15, false}, // ITM put
+        {100.0, 0.5, 0.1, true},   // Short maturity
+        {100.0, 5.0, 0.4, true},   // Long maturity
+        {80.0, 2.0, 0.3, true},    // OTM call
+        {120.0, 2.0, 0.2, false},  // OTM put
+        {100.0, 1.0, 0.01, true},  // Low volatility
+        {100.0, 1.0, 5.0, true},   // High volatility
+    };
+    
+    bool all_passed = true;
+    
+    for (const auto& test : test_cases) {
+        double price = model::bs_price(S, test.K, r, q, test.sigma, test.T, test.is_call);
+        double implied = model::implied_vol(price, S, test.K, r, q, test.T, test.is_call);
+        
+        if (std::isnan(implied)) {
+            std::cout << "Failed: NaN returned for sigma=" << test.sigma << std::endl;
+            all_passed = false;
+            continue;
+        }
+        
+        double error = std::abs(implied - test.sigma) / test.sigma;
+        if (error > tolerance) {
+            std::cout << "Failed: sigma=" << test.sigma << ", implied=" << implied 
+                      << ", error=" << error << std::endl;
+            all_passed = false;
+        } else {
+            std::cout << "Passed: sigma=" << test.sigma << ", implied=" << implied 
+                      << ", error=" << error << std::endl;
+        }
+    }
+    
+    return all_passed;
+}
+
+// Performance test
+void test_performance() {
+    const double S = 100.0;
+    const double K = 100.0;
+    const double r = 0.05;
+    const double q = 0.02;
+    const double T = 1.0;
+    const double sigma = 0.2;
+    
+    const int num_calls = 1000000;
+    
+    // Generate random prices for testing
+    std::random_device rd;
+    std::mt19937 gen(rd());
+    std::uniform_real_distribution<> dis(0.01, 20.0);
+    
+    auto start = std::chrono::high_resolution_clock::now();
+    
+    for (int i = 0; i < num_calls; ++i) {
+        double price = dis(gen);
+        double implied = model::implied_vol(price, S, K, r, q, T, true);
+        // Use the result to prevent optimization
+        if (i % 100000 == 0) {
+            volatile double dummy = implied;
+        }
+    }
+    
+    auto end = std::chrono::high_resolution_clock::now();
+    auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);
+    
+    std::cout << "Performance test: " << num_calls << " calls took " 
+              << duration.count() << " ms" << std::endl;
+    std::cout << "Average time per call: " << (double)duration.count() / num_calls * 1000 
+              << " microseconds" << std::endl;
+    
+    if (duration.count() > 2000) {
+        std::cout << "WARNING: Performance requirement not met (exceeds 2 seconds)" << std::endl;
+    } else {
+        std::cout << "Performance requirement met" << std::endl;
+    }
+}
+
+int main() {
+    std::cout << "Testing implied volatility solver accuracy..." << std::endl;
+    bool accuracy_ok = test_accuracy();
+    
+    std::cout << "\nTesting performance..." << std::endl;
+    test_performance();
+    
+    if (accuracy_ok) {
+        std::cout << "\nAll tests passed!" << std::endl;
+        return 0;
+    } else {
+        std::cout << "\nSome tests failed!" << std::endl;
+        return 1;
+    }
+}
