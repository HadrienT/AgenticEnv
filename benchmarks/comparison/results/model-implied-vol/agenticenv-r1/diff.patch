+#include "iv.hpp"
+#include <iostream>
+#include <cmath>
+
+int main() {
+    const double S = 100.0;
+    const double r = 0.05;
+    const double q = 0.02;
+    const double T = 1.0;
+    
+    // Test the specific failing cases
+    struct TestCase {
+        double K;
+        double sigma;
+        bool is_call;
+    };
+    
+    TestCase test_cases[] = {
+        {90.0, 0.15, true},   // ITM call
+        {110.0, 0.3, false},  // ITM put  
+        {100.0, 0.2, true},   // ATM call
+        {100.0, 5.0, true},   // High volatility
+    };
+    
+    for (const auto& test : test_cases) {
+        double price = model::bs_price(S, test.K, r, q, test.sigma, T, test.is_call);
+        double implied = model::implied_vol(price, S, test.K, r, q, T, test.is_call);
+        
+        std::cout << "K=" << test.K << ", sigma=" << test.sigma 
+                  << ", is_call=" << test.is_call 
+                  << ", price=" << price 
+                  << ", implied=" << implied 
+                  << ", error=" << (implied - test.sigma) / test.sigma 
+                  << std::endl;
+    }
+    
