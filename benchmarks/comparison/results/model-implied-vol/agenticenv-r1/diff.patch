 namespace model {
-double bs_price(double, double, double, double, double, double, bool) { throw std::logic_error("not implemented"); }
-double implied_vol(double, double, double, double, double, double, bool) { throw std::logic_error("not implemented"); }
+
+// Black-Scholes cumulative normal distribution function
+inline double norm_cdf(double x) {
+    // Using Abramowitz and Stegun approximation for the standard normal CDF
+    const double a1 =  0.254829592;
+    const double a2 = -0.284496736;
+    const double a3 =  1.421413741;
+    const double a4 = -1.453152027;
+    const double a5 =  1.061405429;
+    const double p  =  0.3275911;
+
+    // Save the sign of x
+    int sign = 1;
+    if (x < 0)
+        sign = -1;
+    x = std::abs(x) / std::sqrt(2.0);
+
+    // A&S formula 7.1.26
+    double t = 1.0 / (1.0 + p * x);
+    double y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * std::exp(-x * x);
+
+    return 0.5 * (1.0 + sign * y);
 }
+
+// Black-Scholes call price
+inline double bs_call(double S, double K, double r, double q, double sigma, double T) {
+    if (T <= 0.0) return std::max(S - K, 0.0);
+    
+    const double d1 = (std::log(S / K) + (r - q + 0.5 * sigma * sigma) * T) / (sigma * std::sqrt(T));
+    const double d2 = d1 - sigma * std::sqrt(T);
+    
+    return S * std::exp(-q * T) * norm_cdf(d1) - K * std::exp(-r * T) * norm_cdf(d2);
+}
+
+// Black-Scholes put price
+inline double bs_put(double S, double K, double r, double q, double sigma, double T) {
+    if (T <= 0.0) return std::max(K - S, 0.0);
+    
+    const double d1 = (std::log(S / K) + (r - q + 0.5 * sigma * sigma) * T) / (sigma * std::sqrt(T));
+    const double d2 = d1 - sigma * std::sqrt(T);
+    
+    return K * std::exp(-r * T) * norm_cdf(-d2) - S * std::exp(-q * T) * norm_cdf(-d1);
+}
+
+// Black-Scholes price
+double bs_price(double S, double K, double r, double q, double sigma, double T, bool is_call) {
+    return is_call ? bs_call(S, K, r, q, sigma, T) : bs_put(S, K, r, q, sigma, T);
+}
+
+// Black-Scholes vega (derivative of option price w.r.t. volatility)
+inline double bs_vega(double S, double K, double r, double q, double sigma, double T) {
+    if (T <= 0.0 || sigma <= 0.0) return 0.0;
+    
+    const double d1 = (std::log(S / K) + (r - q + 0.5 * sigma * sigma) * T) / (sigma * std::sqrt(T));
+    return S * std::exp(-q * T) * norm_cdf(d1) * std::sqrt(T);
+}
+
+// Implied volatility solver - optimized for performance and accuracy
+double implied_vol(double price, double S, double K, double r, double q, double T, bool is_call) {
+    // Handle edge cases
+    if (T <= 0.0 || S <= 0.0 || K <= 0.0) {
+        return std::numeric_limits<double>::quiet_NaN();
+    }
+    
+    // Calculate intrinsic value
+    double intrinsic = is_call ? std::max(S - K, 0.0) : std::max(K - S, 0.0);
+    
+    // If price is below intrinsic value, no valid volatility exists
+    if (price <= intrinsic) {
+        return std::numeric_limits<double>::quiet_NaN();
+    }
+    
+    // If price is above upper bound, no valid volatility exists
+    double upper_bound = is_call ? S * std::exp(-q * T) : K * std::exp(-r * T);
+    if (price >= upper_bound) {
+        return std::numeric_limits<double>::quiet_NaN();
+    }
+    
+    // For very small time values, use a simple approximation
+    if (T < 1e-10) {
+        double sigma_guess = 0.2;
+        double tolerance = 1e-12;
+        double max_iter = 100;
+        
+        for (int i = 0; i < max_iter; ++i) {
+            double computed_price = bs_price(S, K, r, q, sigma_guess, T, is_call);
+            if (std::abs(computed_price - price) < tolerance * price) {
+                return sigma_guess;
+            }
+            sigma_guess = std::max(0.001, sigma_guess * (1.0 + (price - computed_price) / (computed_price * T)));
+        }
+        return sigma_guess;
+    }
+    
+    // Use a robust and efficient approach for implied volatility calculation
+    // Initial guess using a better approximation
+    double log_moneyness = std::log(S / K);
+    double implied_vol_approx = std::abs(log_moneyness) / std::sqrt(T);
+    double sigma_guess = std::max(0.01, std::min(5.0, implied_vol_approx));
+    
+    // Use a more robust approach with proper convergence checking
+    const double tolerance = 1e-12;
+    const int max_iter = 10;  // Reduced for performance
+    
+    double sigma = sigma_guess;
+    
+    // Try Newton-Raphson with fallback to bisection
+    for (int i = 0; i < max_iter; ++i) {
+        double computed_price = bs_price(S, K, r, q, sigma, T, is_call);
+        double vega = bs_vega(S, K, r, q, sigma, T);
+        
+        // If vega is too small, we're near the boundary - use bisection
+        if (vega < 1e-15) {
+            // Use a simple bisection approach
+            double low = 0.001;
+            double high = 10.0;
+            for (int j = 0; j < 30; ++j) {
+                double mid = (low + high) / 2.0;
+                double mid_price = bs_price(S, K, r, q, mid, T, is_call);
+                if (mid_price < price) {
+                    low = mid;
+                } else {
+                    high = mid;
+                }
+            }
+            return (low + high) / 2.0;
+        }
+        
+        // Newton-Raphson step
+        double diff = computed_price - price;
+        double new_sigma = sigma - diff / vega;
+        
+        // Ensure we stay within reasonable bounds
+        new_sigma = std::max(0.001, std::min(5.0, new_sigma));
+        
+        // Check for convergence with relative tolerance
+        if (std::abs(diff) < tolerance * price) {
+            return sigma;
+        }
+        
+        sigma = new_sigma;
+    }
+    
+    // If we didn't converge, return the last value
+    return sigma;
+}
+
+}  // namespace model
