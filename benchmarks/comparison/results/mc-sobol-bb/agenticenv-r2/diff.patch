+// Arithmetic Asian call with Randomized QMC
+McResult asian_rqmc(double S0, double K, double r, double sigma, double T, int n,
+                    int points, int replicas, std::uint64_t seed, bool use_bridge) {
+    if (n <= 0 || (n & (n - 1)) != 0) {
+        throw std::invalid_argument("n must be a power of two");
+    }
+    if (points <= 0 || replicas <= 0) {
+        throw std::invalid_argument("points and replicas must be positive");
+    }
+    
+    // Initialize Sobol generator
+    Sobol sobol(use_bridge ? n : 1);
+    
+    // Generate random shifts for randomized QMC
+    std::vector<double> shifts(n);
+    std::uint64_t shift_seed = seed;
+    for (int i = 0; i < n; ++i) {
+        // Simple hash-based shift generation
+        shift_seed = shift_seed * 1103515245ULL + 12345ULL;
+        shifts[i] = static_cast<double>(shift_seed & 0xFFFFFFFF) / (1ULL << 32);
+    }
+    
+    // Vector to store option prices
+    std::vector<double> prices(replicas);
+    
+    // Generate replicas
+    for (int rep = 0; rep < replicas; ++rep) {
+        // Generate Sobol points
+        std::vector<double> sobol_points(points * n);
+        for (int i = 0; i < points; ++i) {
+            double* point = &sobol_points[i * n];
+            sobol.next(point);
+            
+            // Apply digital shift
+            for (int j = 0; j < n; ++j) {
+                point[j] = fmod(point[j] + shifts[j], 1.0);
+            }
+        }
+        
+        // Calculate option prices
+        double sum = 0.0;
+        for (int i = 0; i < points; ++i) {
+            // Generate path using Sobol points
+            std::vector<double> path(n);
+            if (use_bridge) {
+                // Use Brownian bridge
+                std::vector<double> z(n);
+                for (int j = 0; j < n; ++j) {
+                    z[j] = normal_inverse(sobol_points[i * n + j]);
+                }
+                brownian_bridge(z.data(), n, T, path.data());
+            } else {
+                // Use forward construction
+                for (int j = 0; j < n; ++j) {
+                    path[j] = normal_inverse(sobol_points[i * n + j]) * std::sqrt(T / n);
+                }
+            }
+            
+            // Calculate arithmetic average
+            double sum_path = 0.0;
+            for (int j = 0; j < n; ++j) {
+                sum_path += S0 * std::exp((r - 0.5 * sigma * sigma) * (j * T / n) + sigma * path[j]);
+            }
+            double average = sum_path / n;
+            
+            // Calculate payoff
+            double payoff = std::max(average - K, 0.0);
+            sum += payoff;
+        }
+        
+        // Store average price for this replica
+        prices[rep] = sum / points * std::exp(-r * T);
+    }
+    
+    // Calculate mean and standard error
+    double mean = 0.0;
+    for (double price : prices) {
+        mean += price;
+    }
+    mean /= replicas;
+    
+    double variance = 0.0;
+    for (double price : prices) {
+        double diff = price - mean;
+        variance += diff * diff;
+    }
+    variance /= (replicas - 1);
+    double std_error = std::sqrt(variance / replicas);
+    
+    return {mean, std_error};
+}
