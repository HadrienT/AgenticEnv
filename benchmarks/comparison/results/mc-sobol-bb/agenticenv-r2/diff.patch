+// Brownian bridge implementation
+void brownian_bridge(const double* z, int n, double T, double* w) {
+    if (n <= 0 || (n & (n - 1)) != 0) {
+        throw std::invalid_argument("n must be a power of two");
+    }
+    
+    // Simple Brownian bridge implementation
+    // For a path of n points, we have W(0) = 0, W(T) = z[0] * sqrt(T)
+    // The bridge is constructed by filling in intermediate points
+    
+    // Create a temporary array to store the bridge values
+    std::vector<double> bridge(n);
+    
+    // Set the final value (W(T))
+    bridge[n - 1] = z[0] * std::sqrt(T);
+    
+    // Build the bridge from the outside in
+    int step = n >> 1;
+    int offset = 0;
+    int z_index = 1;  // Start from z[1] for the bridge construction
+    
+    // For each level of the binary tree
+    while (step > 0) {
+        for (int i = 0; i < step; i += 2) {
+            int left = offset + i;
+            int right = offset + i + step;
+            int mid = offset + i + (step >> 1);
+            
+            // Midpoint value
+            double mean = 0.5 * (bridge[left] + bridge[right]);
+            double std_dev = std::sqrt(0.25 * T / (step + 1));
+            bridge[mid] = mean + z[z_index] * std_dev;
+            z_index++;
+        }
+        step >>= 1;
+        offset += step;
+    }
+    
+    // Copy result to output array
+    for (int i = 0; i < n; ++i) {
+        w[i] = bridge[i];
+    }
+}
