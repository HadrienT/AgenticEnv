+// Implementation of Sobol sequence generator
+Sobol::Sobol(int dim) : dimension(dim), index(0) {
+    if (dim < 1 || dim > 32) {
+        throw std::invalid_argument("Sobol dimension must be between 1 and 32");
+    }
+    // Initialize state for each dimension
+    state.resize(dim, 0);
 }
+
+void Sobol::next(double* out) {
+    // Generate next point in Sobol sequence
+    for (int i = 0; i < dimension; ++i) {
+        uint32_t result = 0;
+        uint32_t v = state[i];
+        
+        // For dimension 1 (van der Corput sequence)
+        if (i == 0) {
+            // Standard van der Corput: reverse bits of index
+            uint32_t index_copy = index;
+            uint32_t r = 0;
+            for (int j = 0; j < 32; ++j) {
+                r |= ((index_copy & 1) << (31 - j));
+                index_copy >>= 1;
+            }
+            result = r;
+        } else {
+            // For dimensions 2-32, use the direction numbers from SOBOL_DATA
+            const SobolDim& dim_data = SOBOL_DATA[i - 1];
+            
+            // Apply the direction numbers using the standard Sobol algorithm
+            uint32_t temp = v;
+            for (int j = 0; j < dim_data.s; ++j) {
+                if (temp & 1) {
+                    result ^= dim_data.m[j];
+                }
+                temp >>= 1;
+            }
+        }
+        
+        // Convert to double in [0, 1)
+        out[i] = static_cast<double>(result) / (1ULL << 32);
+        // Update state for next call
+        state[i] = v + 1;
+    }
+    index++;
+}
