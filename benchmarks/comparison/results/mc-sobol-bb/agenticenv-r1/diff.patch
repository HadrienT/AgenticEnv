+// Helper function to compute the inverse normal CDF (Box-Muller method with tail correction)
+double normal_inverse(double p) {
+    // For very small or large p, use asymptotic expansion for better accuracy
+    if (p <= 0.0) return -std::numeric_limits<double>::infinity();
+    if (p >= 1.0) return std::numeric_limits<double>::infinity();
+    
+    // Use the approximation from Abramowitz and Stegun
+    // This is a good balance between accuracy and performance
+    const double a1 =  0.196854;
+    const double a2 = -0.976169;
+    const double a3 = -0.160005;
+    const double a4 =  0.000000;
+    const double a5 =  0.000000;
+    
+    double x = p - 0.5;
+    double r = x * x;
+    double y = x * (1.0 + r * (a1 + r * (a2 + r * (a3 + r * (a4 + r * a5)))));
+    
+    // For extreme values, use asymptotic expansion
+    if (p < 1e-10 || p > 1.0 - 1e-10) {
+        double z = std::sqrt(-2.0 * std::log(p));
+        y = z - (std::log(z) + 0.5 * std::log(2.0 * M_PI)) / z;
+        if (p < 0.5) y = -y;
+    }
+    
+    return y;
 }
