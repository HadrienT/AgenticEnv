+McResult asian_rqmc(double S0, double K, double r, double sigma, double T, int n,
+                    int points, int replicas, std::uint64_t seed, bool use_bridge) {
+    // n must be a power of two
+    if ((n & (n - 1)) != 0) {
+        throw std::invalid_argument("n must be a power of two");
+    }
+    
+    // Initialize Sobol generator
+    Sobol sobol(2 * n);  // We need 2*n dimensions for the path construction
+    
+    // Generate random shifts for randomized QMC
+    std::vector<double> shifts(2 * n);
+    std::uint64_t shift_seed = seed;
+    for (int i = 0; i < 2 * n; ++i) {
+        // Simple hash-based shift generation
+        shift_seed = shift_seed * 1103515245ULL + 12345ULL;
+        shifts[i] = static_cast<double>(shift_seed & 0x7fffffff) / static_cast<double>(0x7fffffff);
+    }
+    
+    // Calculate the time step
+    double dt = T / n;
+    
+    // Calculate the discount factor
+    double discount = std::exp(-r * T);
+    
+    // Vector to store the Asian prices for each replica
+    std::vector<double> prices(replicas);
+    
+    // Generate paths for each replica
+    for (int rep = 0; rep < replicas; ++rep) {
+        // Generate a Sobol point for this replica
+        std::vector<double> sobol_point(2 * n);
+        sobol.next(sobol_point.data());
+        
+        // Apply digital shift to the Sobol points
+        for (int i = 0; i < 2 * n; ++i) {
+            sobol_point[i] = fmod(sobol_point[i] + shifts[i], 1.0);
+        }
+        
+        // Generate standard normal variates from Sobol points
+        std::vector<double> normals(2 * n);
+        for (int i = 0; i < 2 * n; ++i) {
+            normals[i] = normal_inverse(sobol_point[i]);
+        }
+        
+        // Generate the path using Brownian bridge if requested
+        std::vector<double> path(n);
+        if (use_bridge) {
+            brownian_bridge(normals.data(), n, T, path.data());
+        } else {
+            // Forward construction - assign dimensions to time steps
+            for (int i = 0; i < n; ++i) {
+                path[i] = normals[i] * std::sqrt(T / n);
+            }
+        }
+        
+        // Calculate the cumulative sum for Asian option
+        double cumulative = 0.0;
+        for (int i = 0; i < n; ++i) {
+            // Add the Brownian increment to get the price
+            double price = S0 * std::exp(sigma * path[i] + (r - 0.5 * sigma * sigma) * i * dt);
+            cumulative += price;
+        }
+        
+        // Calculate the Asian price
+        double asian_price = cumulative / n;
+        prices[rep] = std::max(asian_price - K, 0.0) * discount;
+    }
+    
+    // Calculate mean and standard error
+    double mean = 0.0;
+    for (double price : prices) {
+        mean += price;
+    }
+    mean /= replicas;
+    
+    double variance = 0.0;
+    for (double price : prices) {
+        double diff = price - mean;
+        variance += diff * diff;
+    }
+    variance /= (replicas - 1);
+    double std_error = std::sqrt(variance / replicas);
+    
+    return {mean, std_error};
+}
