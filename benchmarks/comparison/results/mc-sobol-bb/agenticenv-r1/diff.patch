+Sobol::Sobol(int dim) : dimension(dim), index(0) {
+    if (dim < 1 || dim > 32) {
+        throw std::invalid_argument("Sobol dimension must be between 1 and 32");
+    }
+    // Initialize the direction numbers for the first dimension (van der Corput)
+    // For dimension 1, we use the standard van der Corput sequence
+    for (int i = 0; i < 32; ++i) {
+        direction[0][i] = 1U << (31 - i);
+    }
+    
+    // Initialize the direction numbers for dimensions 2-32 from SOBOL_DATA
+    for (int d = 1; d < dim; ++d) {
+        const SobolDim& data = SOBOL_DATA[d - 1];
+        for (int i = 0; i < 32; ++i) {
+            direction[d][i] = 0;
+            for (int j = 0; j < data.s; ++j) {
+                if (i >= data.m[j]) {
+                    direction[d][i] |= (1U << (31 - (i - data.m[j])));
+                }
+            }
+        }
+    }
+}
+
+void Sobol::next(double* out) {
+    // Generate the next Sobol point
+    for (int d = 0; d < dimension; ++d) {
+        uint32_t result = 0;
+        uint32_t temp = index;
+        int i = 0;
+        while (temp != 0) {
+            if (temp & 1) {
+                result ^= direction[d][i];
+            }
+            temp >>= 1;
+            ++i;
+        }
+        // Convert to double in [0, 1)
+        out[d] = static_cast<double>(result) / (1ULL << 32);
+    }
+    ++index;
+}
+
+void brownian_bridge(const double* z, int n, double T, double* w) {
+    // n must be a power of two
+    if ((n & (n - 1)) != 0) {
+        throw std::invalid_argument("n must be a power of two");
+    }
+    
+    // Initialize the bridge
+    // We'll construct the path from the end backwards
+    // w[0] = 0 (start at 0)
+    // w[n-1] = z[0] * sqrt(T) (final value)
+    
+    // Set the final value
+    w[n - 1] = z[0] * std::sqrt(T);
+    
+    // Work backwards through the bridge construction
+    // For each level, we fill in the intermediate points
+    for (int level = 1; level < n; ++level) {
+        int step = 1 << level;
+        int half_step = step >> 1;
+        
+        // For each pair of points, compute the midpoint
+        for (int j = half_step; j < n; j += step) {
+            int left = j - half_step;
+            int right = j + half_step;
+            if (right >= n) right = n - 1;
+            
+            // Compute the midpoint with appropriate variance
+            double variance = T * half_step / n;
+            double mean = (w[left] + w[right]) / 2.0;
+            w[j] = mean + z[level] * std::sqrt(variance);
+        }
+    }
+}
