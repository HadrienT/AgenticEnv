+#include <iostream>
+#include <cuda_runtime.h>
+
+// Simple kernel to test if CUDA works
+__global__ void simple_kernel(int* data, int size) {
+    int idx = blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx < size) {
+        data[idx] = idx;
+    }
+}
+
+int main() {
+    // Test basic CUDA functionality
+    int deviceCount;
+    cudaGetDeviceCount(&deviceCount);
+    std::cout << "CUDA devices: " << deviceCount << std::endl;
+    
+    if (deviceCount > 0) {
+        int* d_data;
+        int* h_data = new int[10];
+        
+        cudaMalloc(&d_data, 10 * sizeof(int));
+        cudaMemset(d_data, 0, 10 * sizeof(int));
+        
+        simple_kernel<<<1, 10>>>(d_data, 10);
+        cudaMemcpy(h_data, d_data, 10 * sizeof(int), cudaMemcpyDeviceToHost);
+        
+        std::cout << "First few values: ";
+        for (int i = 0; i < 5; i++) {
+            std::cout << h_data[i] << " ";
+        }
+        std::cout << std::endl;
+        
+        cudaFree(d_data);
+        delete[] h_data;
+    }
+    
+    return 0;
+}
