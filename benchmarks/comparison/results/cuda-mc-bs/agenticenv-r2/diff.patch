+#include <cuda_runtime.h>
+#include <cmath>
+#include <algorithm>
+#include <limits>
+
+// Custom XORWOW random number generator (based on CUDA's curand)
+__device__ __forceinline__ unsigned int xorwow_rng(unsigned int* state) {
+    unsigned int t = state[0];
+    state[0] = state[1];
+    state[1] = state[2];
+    state[2] = state[3];
+    state[3] = state[4];
+    state[4] = state[5];
+    state[5] = (state[5] ^ (state[5] >> 2));
+    state[5] = (state[5] ^ (state[5] << 1)) + t;
+    return state[5];
+}
+
+// Generate a normal random variable using Box-Muller transform
+__device__ __forceinline__ double normal_rng(unsigned int* state) {
+    // Generate two uniform random numbers
+    unsigned int r1 = xorwow_rng(state);
+    unsigned int r2 = xorwow_rng(state);
+    
+    // Convert to uniform [0,1) range
+    double u1 = (r1 >> 8) * (1.0 / 16777216.0);
+    double u2 = (r2 >> 8) * (1.0 / 16777216.0);
+    
+    // Box-Muller transform
+    double z0 = sqrt(-2.0 * log(u1)) * cos(2.0 * M_PI * u2);
+    return z0;
+}
+
+// For atomic operations on doubles, we'll use a simple approach with a single accumulator
+// and reduce on the host side to avoid atomicAdd issues with doubles
+
+// Kernel for Monte Carlo pricing - each thread computes partial sums
+__global__ void mc_call_kernel(double S, double K, double r, double q, double sigma, double T,
+                               unsigned long long nPaths, unsigned long long seed,
+                               double* partial_sums, double* partial_sum_squares) {
+    unsigned long long idx = blockIdx.x * blockDim.x + threadIdx.x;
+    unsigned long long stride = gridDim.x * blockDim.x;
+    
+    // Initialize random number generator state
+    unsigned int rng_state[6];
+    rng_state[0] = (unsigned int)(seed & 0xFFFFFFFF);
+    rng_state[1] = (unsigned int)((seed >> 32) & 0xFFFFFFFF);
+    rng_state[2] = (unsigned int)(idx & 0xFFFFFFFF);
+    rng_state[3] = (unsigned int)((idx >> 32) & 0xFFFFFFFF);
+    rng_state[4] = 0x9E3779B9;
+    rng_state[5] = 0x9E3779B9;
+    
+    // Each thread processes multiple paths if needed
+    double local_sum = 0.0;
+    double local_sum_squares = 0.0;
+    
+    for (unsigned long long i = idx; i < nPaths; i += stride) {
+        // Initialize random number generator with path-specific seed
+        unsigned int path_seed = (unsigned int)(i ^ seed);
+        rng_state[0] = path_seed;
+        rng_state[1] = path_seed;
+        rng_state[2] = path_seed;
+        rng_state[3] = path_seed;
+        rng_state[4] = 0x9E3779B9;
+        rng_state[5] = 0x9E3779B9;
+        
+        // Generate standard normal random variable
+        double z = normal_rng(rng_state);
+        
+        // Calculate stock price at maturity
+        double ST = S * exp((r - q - 0.5 * sigma * sigma) * T + sigma * sqrt(T) * z);
+        
+        // Calculate payoff
+        double payoff = fmax(ST - K, 0.0);
+        
+        // Accumulate results locally
+        local_sum += payoff;
+        local_sum_squares += payoff * payoff;
+    }
+    
+    // Store partial results
+    partial_sums[idx] = local_sum;
+    partial_sum_squares[idx] = local_sum_squares;
+}
+
+McResult gpu_bs_call(double S, double K, double r, double q, double sigma, double T,
+                     unsigned long long nPaths, unsigned long long seed, int device) {
+    // Set device
+    cudaSetDevice(device);
+    
+    // Check for CUDA errors
+    cudaError_t err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        return {0.0, 0.0};
+    }
+    
+    // Calculate maximum number of paths we can handle with 256 MiB memory
+    const size_t max_memory = 256 * 1024 * 1024; // 256 MiB
+    const size_t max_paths = max_memory / (sizeof(double) * 2); // 2 doubles per path (sum and sum_squares)
+    unsigned long long effective_nPaths = std::min(nPaths, (unsigned long long)max_paths);
+    
+    // Allocate device memory for partial results
+    double *d_partial_sums, *d_partial_sum_squares;
+    double h_sum = 0.0, h_sum_squares = 0.0;
+    
+    // Allocate memory for partial sums (one per thread)
+    const int block_size = 256;
+    const int grid_size = std::min((int)((effective_nPaths + block_size - 1) / block_size), 65535);
+    size_t partial_sum_size = grid_size * sizeof(double);
+    
+    cudaMalloc(&d_partial_sums, partial_sum_size);
+    cudaMalloc(&d_partial_sum_squares, partial_sum_size);
+    
+    // Check for allocation errors
+    if (d_partial_sums == nullptr || d_partial_sum_squares == nullptr) {
+        return {0.0, 0.0};
+    }
+    
+    // Configure kernel launch parameters
+    mc_call_kernel<<<grid_size, block_size>>>(
+        S, K, r, q, sigma, T, effective_nPaths, seed, d_partial_sums, d_partial_sum_squares);
+    
+    // Check for kernel launch errors
+    err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        // Cleanup and return error
+        cudaFree(d_partial_sums);
+        cudaFree(d_partial_sum_squares);
+        return {0.0, 0.0};
+    }
+    
+    // Wait for kernel to complete
+    cudaDeviceSynchronize();
+    
+    // Copy results back to host
+    double* h_partial_sums = new double[grid_size];
+    double* h_partial_sum_squares = new double[grid_size];
+    
+    cudaMemcpy(h_partial_sums, d_partial_sums, partial_sum_size, cudaMemcpyDeviceToHost);
+    cudaMemcpy(h_partial_sum_squares, d_partial_sum_squares, partial_sum_size, cudaMemcpyDeviceToHost);
+    
+    // Reduce partial sums on host
+    for (int i = 0; i < grid_size; i++) {
+        h_sum += h_partial_sums[i];
+        h_sum_squares += h_partial_sum_squares[i];
+    }
+    
+    // Cleanup
+    delete[] h_partial_sums;
+    delete[] h_partial_sum_squares;
+    
+    // Check for copy errors
+    err = cudaGetLastError();
+    if (err != cudaSuccess) {
+        cudaFree(d_partial_sums);
+        cudaFree(d_partial_sum_squares);
+        return {0.0, 0.0};
+    }
+    
+    // Calculate price and standard error
+    double price = h_sum / effective_nPaths * exp(-r * T);
+    double mean = price;
+    double variance = (h_sum_squares / effective_nPaths) - (mean * mean);
+    double std_error = sqrt(variance / effective_nPaths);
+    
+    // Cleanup
+    cudaFree(d_partial_sums);
+    cudaFree(d_partial_sum_squares);
+    
+    return {price, std_error};
+}
