+#include <iostream>
+#include <complex>
+#include <cmath>
+
+// Simple test of the characteristic function
+int main() {
+    // Test parameters
+    double v0 = 0.04;
+    double kappa = 1.0;
+    double theta = 0.04;
+    double xi = 0.5;
+    double rho = -0.5;
+    double T = 1.0;
+    double r = 0.05;
+    double q = 0.02;
+    
+    std::complex<double> i(0.0, 1.0);
+    
+    // Test characteristic function at u = 0
+    double u = 0.0;
+    std::complex<double> d = std::sqrt((rho * xi * u * i - kappa) * (rho * xi * u * i - kappa) + 
+                                       xi * xi * (u * u * i - u));
+    std::cout << "d = " << d << std::endl;
+    
+    std::complex<double> g = (kappa - rho * xi * u * i + d) / (kappa - rho * xi * u * i - d);
+    std::cout << "g = " << g << std::endl;
+    
+    std::complex<double> D = (kappa - rho * xi * u * i + d) / (xi * xi);
+    std::cout << "D = " << D << std::endl;
+    
+    std::complex<double> C = (r - q) * u * i * T + kappa * theta * T * (1.0 - std::exp(-d * T)) / 
+                            (d * (1.0 - g * std::exp(-d * T)));
+    std::cout << "C = " << C << std::endl;
+    
+    std::complex<double> phi = std::exp(C + D * v0);
+    std::cout << "phi(0) = " << phi << std::endl;
+    
+    return 0;
+}
