+            double d2 = d1 - sigma * std::sqrt(T);
+            double call_price = S * normcdf(d1) - K * std::exp(-r * T) * normcdf(d2);
+            return std::max(0.0, call_price);
+        }
+        
+        // Use the characteristic function approach with proper numerical handling
