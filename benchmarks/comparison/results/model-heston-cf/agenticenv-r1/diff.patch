+    // Heston characteristic function implementation (corrected)
+    std::complex<double> heston_char_function(double u, double T, const Heston& h, double r, double q) {
+        // Heston characteristic function for the log-spot process
+        // This is the correct implementation for the Heston model
+        double d = std::sqrt((h.kappa - h.rho * h.xi * u) * (h.kappa - h.rho * h.xi * u) - h.xi * h.xi);
+        
+        // Avoid division by zero
+        if (std::abs(d) < EPSILON) {
+            d = EPSILON;
+        }
+        
+        // Correct implementation of the characteristic function
+        double phi = h.kappa - h.rho * h.xi * u;
+        double numerator = std::exp((phi + d) * T / 2) - std::exp((phi - d) * T / 2);
+        double denominator = (phi + d) * std::exp((phi + d) * T / 2) - (phi - d) * std::exp((phi - d) * T / 2);
+        
+        // Handle small denominator
+        if (std::abs(denominator) < EPSILON) {
+            denominator = EPSILON;
+        }
+        
+        std::complex<double> exp_term = std::exp(h.v0 * (phi + d) * T / 2);
+        std::complex<double> char_func = exp_term * numerator / denominator;
+        
+        return char_func;
+    }
