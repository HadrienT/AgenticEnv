+    // Main implementation using the Lewis (2000) approach with proper numerical handling
+    double heston_call_impl(double S, double K, double r, double q, double T, const Heston& h) {
+        // Handle edge cases
+        if (T <= 0) {
+            return std::max(0.0, S - K);
