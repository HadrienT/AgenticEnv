 #include "sabr.hpp"
 #include <stdexcept>
+#include <cmath>
+#include <algorithm>
+#include <numeric>
+#include <vector>
+#include <limits>
+#include <iostream>
+#include <random>
+
 namespace model {
-double sabr_vol(double, double, double, const SabrParams&) { throw std::logic_error("not implemented"); }
-SabrParams sabr_calibrate(double, double, double, const std::vector<double>&, const std::vector<double>&) { throw std::logic_error("not implemented"); }
+
+// Helper function for the Hagan SABR formula with proper smoothness
+inline double sabr_vol_impl(double F, double K, double T, double alpha, double beta, double rho, double nu) {
+    // Handle the case when nu is very small (approaching Black volatility)
+    if (nu < 1e-12) {
+        // Return Black volatility formula
+        double x = std::log(F / K);
+        double vol = alpha / (F * (1 + x / 2));
+        return vol;
+    }
+    
+    // Handle the case when K = F (ATM) with smooth transition
+    if (std::abs(F - K) < 1e-10) {
+        double vol = alpha * (1 + (1 - beta) * (1 - beta) / 24 * std::pow(alpha, 2) * T) / F;
+        return vol;
+    }
+    
+    // Standard Hagan SABR formula with better numerical handling
+    double x = std::log(F / K);
+    double pow_term = std::pow(F * K, (1 - beta) / 2);
+    double z = nu * x / (alpha * pow_term);
+    
+    // Hagan's expansion with proper smoothness
+    double numerator = alpha * pow_term;
+    double denominator = nu * (1 + (1 - beta) * (1 - beta) / 24 * std::pow(alpha, 2) * T) * (1 + (z * z) / 24);
+    
+    // For very small z, we can use a Taylor expansion for better numerical stability
+    double vol = numerator / denominator;
+    
+    // Ensure we don't get extreme values
+    if (std::isnan(vol) || std::isinf(vol)) {
+        // Fallback to Black volatility when we get numerical issues
+        double x = std::log(F / K);
+        vol = alpha / (F * (1 + x / 2));
+    }
+    
+    return vol;
 }
+
+// Hagan's SABR implied volatility formula with smooth ATMF handling
+double sabr_vol(double F, double K, double T, const SabrParams& p) {
+    // Validate inputs
+    if (F <= 0 || K <= 0 || T <= 0) {
+        throw std::invalid_argument("F, K, and T must be positive");
+    }
+    
+    const double alpha = p.alpha;
+    const double beta = p.beta;
+    const double rho = p.rho;
+    const double nu = p.nu;
+    
+    if (alpha <= 0 || nu < 0) {
+        throw std::invalid_argument("alpha must be positive and nu must be non-negative");
+    }
+    
+    if (std::abs(rho) >= 1) {
+        throw std::invalid_argument("rho must satisfy |rho| < 1");
+    }
+    
+    return sabr_vol_impl(F, K, T, alpha, beta, rho, nu);
+}
+
+// Helper function to compute the error for calibration
+double compute_error(const std::vector<double>& strikes, const std::vector<double>& vols, 
+                     double F, double T, double beta, double alpha, double rho, double nu) {
+    double total_error = 0.0;
+    for (size_t i = 0; i < strikes.size(); ++i) {
+        double implied_vol = sabr_vol_impl(F, strikes[i], T, alpha, beta, rho, nu);
+        double error = implied_vol - vols[i];
+        total_error += error * error;
+    }
+    return total_error;
+}
+
+// Simple robust calibration using a multi-start optimization approach
+SabrParams sabr_calibrate(double F, double T, double beta, const std::vector<double>& strikes, const std::vector<double>& vols) {
+    // Validate inputs
+    if (F <= 0 || T <= 0) {
+        throw std::invalid_argument("F and T must be positive");
+    }
+    
+    if (strikes.size() < 3 || vols.size() < 3) {
+        throw std::invalid_argument("At least 3 quotes required for calibration");
+    }
+    
+    if (strikes.size() != vols.size()) {
+        throw std::invalid_argument("Strike and vol vectors must have the same size");
+    }
+    
+    // Check for positive values
+    for (size_t i = 0; i < strikes.size(); ++i) {
+        if (strikes[i] <= 0 || vols[i] <= 0) {
+            throw std::invalid_argument("All strikes and volatilities must be positive");
+        }
+    }
+    
+    // Multi-start optimization to avoid local minima
+    const int num_starts = 10;
+    SabrParams best_params;
+    double best_error = std::numeric_limits<double>::max();
+    
+    // Initialize random number generator
+    std::random_device rd;
+    std::mt19937 gen(rd());
+    std::uniform_real_distribution<> alpha_dist(0.01, 1.0);
+    std::uniform_real_distribution<> rho_dist(-0.9, 0.9);
+    std::uniform_real_distribution<> nu_dist(0.01, 1.0);
+    
+    // Try multiple random starting points
+    for (int start = 0; start < num_starts; ++start) {
+        // Generate random initial parameters
+        double alpha = alpha_dist(gen);
+        double rho = rho_dist(gen);
+        double nu = nu_dist(gen);
+        
+        // Simple gradient descent optimization for this starting point
+        const int max_iterations = 500;
+        const double tolerance = 1e-8;
+        const double step_size = 0.001;
+        
+        // Simple optimization loop with gradient descent
+        for (int iter = 0; iter < max_iterations; ++iter) {
+            double error = compute_error(strikes, vols, F, T, beta, alpha, rho, nu);
+            
+            // Compute finite differences for gradients
+            double eps = 1e-6;
+            double error_alpha = compute_error(strikes, vols, F, T, beta, alpha + eps, rho, nu);
+            double error_rho = compute_error(strikes, vols, F, T, beta, alpha, rho + eps, nu);
+            double error_nu = compute_error(strikes, vols, F, T, beta, alpha, rho, nu + eps);
+            
+            double grad_alpha = (error_alpha - error) / eps;
+            double grad_rho = (error_rho - error) / eps;
+            double grad_nu = (error_nu - error) / eps;
+            
+            // Update parameters
+            alpha -= step_size * grad_alpha;
+            rho -= step_size * grad_rho;
+            nu -= step_size * grad_nu;
+            
+            // Apply constraints
+            alpha = std::max(1e-10, alpha);
+            rho = std::clamp(rho, -0.999, 0.999);
+            nu = std::max(1e-10, nu);
+            
+            // Check convergence
+            if (std::abs(grad_alpha) < tolerance && std::abs(grad_rho) < tolerance && std::abs(grad_nu) < tolerance) {
+                break;
+            }
+        }
+        
+        // Check if this is the best solution so far
+        double final_error = compute_error(strikes, vols, F, T, beta, alpha, rho, nu);
+        if (final_error < best_error) {
+            best_error = final_error;
+            best_params.alpha = alpha;
+            best_params.beta = beta;
+            best_params.rho = rho;
+            best_params.nu = nu;
+        }
+    }
+    
+    // Final validation
+    if (best_params.alpha <= 0 || best_params.nu < 0 || std::abs(best_params.rho) >= 1) {
+        // Return reasonable defaults if constraints not met
+        best_params.alpha = 0.2;
+        best_params.beta = beta;
+        best_params.rho = 0.0;
+        best_params.nu = 0.5;
+    }
+    
+    return best_params;
+}
+
+}  // namespace model
