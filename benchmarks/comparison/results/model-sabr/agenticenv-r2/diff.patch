+#include "sabr.hpp"
+#include <iostream>
+#include <vector>
+#include <cmath>
+
+int main() {
+    using namespace model;
+    
+    std::cout << "=== SABR Model Comprehensive Test ===" << std::endl;
+    
+    // Test 1: Basic functionality
+    std::cout << "\nTest 1: Basic functionality" << std::endl;
+    SabrParams params{0.2, 0.5, 0.0, 0.3};
+    
+    double vol1 = sabr_vol(100.0, 100.0, 1.0, params);
+    std::cout << "ATM volatility: " << vol1 << std::endl;
+    
+    double vol2 = sabr_vol(100.0, 110.0, 1.0, params);
+    std::cout << "OTM volatility: " << vol2 << std::endl;
+    
+    double vol3 = sabr_vol(100.0, 90.0, 1.0, params);
+    std::cout << "ITM volatility: " << vol3 << std::endl;
+    
+    // Test 2: Smoothness at K=F
+    std::cout << "\nTest 2: Smoothness at K=F" << std::endl;
+    double vol_atm = sabr_vol(100.0, 100.0, 1.0, params);
+    double vol_near_atm = sabr_vol(100.0, 100.0001, 1.0, params);
+    std::cout << "ATM vol: " << vol_atm << std::endl;
+    std::cout << "Near ATM vol: " << vol_near_atm << std::endl;
+    std::cout << "Difference: " << std::abs(vol_atm - vol_near_atm) << std::endl;
+    
+    // Test 3: Behavior when nu approaches 0
+    std::cout << "\nTest 3: Behavior when nu approaches 0" << std::endl;
+    SabrParams params_small_nu{0.2, 0.5, 0.0, 1e-10};
+    double vol_small_nu = sabr_vol(100.0, 110.0, 1.0, params_small_nu);
+    std::cout << "Vol with very small nu: " << vol_small_nu << std::endl;
+    
+    // Test 4: Calibration with various data
+    std::cout << "\nTest 4: Calibration" << std::endl;
+    std::vector<double> strikes = {90.0, 100.0, 110.0, 120.0};
+    std::vector<double> vols = {0.18, 0.20, 0.22, 0.24};
+    
+    try {
+        SabrParams calibrated = sabr_calibrate(100.0, 1.0, 0.5, strikes, vols);
+        std::cout << "Calibrated alpha: " << calibrated.alpha << std::endl;
+        std::cout << "Calibrated beta: " << calibrated.beta << std::endl;
+        std::cout << "Calibrated rho: " << calibrated.rho << std::endl;
+        std::cout << "Calibrated nu: " << calibrated.nu << std::endl;
+        
+        // Test the calibrated parameters
+        double test_vol = sabr_vol(100.0, 110.0, 1.0, calibrated);
+        std::cout << "Test vol with calibrated params: " << test_vol << std::endl;
+    } catch (const std::exception& e) {
+        std::cout << "Error in calibration: " << e.what() << std::endl;
+        return 1;
+    }
+    
+    // Test 5: Error handling
+    std::cout << "\nTest 5: Error handling" << std::endl;
+    try {
+        sabr_vol(0.0, 100.0, 1.0, params);  // Invalid F
+        std::cout << "ERROR: Should have thrown exception for F=0" << std::endl;
+    } catch (const std::exception& e) {
+        std::cout << "Correctly caught exception for invalid F: " << e.what() << std::endl;
+    }
+    
+    try {
+        sabr_calibrate(100.0, 1.0, 0.5, {100.0}, {0.2});  // Not enough quotes
+        std::cout << "ERROR: Should have thrown exception for insufficient quotes" << std::endl;
+    } catch (const std::exception& e) {
+        std::cout << "Correctly caught exception for insufficient quotes: " << e.what() << std::endl;
+    }
+    
+    std::cout << "\n=== All tests completed successfully ===" << std::endl;
+    return 0;
+}
