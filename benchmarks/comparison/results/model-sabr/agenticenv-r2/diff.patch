@@ -0,0 +1,35 @@
+#include "sabr.hpp"
+#include <iostream>
+#include <vector>
+#include <cmath>
+
+int main() {
+    using namespace model;
+    
+    std::cout << "=== Testing Smoothness at K=F ===" << std::endl;
+    
+    // Test with parameters that should give smooth behavior
+    SabrParams params{0.2, 0.5, 0.0, 0.3};
+    
+    double F = 100.0;
+    double T = 1.0;
+    
+    // Test various K values near F
+    std::vector<double> test_Ks = {99.999, 99.9999, 100.0, 100.0001, 100.001};
+    
+    std::cout << "Testing smoothness around K=F=100.0" << std::endl;
+    std::cout << "K\t\tVolatility" << std::endl;
+    std::cout << "------------------------" << std::endl;
+    
+    for (double K : test_Ks) {
+        double vol = sabr_vol(F, K, T, params);
+        std::cout << K << "\t\t" << vol << std::endl;
+    }
+    
+    // Test the difference between ATM and very close to ATM
+    double vol_atm = sabr_vol(F, F, T, params);
+    double vol_near_atm = sabr_vol(F, F + 1e-8, T, params);
+    std::cout << "\nDifference between ATM and near-ATM: " << std::abs(vol_atm - vol_near_atm) << std::endl;
+    
+    return 0;
+}
