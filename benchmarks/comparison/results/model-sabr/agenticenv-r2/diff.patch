+#include "sabr.hpp"
+#include <iostream>
+#include <vector>
+
+int main() {
+    using namespace model;
+    
+    // Test basic functionality
+    SabrParams params{0.2, 0.5, 0.0, 0.3};  // alpha, beta, rho, nu
+    
+    // Test at-the-money case
+    double vol1 = sabr_vol(100.0, 100.0, 1.0, params);
+    std::cout << "ATM volatility: " << vol1 << std::endl;
+    
+    // Test out-of-the-money case
+    double vol2 = sabr_vol(100.0, 110.0, 1.0, params);
+    std::cout << "OTM volatility: " << vol2 << std::endl;
+    
+    // Test calibration
+    std::vector<double> strikes = {90.0, 100.0, 110.0};
+    std::vector<double> vols = {0.18, 0.20, 0.22};
+    
+    try {
+        SabrParams calibrated = sabr_calibrate(100.0, 1.0, 0.5, strikes, vols);
+        std::cout << "Calibrated alpha: " << calibrated.alpha << std::endl;
+        std::cout << "Calibrated beta: " << calibrated.beta << std::endl;
+        std::cout << "Calibrated rho: " << calibrated.rho << std::endl;
+        std::cout << "Calibrated nu: " << calibrated.nu << std::endl;
+    } catch (const std::exception& e) {
+        std::cout << "Error in calibration: " << e.what() << std::endl;
+        return 1;
+    }
+    
+    return 0;
+}
