+namespace {
+    // Helper function to compute the Hagan SABR implied volatility formula
+    // This implements the expansion from Hagan et al. (2002) equation (2.17a) with time correction
+    double sabr_vol_impl(double F, double K, double T, const SabrParams& p) {
+        double alpha = p.alpha;
+        double beta = p.beta;
+        double rho = p.rho;
+        double nu = p.nu;
+        
+        // Handle edge cases
+        if (F <= 0 || T <= 0 || alpha <= 0 || nu < 0) {
+            return 0.0;
+        }
+        
+        // Special case: when F = K (at-the-money)
+        if (std::abs(F - K) < 1e-12) {
+            // At-the-money formula (2.18)
+            double z = nu * alpha / (beta * F);
+            double A = 1.0 + (std::pow(z, 2) / 24.0 + std::pow(z, 4) / 1920.0) * std::pow(z, 2);
+            double B = 1.0 + (1.0 + 1.0/24.0 * std::pow(z, 2)) * std::pow(z, 2) / 24.0;
+            return alpha * A / B;
+        }
+        
+        // General case (2.17a)
+        double log_F_K = std::log(F / K);
+        double z = nu * alpha / (beta * F);
+        double A = 1.0 + (std::pow(log_F_K, 2) / 24.0 + std::pow(log_F_K, 4) / 1920.0) * std::pow(z, 2);
+        double B = 1.0 + (1.0 + 1.0/24.0 * std::pow(z, 2)) * std::pow(log_F_K, 2) / 24.0;
+        double vol = alpha * A / B;
+        return vol;
+    }
