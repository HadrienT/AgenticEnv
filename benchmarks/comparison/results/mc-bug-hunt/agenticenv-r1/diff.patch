@@ -0,0 +1,38 @@
+#include "include/engine.hpp"
+#include <iostream>
+#include <iomanip>
+
+int main() {
+    using namespace mc;
+    
+    // Test parameters
+    Market m{100.0, 0.05, 0.02, 0.2};  // S0, r, q, sigma
+    double K = 100.0;
+    double T = 1.0;
+    int n = 100;
+    std::int64_t paths = 1000000;
+    std::uint64_t seed = 42;
+    
+    std::cout << std::fixed << std::setprecision(6);
+    
+    // Test European call
+    auto result_european = european(m, K, T, true, paths, seed, true);
+    std::cout << "European Call (Antithetic): " << result_european.price << " ± " << result_european.std_error << std::endl;
+    
+    // Test Asian call
+    auto result_asian = asian(m, K, T, n, paths, seed);
+    std::cout << "Asian Call: " << result_asian.price << " ± " << result_asian.std_error << std::endl;
+    
+    // Test Down-out call
+    double B = 80.0;  // Barrier
+    int steps = 100;
+    auto result_down_out = down_out_call(m, K, B, T, steps, paths, seed);
+    std::cout << "Down-out Call: " << result_down_out.price << " ± " << result_down_out.std_error << std::endl;
+    
+    // Test Digital MT
+    int threads = 4;
+    auto result_digital = digital_mt(m, K, T, paths, seed, threads);
+    std::cout << "Digital MT: " << result_digital.price << " ± " << result_digital.std_error << std::endl;
+    
+    return 0;
+}
