diff --git a/test_engine.cpp b/test_engine.cpp
new file mode 100644
index 0000000..16f0ea2
--- /dev/null
+++ b/test_engine.cpp
@@ -0,0 +1,71 @@
+#include "engine.hpp"
+#include <iostream>
+#include <iomanip>
+#include <cmath>
+
+// Simple normal CDF approximation
+double norm_cdf(double x) {
+    const double a1 =  0.254829592;
+    const double a2 = -0.284496736;
+    const double a3 =  1.421413741;
+    const double a4 = -1.453152027;
+    const double a5 =  1.061405429;
+    const double p  =  0.3275911;
+    
+    int sign = 1;
+    if (x < 0)
+        sign = -1;
+    x = std::abs(x) / std::sqrt(2.0);
+    
+    double t = 1.0 / (1.0 + p * x);
+    double y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * std::exp(-x * x);
+    
+    return 0.5 * (1.0 + sign * y);
+}
+
+int main() {
+    using namespace mc;
+    
+    // Test parameters
+    Market m{100.0, 0.05, 0.02, 0.2};  // S0, r, q, sigma
+    double K = 100.0;
+    double T = 1.0;
+    
+    std::cout << std::fixed << std::setprecision(6);
+    
+    // Test European call with antithetic sampling
+    auto result = european(m, K, T, true, 1000000, 12345, true);
+    std::cout << "European call (antithetic): " << result.price << " ± " << result.std_error << std::endl;
+    
+    // Test European call without antithetic sampling
+    result = european(m, K, T, true, 1000000, 12345, false);
+    std::cout << "European call (standard): " << result.price << " ± " << result.std_error << std::endl;
+    
+    // Compare with closed-form Black-Scholes
+    // For a European call: C = S0 * N(d1) - K * exp(-rT) * N(d2)
+    double d1 = (std::log(m.S0 / K) + (m.r - m.q - 0.5 * m.sigma * m.sigma) * T) / (m.sigma * std::sqrt(T));
+    double d2 = d1 - m.sigma * std::sqrt(T);
+    double bs_call = m.S0 * norm_cdf(d1) - K * std::exp(-m.r * T) * norm_cdf(d2);
+    std::cout << "Black-Scholes call price: " << bs_call << std::endl;
+    
+    // Test with a simpler case that we know the answer to
+    std::cout << "\n--- Simple test case ---" << std::endl;
+    Market m2{100.0, 0.0, 0.0, 0.0};  // S0, r, q, sigma
+    double K2 = 100.0;
+    double T2 = 1.0;
+    
+    // For a call option with S0=K=100, r=q=0, sigma=0, the price should be 0
+    // But let's test with a non-zero sigma
+    Market m3{100.0, 0.0, 0.0, 0.2};  // S0, r, q, sigma
+    double K3 = 100.0;
+    double T3 = 1.0;
+    
+    auto result3 = european(m3, K3, T3, true, 1000000, 12345, true);
+    std::cout << "European call (simple case): " << result3.price << " ± " << result3.std_error << std::endl;
+    
+    // Test Asian option
+    auto asian_result = asian(m, 100.0, 1.0, 10, 1000000, 12345);
+    std::cout << "Asian call: " << asian_result.price << " ± " << asian_result.std_error << std::endl;
+    
+    return 0;
+}
