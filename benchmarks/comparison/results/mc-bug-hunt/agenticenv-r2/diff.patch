@@ -0,0 +1,27 @@
+#include "engine.hpp"
+#include <iostream>
+
+int main() {
+    using namespace mc;
+    
+    // Test all functions with basic parameters
+    Market m{100.0, 0.05, 0.02, 0.2};  // S0, r, q, sigma
+    
+    // Test European call
+    auto result1 = european(m, 100.0, 1.0, true, 100000, 12345, true);
+    std::cout << "European call: " << result1.price << " ± " << result1.std_error << std::endl;
+    
+    // Test Asian call
+    auto result2 = asian(m, 100.0, 1.0, 10, 100000, 12345);
+    std::cout << "Asian call: " << result2.price << " ± " << result2.std_error << std::endl;
+    
+    // Test Down-and-out call
+    auto result3 = down_out_call(m, 100.0, 90.0, 1.0, 100, 100000, 12345);
+    std::cout << "Down-out call: " << result3.price << " ± " << result3.std_error << std::endl;
+    
+    // Test Digital MT
+    auto result4 = digital_mt(m, 100.0, 1.0, 100000, 12345, 4);
+    std::cout << "Digital MT: " << result4.price << " ± " << result4.std_error << std::endl;
+    
+    return 0;
+}
