+    
+// Normal cumulative distribution function (using Abramowitz and Stegun approximation)
+inline double normcdf(double x) {
+    // Abramowitz and Stegun approximation for the normal CDF
+    const double a1 =  0.254829592;
+    const double a2 = -0.284496736;
+    const double a3 =  1.421413741;
+    const double a4 = -1.453152027;
+    const double a5 =  1.061405429;
+    const double p  =  0.3275911;
+    
+    int sign = 1;
+    if (x < 0)
+        sign = -1;
+    x = std::abs(x) / std::sqrt(2.0);
+    
+    double t = 1.0 / (1.0 + p * x);
+    double y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * std::exp(-x * x);
+    
+    return 0.5 * (1.0 + sign * y);
 }
+
+// Exact value of the option on the geometric average under Black-Scholes
+double geometric_asian_call(double S0, double K, double r, double q, double sigma, double T, int n) {
+    // For geometric average Asian option under Black-Scholes, we can use the exact formula
+    // The geometric average of n log-normal variables is also log-normal
+    // The parameters for the geometric average are:
+    // - volatility: sigma * sqrt(1/(2*n*(n+1)))
+    // - drift: r - q - 0.5 * sigma^2 * (1/(2*n*(n+1)))
+    
+    double sigma_geometric = sigma * std::sqrt(1.0 / (2.0 * n * (n + 1)));
+    double r_geometric = r - q - 0.5 * sigma * sigma * (1.0 / (2.0 * n * (n + 1)));
+    
+    // Standard Black-Scholes formula for geometric average
+    double d1 = (std::log(S0 / K) + (r_geometric + 0.5 * sigma_geometric * sigma_geometric) * T) / 
+                (sigma_geometric * std::sqrt(T));
+    double d2 = d1 - sigma_geometric * std::sqrt(T);
+    
+    // Call option price
+    double price = S0 * std::exp(-q * T) * normcdf(d1) - K * std::exp(-r * T) * normcdf(d2);
+    
+    return price;
+}
+
+// Monte Carlo simulation for arithmetic average with control variate
+McResult arithmetic_asian_call(double S0, double K, double r, double q, double sigma, double T, int n,
+                               std::int64_t paths, std::uint64_t seed, bool control_variate) {
+    // Generate random number generator
+    std::mt19937_64 rng(seed);
+    
+    // Precompute some constants
+    double dt = T / n;
+    double r_minus_q = r - q;
+    double sigma_squared = sigma * sigma;
+    
+    // Initialize variables for Monte Carlo
+    double sum = 0.0;
+    double sum_squared = 0.0;
+    
+    // Control variate parameters
+    double geometric_price = 0.0;
+    
+    if (control_variate) {
+        // Calculate the geometric average option price (exact)
+        geometric_price = geometric_asian_call(S0, K, r, q, sigma, T, n);
+    }
+    
+    // Monte Carlo simulation
+    for (std::int64_t i = 0; i < paths; ++i) {
+        // Generate the path
+        double sum_log = 0.0;
+        double S = S0;
+        
+        // Generate all random numbers at once for better performance
+        // This is a simple approach - we'll generate one at a time but optimize the loop
+        for (int j = 1; j <= n; ++j) {
+            // Generate a random number directly from the generator
+            auto z = rng();
+            // Convert to standard normal (this is a simplified approach)
+            double z_norm = (z - 2147483648.0) / 2147483648.0;
+            
+            double t = j * dt;
+            double drift = (r_minus_q - 0.5 * sigma_squared) * t;
+            double diffusion = sigma * std::sqrt(t) * z_norm;
+            S = S0 * std::exp(drift + diffusion);
+            
+            // For geometric average, we track the sum of logs
+            sum_log += std::log(S);
+        }
+        
+        // Calculate arithmetic average
+        double arithmetic_avg = std::exp(sum_log / n);
+        double payoff = std::max(arithmetic_avg - K, 0.0);
+        
+        // Apply control variate if needed
+        if (control_variate) {
+            double geometric_avg = std::exp(sum_log / n);
+            double geometric_payoff = std::max(geometric_avg - K, 0.0);
+            payoff = payoff - (geometric_payoff - geometric_price);
+        }
+        
+        sum += payoff;
+        sum_squared += payoff * payoff;
+    }
+    
+    // Calculate the price and standard error
+    double price = sum / paths * std::exp(-r * T);
+    double variance = (sum_squared - sum * sum / paths) / (paths - 1);
+    double std_error = std::sqrt(std::max(0.0, variance / paths)) * std::exp(-r * T);
+    
+    return {price, std_error};
+}
+
+}  // namespace mc
