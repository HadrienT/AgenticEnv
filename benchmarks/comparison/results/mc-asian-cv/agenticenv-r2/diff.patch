+#include "include/asian.hpp"
+#include <iostream>
+#include <chrono>
+
+int main() {
+    // Test parameters for performance
+    double S0 = 100.0;
+    double K = 100.0;
+    double r = 0.05;
+    double q = 0.02;
+    double sigma = 0.2;
+    double T = 1.0;
+    int n = 12;
+    std::int64_t paths = 1000000;  // 1 million paths
+    std::uint64_t seed = 42;
+    
+    // Test performance of arithmetic_asian_call with 1 million paths
+    auto start = std::chrono::high_resolution_clock::now();
+    
+    mc::McResult result = mc::arithmetic_asian_call(S0, K, r, q, sigma, T, n, paths, seed, false);
+    
+    auto end = std::chrono::high_resolution_clock::now();
+    auto duration = std::chrono::duration_cast<std::chrono::milliseconds>(end - start);
+    
+    std::cout << "Performance Test Results:\n";
+    std::cout << "========================\n";
+    std::cout << "Paths: " << paths << "\n";
+    std::cout << "Time taken: " << duration.count() << " ms\n";
+    std::cout << "Price: " << result.price << "\n";
+    std::cout << "Standard Error: " << result.std_error << "\n";
+    
+    // Check if it's under a second (as required)
+    if (duration.count() < 1000) {
+        std::cout << "✓ Performance requirement met (under 1 second)\n";
+    } else {
+        std::cout << "✗ Performance requirement not met (over 1 second)\n";
+    }
+    
+    return 0;
+}
