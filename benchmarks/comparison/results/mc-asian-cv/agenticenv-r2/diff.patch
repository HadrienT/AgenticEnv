+#include "include/asian.hpp"
+#include <iostream>
+#include <iomanip>
+
+int main() {
+    // Test parameters
+    double S0 = 100.0;
+    double K = 100.0;
+    double r = 0.05;
+    double q = 0.02;
+    double sigma = 0.2;
+    double T = 1.0;
+    int n = 12;
+    std::int64_t paths = 1000000;
+    std::uint64_t seed = 42;
+    
+    std::cout << std::fixed << std::setprecision(6);
+    std::cout << "Testing Asian Option Implementation\n";
+    std::cout << "==================================\n";
+    
+    // Test geometric average
+    double geometric_price = mc::geometric_asian_call(S0, K, r, q, sigma, T, n);
+    std::cout << "Geometric Asian Call Price: " << geometric_price << std::endl;
+    
+    // Test arithmetic average with control variate
+    mc::McResult result_cv = mc::arithmetic_asian_call(S0, K, r, q, sigma, T, n, paths, seed, true);
+    std::cout << "Arithmetic Asian Call Price (with control variate): " << result_cv.price << std::endl;
+    std::cout << "Standard Error (with control variate): " << result_cv.std_error << std::endl;
+    
+    // Test arithmetic average without control variate
+    mc::McResult result_no_cv = mc::arithmetic_asian_call(S0, K, r, q, sigma, T, n, paths, seed, false);
+    std::cout << "Arithmetic Asian Call Price (without control variate): " << result_no_cv.price << std::endl;
+    std::cout << "Standard Error (without control variate): " << result_no_cv.std_error << std::endl;
+    
+    return 0;
+}
