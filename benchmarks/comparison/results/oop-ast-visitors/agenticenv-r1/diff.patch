+class FoldVisitor {
+public:
+    Ptr result;
+    
+    void visit(const NumNode& node) {
+        result = std::make_unique<NumNode>(node.value);
+    }
+    
+    void visit(const VarNode& node) {
+        result = std::make_unique<VarNode>(node.name);
+    }
+    
+    void visit(const AddNode& node) {
+        FoldVisitor left_visitor;
+        node.left->accept(left_visitor);
+        FoldVisitor right_visitor;
+        node.right->accept(right_visitor);
+        
+        // Try to fold constants
+        if (is_num(*left_visitor.result) && is_num(*right_visitor.result)) {
+            double left_val = get_num_value(*left_visitor.result);
+            double right_val = get_num_value(*right_visitor.result);
+            result = std::make_unique<NumNode>(left_val + right_val);
+        } else {
+            result = std::make_unique<AddNode>(std::move(left_visitor.result), std::move(right_visitor.result));
+        }
+    }
+    
+    void visit(const SubNode& node) {
+        FoldVisitor left_visitor;
+        node.left->accept(left_visitor);
+        FoldVisitor right_visitor;
+        node.right->accept(right_visitor);
+        
+        // Try to fold constants
+        if (is_num(*left_visitor.result) && is_num(*right_visitor.result)) {
+            double left_val = get_num_value(*left_visitor.result);
+            double right_val = get_num_value(*right_visitor.result);
+            result = std::make_unique<NumNode>(left_val - right_val);
+        } else {
+            result = std::make_unique<SubNode>(std::move(left_visitor.result), std::move(right_visitor.result));
+        }
+    }
+    
+    void visit(const MulNode& node) {
+        FoldVisitor left_visitor;
+        node.left->accept(left_visitor);
+        FoldVisitor right_visitor;
+        node.right->accept(right_visitor);
+        
+        // Try to fold constants
+        if (is_num(*left_visitor.result) && is_num(*right_visitor.result)) {
+            double left_val = get_num_value(*left_visitor.result);
+            double right_val = get_num_value(*right_visitor.result);
+            result = std::make_unique<NumNode>(left_val * right_val);
+        } else {
+            result = std::make_unique<MulNode>(std::move(left_visitor.result), std::move(right_visitor.result));
+        }
+    }
+    
+    void visit(const NegNode& node) {
+        FoldVisitor operand_visitor;
+        node.operand->accept(operand_visitor);
+        
+        // Try to fold constants
+        if (is_num(*operand_visitor.result)) {
+            double val = get_num_value(*operand_visitor.result);
+            result = std::make_unique<NumNode>(-val);
+        } else {
+            result = std::make_unique<NegNode>(std::move(operand_visitor.result));
+        }
+    }
+    
+    void visit(const PowNode& node) {
+        FoldVisitor base_visitor;
+        node.base->accept(base_visitor);
+        
+        // Try to fold constants
+        if (is_num(*base_visitor.result) && node.exponent == 0) {
+            result = std::make_unique<NumNode>(1.0);
+        } else if (is_num(*base_visitor.result) && node.exponent == 1) {
+            double val = get_num_value(*base_visitor.result);
+            result = std::make_unique<NumNode>(val);
+        } else {
+            result = std::make_unique<PowNode>(std::move(base_visitor.result), node.exponent);
+        }
+    }
+    
+    void visit(const ExpNode& node) {
+        FoldVisitor operand_visitor;
+        node.operand->accept(operand_visitor);
+        result = std::make_unique<ExpNode>(std::move(operand_visitor.result));
+    }
+    
+    void visit(const LogNode& node) {
+        FoldVisitor operand_visitor;
+        node.operand->accept(operand_visitor);
+        result = std::make_unique<LogNode>(std::move(operand_visitor.result));
+    }
+};
