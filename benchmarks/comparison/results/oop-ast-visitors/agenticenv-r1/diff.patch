+// Visitor implementations
+class EvalVisitor {
+public:
+    const Env& env;
+    double result;
+    
+    EvalVisitor(const Env& e) : env(e), result(0) {}
+    
+    void visit(const NumNode& node) {
+        result = node.value;
+    }
+    
+    void visit(const VarNode& node) {
+        auto it = env.find(node.name);
+        if (it == env.end()) {
+            throw std::out_of_range("Unknown variable: " + node.name);
+        }
+        result = it->second;
+    }
+    
+    void visit(const AddNode& node) {
+        EvalVisitor left_visitor(env);
+        node.left->accept(left_visitor);
+        EvalVisitor right_visitor(env);
+        node.right->accept(right_visitor);
+        result = left_visitor.result + right_visitor.result;
+    }
+    
+    void visit(const SubNode& node) {
+        EvalVisitor left_visitor(env);
+        node.left->accept(left_visitor);
+        EvalVisitor right_visitor(env);
+        node.right->accept(right_visitor);
+        result = left_visitor.result - right_visitor.result;
+    }
+    
+    void visit(const MulNode& node) {
+        EvalVisitor left_visitor(env);
+        node.left->accept(left_visitor);
+        EvalVisitor right_visitor(env);
+        node.right->accept(right_visitor);
+        result = left_visitor.result * right_visitor.result;
+    }
+    
+    void visit(const NegNode& node) {
+        EvalVisitor operand_visitor(env);
+        node.operand->accept(operand_visitor);
+        result = -operand_visitor.result;
+    }
+    
+    void visit(const PowNode& node) {
+        EvalVisitor base_visitor(env);
+        node.base->accept(base_visitor);
+        result = std::pow(base_visitor.result, node.exponent);
+    }
+    
+    void visit(const ExpNode& node) {
+        EvalVisitor operand_visitor(env);
+        node.operand->accept(operand_visitor);
+        result = std::exp(operand_visitor.result);
+    }
+    
+    void visit(const LogNode& node) {
+        EvalVisitor operand_visitor(env);
+        node.operand->accept(operand_visitor);
+        result = std::log(operand_visitor.result);
+    }
+};
