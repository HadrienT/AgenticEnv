+class CloneVisitor {
+public:
+    Ptr result;
+    
+    void visit(const NumNode& node) {
+        result = std::make_unique<NumNode>(node.value);
+    }
+    
+    void visit(const VarNode& node) {
+        result = std::make_unique<VarNode>(node.name);
+    }
+    
+    void visit(const AddNode& node) {
+        CloneVisitor left_visitor;
+        node.left->accept(left_visitor);
+        CloneVisitor right_visitor;
+        node.right->accept(right_visitor);
+        result = std::make_unique<AddNode>(std::move(left_visitor.result), std::move(right_visitor.result));
+    }
+    
+    void visit(const SubNode& node) {
+        CloneVisitor left_visitor;
+        node.left->accept(left_visitor);
+        CloneVisitor right_visitor;
+        node.right->accept(right_visitor);
