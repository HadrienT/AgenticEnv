+class DiffVisitor {
+public:
+    std::string var_name;
+    Ptr result;
+    
+    DiffVisitor(const std::string& var) : var_name(var) {}
+    
+    void visit(const NumNode& node) {
+        result = std::make_unique<NumNode>(0.0);
+    }
+    
+    void visit(const VarNode& node) {
+        if (node.name == var_name) {
+            result = std::make_unique<NumNode>(1.0);
+        } else {
+            result = std::make_unique<NumNode>(0.0);
+        }
+    }
+    
+    void visit(const AddNode& node) {
+        DiffVisitor left_visitor(var_name);
+        node.left->accept(left_visitor);
+        DiffVisitor right_visitor(var_name);
+        node.right->accept(right_visitor);
+        result = std::make_unique<AddNode>(std::move(left_visitor.result), std::move(right_visitor.result));
+    }
+    
+    void visit(const SubNode& node) {
+        DiffVisitor left_visitor(var_name);
+        node.left->accept(left_visitor);
+        DiffVisitor right_visitor(var_name);
+        node.right->accept(right_visitor);
+        result = std::make_unique<SubNode>(std::move(left_visitor.result), std::move(right_visitor.result));
+    }
+    
+    void visit(const MulNode& node) {
+        // Product rule: (f * g)' = f' * g + f * g'
+        DiffVisitor left_visitor(var_name);
+        node.left->accept(left_visitor);
+        DiffVisitor right_visitor(var_name);
+        node.right->accept(right_visitor);
+        
+        Ptr left_term = std::make_unique<MulNode>(std::move(left_visitor.result), node.right->clone());
+        Ptr right_term = std::make_unique<MulNode>(node.left->clone(), std::move(right_visitor.result));
+        result = std::make_unique<AddNode>(std::move(left_term), std::move(right_term));
+    }
+    
+    void visit(const NegNode& node) {
+        DiffVisitor operand_visitor(var_name);
+        node.operand->accept(operand_visitor);
+        result = std::make_unique<NegNode>(std::move(operand_visitor.result));
+    }
+    
+    void visit(const PowNode& node) {
+        // Power rule: (f^n)' = n * f^(n-1) * f'
+        if (node.exponent == 0) {
+            result = std::make_unique<NumNode>(0.0);
+        } else {
+            DiffVisitor base_visitor(var_name);
+            node.base->accept(base_visitor);
+            Ptr base_term = std::make_unique<PowNode>(node.base->clone(), node.exponent - 1);
+            Ptr diff_term = std::make_unique<MulNode>(std::make_unique<NumNode>(node.exponent), std::move(base_term));
+            result = std::make_unique<MulNode>(std::move(diff_term), std::move(base_visitor.result));
+        }
+    }
+    
+    void visit(const ExpNode& node) {
+        // Derivative of exp(f) is exp(f) * f'
+        DiffVisitor operand_visitor(var_name);
+        node.operand->accept(operand_visitor);
+        Ptr exp_term = std::make_unique<ExpNode>(node.operand->clone());
+        result = std::make_unique<MulNode>(std::move(exp_term), std::move(operand_visitor.result));
+    }
+    
+    void visit(const LogNode& node) {
+        // Derivative of log(f) is (1/f) * f'
+        DiffVisitor operand_visitor(var_name);
+        node.operand->accept(operand_visitor);
+        Ptr inv_term = std::make_unique<MulNode>(std::make_unique<NumNode>(1.0), node.operand->clone());
+        result = std::make_unique<MulNode>(std::move(inv_term), std::move(operand_visitor.result));
+    }
+};
