+// Factory functions
+Ptr num(double v) {
+    return std::make_unique<NumNode>(v);
+}
+
+Ptr var(std::string name) {
+    return std::make_unique<VarNode>(std::move(name));
+}
+
+Ptr add(Ptr a, Ptr b) {
+    return std::make_unique<AddNode>(std::move(a), std::move(b));
+}
+
+Ptr sub(Ptr a, Ptr b) {
+    return std::make_unique<SubNode>(std::move(a), std::move(b));
+}
+
+Ptr mul(Ptr a, Ptr b) {
+    return std::make_unique<MulNode>(std::move(a), std::move(b));
+}
+
+Ptr neg(Ptr a) {
+    return std::make_unique<NegNode>(std::move(a));
+}
+
+Ptr pow_(Ptr base, double exponent) {
+    return std::make_unique<PowNode>(std::move(base), exponent);
+}
+
+Ptr exp_(Ptr a) {
+    return std::make_unique<ExpNode>(std::move(a));
+}
+
+Ptr log_(Ptr a) {
+    return std::make_unique<LogNode>(std::move(a));
+}
+
+// Free functions
+double eval(const Node& n, const Env& env) {
+    EvalVisitor visitor(env);
+    n.accept(visitor);
+    return visitor.result;
+}
+
+std::string print(const Node& n) {
+    PrintVisitor visitor;
+    n.accept(visitor);
+    return visitor.result;
+}
+
+std::set<std::string> vars(const Node& n) {
+    VarsVisitor visitor;
+    n.accept(visitor);
+    return visitor.result;
+}
+
+// Clone visitor implementation
+Ptr NumNode::clone() const {
+    return std::make_unique<NumNode>(value);
+}
+
+Ptr VarNode::clone() const {
+    return std::make_unique<VarNode>(name);
+}
+
+Ptr AddNode::clone() const {
+    return std::make_unique<AddNode>(left->clone(), right->clone());
+}
+
+Ptr SubNode::clone() const {
+    return std::make_unique<SubNode>(left->clone(), right->clone());
+}
+
+Ptr MulNode::clone() const {
+    return std::make_unique<MulNode>(left->clone(), right->clone());
+}
+
+Ptr NegNode::clone() const {
+    return std::make_unique<NegNode>(operand->clone());
+}
+
+Ptr PowNode::clone() const {
+    return std::make_unique<PowNode>(base->clone(), exponent);
+}
+
+Ptr ExpNode::clone() const {
+    return std::make_unique<ExpNode>(operand->clone());
+}
+
+Ptr LogNode::clone() const {
+    return std::make_unique<LogNode>(operand->clone());
+}
+
+Ptr clone(const Node& n) {
+    CloneVisitor visitor;
+    n.accept(visitor);
+    return std::move(visitor.result);
+}
+
+Ptr fold(const Node& n) {
+    FoldVisitor visitor;
+    n.accept(visitor);
+    return std::move(visitor.result);
+}
+
+Ptr diff(const Node& n, const std::string& x) {
+    DiffVisitor visitor(x);
+    n.accept(visitor);
+    return std::move(visitor.result);
+}
