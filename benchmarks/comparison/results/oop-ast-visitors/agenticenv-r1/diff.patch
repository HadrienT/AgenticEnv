+class PrintVisitor {
+public:
+    std::string result;
+    int precedence;
+    
+    PrintVisitor() : result(""), precedence(0) {}
+    
+    void visit(const NumNode& node) {
+        std::ostringstream oss;
+        oss.precision(17);
+        oss << node.value;
+        result = oss.str();
+    }
+    
+    void visit(const VarNode& node) {
+        result = node.name;
+    }
+    
+    void visit(const AddNode& node) {
+        PrintVisitor left_visitor;
+        node.left->accept(left_visitor);
+        PrintVisitor right_visitor;
+        node.right->accept(right_visitor);
+        
+        bool need_parens_left = (left_visitor.precedence < 1);
+        bool need_parens_right = (right_visitor.precedence <= 1);
+        
+        if (need_parens_left) {
+            result = "(" + left_visitor.result + ") + " + right_visitor.result;
+        } else if (need_parens_right) {
+            result = left_visitor.result + " + (" + right_visitor.result + ")";
+        } else {
+            result = left_visitor.result + " + " + right_visitor.result;
+        }
+        precedence = 1;
+    }
+    
+    void visit(const SubNode& node) {
+        PrintVisitor left_visitor;
+        node.left->accept(left_visitor);
+        PrintVisitor right_visitor;
+        node.right->accept(right_visitor);
+        
+        bool need_parens_left = (left_visitor.precedence < 1);
+        bool need_parens_right = (right_visitor.precedence <= 1);
+        
+        if (need_parens_left) {
+            result = "(" + left_visitor.result + ") - " + right_visitor.result;
+        } else if (need_parens_right) {
+            result = left_visitor.result + " - (" + right_visitor.result + ")";
+        } else {
+            result = left_visitor.result + " - " + right_visitor.result;
+        }
+        precedence = 1;
+    }
+    
+    void visit(const MulNode& node) {
+        PrintVisitor left_visitor;
+        node.left->accept(left_visitor);
+        PrintVisitor right_visitor;
+        node.right->accept(right_visitor);
+        
+        bool need_parens_left = (left_visitor.precedence < 2);
+        bool need_parens_right = (right_visitor.precedence <= 2);
+        
+        if (need_parens_left) {
+            result = "(" + left_visitor.result + ") * " + right_visitor.result;
+        } else if (need_parens_right) {
+            result = left_visitor.result + " * (" + right_visitor.result + ")";
+        } else {
+            result = left_visitor.result + " * " + right_visitor.result;
+        }
+        precedence = 2;
+    }
+    
+    void visit(const NegNode& node) {
+        PrintVisitor operand_visitor;
+        node.operand->accept(operand_visitor);
+        
+        // For unary minus, we need parentheses if the operand has lower precedence
+        bool need_parens = (operand_visitor.precedence < 3);
+        
+        if (need_parens) {
+            result = "-(" + operand_visitor.result + ")";
+        } else {
+            result = "-" + operand_visitor.result;
+        }
+        precedence = 3;
+    }
+    
+    void visit(const PowNode& node) {
+        PrintVisitor base_visitor;
+        node.base->accept(base_visitor);
+        
+        // For power, we need parentheses if the base has lower precedence
+        bool need_parens = (base_visitor.precedence < 4);
+        
+        if (need_parens) {
+            result = "(" + base_visitor.result + ")^" + std::to_string(node.exponent);
+        } else {
+            result = base_visitor.result + "^" + std::to_string(node.exponent);
+        }
+        precedence = 4;
+    }
+    
+    void visit(const ExpNode& node) {
+        PrintVisitor operand_visitor;
+        node.operand->accept(operand_visitor);
+        result = "exp(" + operand_visitor.result + ")";
+        precedence = 0;
+    }
+    
+    void visit(const LogNode& node) {
+        PrintVisitor operand_visitor;
+        node.operand->accept(operand_visitor);
+        result = "log(" + operand_visitor.result + ")";
+        precedence = 0;
+    }
+};
