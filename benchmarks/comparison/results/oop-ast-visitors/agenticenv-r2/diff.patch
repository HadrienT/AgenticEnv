+    
+    if (need_parens_left) {
+        left_str = "(" + left_str + ")";
+    }
+    
+    if (need_parens_right) {
+        right_str = "(" + right_str + ")";
+    }
+    
+    result = left_str + " * " + right_str;
+}
+
+void PrintVisitor::visit(const NegNode& node) {
+    // Unary minus precedence is 3
+    bool need_parens = (node.operand->precedence() < 3);
+    
+    // Create a temporary visitor to get operand string
+    PrintVisitor operand_visitor;
+    node.operand->accept(operand_visitor);
+    std::string operand_str = operand_visitor.get_result();
+    
+    if (need_parens) {
+        result = "-(" + operand_str + ")";
+    } else {
+        result = "-" + operand_str;
+    }
+}
+
+void PrintVisitor::visit(const PowNode& node) {
