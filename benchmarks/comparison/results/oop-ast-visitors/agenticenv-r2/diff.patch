+
+void FoldVisitor::visit(const AddNode& node) {
+    node.left->accept(*this);
+    Ptr left_folded = std::move(result);
+    node.right->accept(*this);
+    Ptr right_folded = std::move(result);
+    
+    // Try to fold constants
+    auto* left_num = dynamic_cast<NumNode*>(left_folded.get());
+    auto* right_num = dynamic_cast<NumNode*>(right_folded.get());
+    
+    if (left_num && right_num) {
+        result = std::make_unique<NumNode>(left_num->value + right_num->value);
+        return;
+    }
+    // Simplify x + 0 -> x
+    if (right_num && right_num->value == 0.0) {
+        result = std::move(left_folded);
+        return;
+    }
+    // Simplify 0 + x -> x
+    if (left_num && left_num->value == 0.0) {
+        result = std::move(right_folded);
+        return;
+    }
+    
+    // Check if right operand is a constant 0
+    if (right_num && right_num->value == 0.0) {
+        result = std::move(left_folded);
+        return;
+    }
+    
+    // Check if left operand is a constant 0
+    if (left_num && left_num->value == 0.0) {
+        result = std::move(right_folded);
+        return;
+    }
+    
+    result = std::make_unique<AddNode>(std::move(left_folded), std::move(right_folded));
+}
+
+void FoldVisitor::visit(const SubNode& node) {
+    node.left->accept(*this);
+    Ptr left_folded = std::move(result);
+    node.right->accept(*this);
+    Ptr right_folded = std::move(result);
+    
+    // Try to fold constants
+    auto* left_num = dynamic_cast<NumNode*>(left_folded.get());
+    auto* right_num = dynamic_cast<NumNode*>(right_folded.get());
+    
+    if (left_num && right_num) {
+        result = std::make_unique<NumNode>(left_num->value - right_num->value);
+        return;
+    }
+    // Simplify x - 0 -> x
+    if (right_num && right_num->value == 0.0) {
+        result = std::move(left_folded);
+        return;
+    }
+    // Simplify 0 - x -> -x
+    if (left_num && left_num->value == 0.0) {
+        result = std::make_unique<NegNode>(std::move(right_folded));
+        return;
+    }
+    
+    // Check if right operand is a constant 0
+    if (right_num && right_num->value == 0.0) {
+        result = std::move(left_folded);
+        return;
+    }
+    
+    // Check if left operand is a constant 0
+    if (left_num && left_num->value == 0.0) {
+        result = std::make_unique<NegNode>(std::move(right_folded));
+        return;
+    }
+    
+    result = std::make_unique<SubNode>(std::move(left_folded), std::move(right_folded));
+}
+
+void FoldVisitor::visit(const MulNode& node) {
+    node.left->accept(*this);
+    Ptr left_folded = std::move(result);
+    node.right->accept(*this);
+    Ptr right_folded = std::move(result);
+    
+    // Try to fold constants
+    if (auto* left_num = dynamic_cast<NumNode*>(left_folded.get())) {
+        if (auto* right_num = dynamic_cast<NumNode*>(right_folded.get())) {
+            result = std::make_unique<NumNode>(left_num->value * right_num->value);
+            return;
+        }
+        // Simplify x * 1 -> x
+        if (right_num && right_num->value == 1.0) {
+            result = std::move(left_folded);
+            return;
+        }
+        // Simplify 1 * x -> x
+        if (left_num && left_num->value == 1.0) {
+            result = std::move(right_folded);
+            return;
+        }
+        // Simplify x * 0 -> 0
+        if (right_num && right_num->value == 0.0) {
+            result = std::make_unique<NumNode>(0.0);
+            return;
+        }
+        // Simplify 0 * x -> 0
+        if (left_num && left_num->value == 0.0) {
+            result = std::make_unique<NumNode>(0.0);
+            return;
+        }
+    }
+    
+    // Check if right operand is a constant 1
+    if (auto* right_num = dynamic_cast<NumNode*>(right_folded.get())) {
+        if (right_num->value == 1.0) {
+            result = std::move(left_folded);
+            return;
+        }
+    }
+    
+    // Check if left operand is a constant 1
+    if (auto* left_num = dynamic_cast<NumNode*>(left_folded.get())) {
+        if (left_num->value == 1.0) {
+            result = std::move(right_folded);
+            return;
+        }
+    }
+    
+    // Check if right operand is a constant 0
+    if (auto* right_num = dynamic_cast<NumNode*>(right_folded.get())) {
+        if (right_num->value == 0.0) {
+            result = std::make_unique<NumNode>(0.0);
+            return;
+        }
+    }
+    
+    // Check if left operand is a constant 0
+    if (auto* left_num = dynamic_cast<NumNode*>(left_folded.get())) {
+        if (left_num->value == 0.0) {
+            result = std::make_unique<NumNode>(0.0);
+            return;
+        }
+    }
+    
+    result = std::make_unique<MulNode>(std::move(left_folded), std::move(right_folded));
+}
+
+void FoldVisitor::visit(const NegNode& node) {
+    node.operand->accept(*this);
+    Ptr operand_folded = std::move(result);
+    
+    // Try to fold constants
+    if (auto* num_node = dynamic_cast<NumNode*>(operand_folded.get())) {
+        result = std::make_unique<NumNode>(-num_node->value);
+        return;
+    }
+    
+    // Simplify -(-x) -> x
+    if (auto* neg_node = dynamic_cast<NegNode*>(operand_folded.get())) {
+        result = std::move(neg_node->operand);
+        return;
+    }
+    
+    result = std::make_unique<NegNode>(std::move(operand_folded));
+}
+
+void FoldVisitor::visit(const PowNode& node) {
+    node.base->accept(*this);
+    Ptr base_folded = std::move(result);
+    
+    // Try to fold constants
+    if (auto* base_num = dynamic_cast<NumNode*>(base_folded.get())) {
+        result = std::make_unique<NumNode>(std::pow(base_num->value, node.exponent));
+        return;
+    }
+    
+    // Simplify x^1 -> x
+    if (node.exponent == 1.0) {
+        result = std::move(base_folded);
+        return;
+    }
+    
+    // Simplify x^0 -> 1
+    if (node.exponent == 0.0) {
+        result = std::make_unique<NumNode>(1.0);
+        return;
+    }
+    
+    result = std::make_unique<PowNode>(std::move(base_folded), node.exponent);
+}
+
+void FoldVisitor::visit(const ExpNode& node) {
+    node.operand->accept(*this);
+    Ptr operand_folded = std::move(result);
+    
+    // Try to fold constants
+    if (auto* num_node = dynamic_cast<NumNode*>(operand_folded.get())) {
+        result = std::make_unique<NumNode>(std::exp(num_node->value));
+        return;
+    }
+    
+    result = std::make_unique<ExpNode>(std::move(operand_folded));
+}
