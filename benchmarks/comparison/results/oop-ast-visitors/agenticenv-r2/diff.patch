+}
+
+void DiffVisitor::visit(const MulNode& node) {
+    // Product rule: (f * g)' = f' * g + f * g'
+    node.left->accept(*this);
+    Ptr left_diff = std::move(result);
+    node.right->accept(*this);
+    Ptr right_diff = std::move(result);
+    
+    // Clone the operands using the visitor pattern
+    CloneVisitor clone_visitor;
+    node.right->accept(clone_visitor);
+    Ptr right_clone = std::move(clone_visitor.get_result());
+    
+    clone_visitor = CloneVisitor();
+    node.left->accept(clone_visitor);
+    Ptr left_clone = std::move(clone_visitor.get_result());
+    
+    Ptr left_term = std::make_unique<MulNode>(std::move(left_diff), std::move(right_clone));
+    Ptr right_term = std::make_unique<MulNode>(std::move(left_clone), std::move(right_diff));
+    result = std::make_unique<AddNode>(std::move(left_term), std::move(right_term));
+}
+
+void DiffVisitor::visit(const NegNode& node) {
+    node.operand->accept(*this);
+    Ptr operand_diff = std::move(result);
+    result = std::make_unique<NegNode>(std::move(operand_diff));
+}
+
+void DiffVisitor::visit(const PowNode& node) {
+    // Power rule: (f^n)' = n * f^(n-1) * f'
+    if (node.exponent == 0.0) {
+        result = std::make_unique<NumNode>(0.0);
+        return;
+    }
+    
+    node.base->accept(*this);
+    Ptr base_diff = std::move(result);
+    
+    // Clone the base using the visitor pattern
+    CloneVisitor clone_visitor;
+    node.base->accept(clone_visitor);
+    Ptr base_clone = std::move(clone_visitor.get_result());
+    
+    // Create the derivative: n * base^(n-1) * base'
+    Ptr base_pow = std::make_unique<PowNode>(std::move(base_clone), node.exponent - 1);
+    Ptr coeff = std::make_unique<NumNode>(node.exponent);
+    Ptr term1 = std::make_unique<MulNode>(std::move(coeff), std::move(base_pow));
+    result = std::make_unique<MulNode>(std::move(term1), std::move(base_diff));
+}
+
+void DiffVisitor::visit(const ExpNode& node) {
+    // Derivative of exp(f) is exp(f) * f'
+    node.operand->accept(*this);
+    Ptr operand_diff = std::move(result);
+    
+    // Clone the operand using the visitor pattern
+    CloneVisitor clone_visitor;
+    node.operand->accept(clone_visitor);
+    Ptr operand_clone = std::move(clone_visitor.get_result());
+    
+    result = std::make_unique<MulNode>(std::make_unique<ExpNode>(std::move(operand_clone)), std::move(operand_diff));
+}
+
+void DiffVisitor::visit(const LogNode& node) {
+    // Derivative of log(f) is (1/f) * f'
+    node.operand->accept(*this);
+    Ptr operand_diff = std::move(result);
+    // Create 1/f as a division (which is 1 * f^(-1))
+    Ptr reciprocal = std::make_unique<PowNode>(node.operand->clone(), -1.0);
+    result = std::make_unique<MulNode>(std::move(reciprocal), std::move(operand_diff));
+}
