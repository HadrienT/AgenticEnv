+void PrintVisitor::visit(const AddNode& node) {
+    // Addition precedence is 1
+    bool need_parens_left = (node.left->precedence() < 1);
+    bool need_parens_right = (node.right->precedence() < 1);
+    
+    std::string left_str, right_str;
+    
+    // Create a temporary visitor to get left string
+    PrintVisitor left_visitor;
+    node.left->accept(left_visitor);
+    left_str = left_visitor.get_result();
+    
+    // Create a temporary visitor to get right string
+    PrintVisitor right_visitor;
+    node.right->accept(right_visitor);
+    right_str = right_visitor.get_result();
+    
+    if (need_parens_left) {
+        left_str = "(" + left_str + ")";
+    }
+    
+    if (need_parens_right) {
+        right_str = "(" + right_str + ")";
+    }
+    
+    result = left_str + " + " + right_str;
+}
+
+void PrintVisitor::visit(const SubNode& node) {
+    // Subtraction precedence is 1
+    bool need_parens_left = (node.left->precedence() < 1);
+    bool need_parens_right = (node.right->precedence() < 1);
+    
+    std::string left_str, right_str;
+    
+    // Create a temporary visitor to get left string
+    PrintVisitor left_visitor;
+    node.left->accept(left_visitor);
+    left_str = left_visitor.get_result();
+    
+    // Create a temporary visitor to get right string
+    PrintVisitor right_visitor;
+    node.right->accept(right_visitor);
+    right_str = right_visitor.get_result();
+    
+    if (need_parens_left) {
+        left_str = "(" + left_str + ")";
+    }
+    
+    if (need_parens_right) {
+        right_str = "(" + right_str + ")";
+    }
+    
+    result = left_str + " - " + right_str;
+}
+
+void PrintVisitor::visit(const MulNode& node) {
+    // Multiplication precedence is 2
+    bool need_parens_left = (node.left->precedence() < 2);
+    bool need_parens_right = (node.right->precedence() < 2);
+    
+    std::string left_str, right_str;
+    
+    // Create a temporary visitor to get left string
+    PrintVisitor left_visitor;
+    node.left->accept(left_visitor);
+    left_str = left_visitor.get_result();
+    
+    // Create a temporary visitor to get right string
