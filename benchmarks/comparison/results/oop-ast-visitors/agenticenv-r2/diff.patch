+    node.base->accept(base_visitor);
+    std::string base_str = base_visitor.get_result();
+    
+    if (need_parens_left) {
+        result = "(" + base_str + ")^" + std::to_string(node.exponent);
+    } else {
+        result = base_str + "^" + std::to_string(node.exponent);
+    }
+}
