+// Eval visitor
+class EvalVisitor : public Visitor {
+public:
+    const Env& env;
+    double result;
+    
+    EvalVisitor(const Env& e) : env(e) {}
+    
+    void visit(const Num& n) override {
+        result = n.value;
+    }
+    
+    void visit(const Var& n) override {
+        auto it = env.find(n.name);
+        if (it == env.end()) {
+            throw std::out_of_range("Unknown variable: " + n.name);
+        }
+        result = it->second;
+    }
+    
+    void visit(const Add& n) override {
+        EvalVisitor v1(env);
+        EvalVisitor v2(env);
+        n.a->accept(v1);
+        n.b->accept(v2);
+        result = v1.result + v2.result;
+    }
+    
+    void visit(const Sub& n) override {
+        EvalVisitor v1(env);
+        EvalVisitor v2(env);
+        n.a->accept(v1);
+        n.b->accept(v2);
+        result = v1.result - v2.result;
+    }
+    
+    void visit(const Mul& n) override {
+        EvalVisitor v1(env);
+        EvalVisitor v2(env);
+        n.a->accept(v1);
+        n.b->accept(v2);
+        result = v1.result * v2.result;
+    }
+    
+    void visit(const Neg& n) override {
+        EvalVisitor v1(env);
+        n.a->accept(v1);
+        result = -v1.result;
+    }
+    
+    void visit(const Pow& n) override {
+        EvalVisitor v1(env);
+        n.base->accept(v1);
+        result = std::pow(v1.result, n.exponent);
+    }
+    
+    void visit(const Exp& n) override {
+        EvalVisitor v1(env);
+        n.a->accept(v1);
+        result = std::exp(v1.result);
+    }
+    
+    void visit(const Log& n) override {
+        EvalVisitor v1(env);
+        n.a->accept(v1);
+        result = std::log(v1.result);
+    }
+    
+    void visit(const Div& n) override {
+        EvalVisitor v1(env);
+        EvalVisitor v2(env);
+        n.a->accept(v1);
+        n.b->accept(v2);
+        result = v1.result / v2.result;
+    }
+};
+
+// Print visitor
+class PrintVisitor : public Visitor {
+public:
+    std::string result;
+    int precedence;
+    
+    PrintVisitor() : precedence(0) {}
+    
+    void visit(const Num& n) override {
+        std::ostringstream oss;
+        oss.precision(17);
+        oss << n.value;
+        result = oss.str();
+        precedence = 0;
+    }
+    
+    void visit(const Var& n) override {
+        result = n.name;
+        precedence = 0;
+    }
+    
+    void visit(const Add& n) override {
+        PrintVisitor v1, v2;
+        n.a->accept(v1);
+        n.b->accept(v2);
+        if (v1.precedence > 2 || (v1.precedence == 2 && v2.precedence >= 2)) {
+            result = "(" + v1.result + ") + " + v2.result;
+        } else {
+            result = v1.result + " + " + v2.result;
+        }
+        precedence = 2;
+    }
+    
+    void visit(const Sub& n) override {
+        PrintVisitor v1, v2;
+        n.a->accept(v1);
+        n.b->accept(v2);
+        if (v1.precedence > 2 || (v1.precedence == 2 && v2.precedence >= 2)) {
+            result = "(" + v1.result + ") - " + v2.result;
+        } else {
+            result = v1.result + " - " + v2.result;
+        }
+        precedence = 2;
+    }
+    
+    void visit(const Mul& n) override {
+        PrintVisitor v1, v2;
+        n.a->accept(v1);
+        n.b->accept(v2);
+        if (v1.precedence > 3 || (v1.precedence == 3 && v2.precedence >= 3)) {
+            result = "(" + v1.result + ") * " + v2.result;
+        } else {
+            result = v1.result + " * " + v2.result;
+        }
+        precedence = 3;
+    }
+    
+    void visit(const Neg& n) override {
+        PrintVisitor v1;
+        n.a->accept(v1);
+        if (v1.precedence > 1) {
+            result = "-(" + v1.result + ")";
+        } else {
+            result = "-" + v1.result;
+        }
+        precedence = 1;
+    }
+    
+    void visit(const Pow& n) override {
+        PrintVisitor v1;
+        n.base->accept(v1);
+        std::ostringstream oss;
+        oss.precision(17);
+        oss << n.exponent;
+        result = v1.result + "^" + oss.str();
+        precedence = 4;
+    }
+    
+    void visit(const Exp& n) override {
+        PrintVisitor v1;
+        n.a->accept(v1);
+        result = "exp(" + v1.result + ")";
+        precedence = 0;
+    }
+    
+    void visit(const Log& n) override {
+        PrintVisitor v1;
+        n.a->accept(v1);
+        result = "log(" + v1.result + ")";
+        precedence = 0;
+    }
+    
+    void visit(const Div& n) override {
+        PrintVisitor v1, v2;
+        n.a->accept(v1);
+        n.b->accept(v2);
+        result = v1.result + " / " + v2.result;
+        precedence = 3; // Division has same precedence as multiplication
+    }
+};
