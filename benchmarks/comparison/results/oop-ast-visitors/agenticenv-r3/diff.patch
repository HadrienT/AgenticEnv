+        }
+        
+        result = log_(std::move(v1.result));
+    }
+    
+    void visit(const Div& n) override {
+        FoldVisitor v1, v2;
+        n.a->accept(v1);
+        n.b->accept(v2);
+        
+        // Try to evaluate if both are numbers
+        if (auto* num1 = dynamic_cast<Num*>(v1.result.get())) {
+            if (auto* num2 = dynamic_cast<Num*>(v2.result.get())) {
+                result = num(num1->value / num2->value);
+                return;
+            }
+        }
+        
+        result = div(std::move(v1.result), std::move(v2.result));
+    }
+};
+
+// Diff visitor
+class DiffVisitor : public Visitor {
+public:
+    const std::string& var;
+    Ptr result;
+    
+    DiffVisitor(const std::string& v) : var(v) {}
+    
+    void visit(const Num& n) override {
+        result = num(0.0);
+    }
+    
+    void visit(const Var& n) override {
+        if (n.name == var) {
+            result = num(1.0);
+        } else {
+            result = num(0.0);
+        }
+    }
+    
+    void visit(const Add& n) override {
+        DiffVisitor v1(var);
+        DiffVisitor v2(var);
+        n.a->accept(v1);
+        n.b->accept(v2);
+        result = add(std::move(v1.result), std::move(v2.result));
+    }
+    
+    void visit(const Sub& n) override {
+        DiffVisitor v1(var);
+        DiffVisitor v2(var);
+        n.a->accept(v1);
+        n.b->accept(v2);
+        result = sub(std::move(v1.result), std::move(v2.result));
+    }
+    
+    void visit(const Mul& n) override {
+        DiffVisitor v1(var);
+        DiffVisitor v2(var);
+        n.a->accept(v1);
+        n.b->accept(v2);
+        result = add(mul(std::move(v1.result), n.b->clone()), mul(n.a->clone(), std::move(v2.result)));
+    }
+    
+    void visit(const Neg& n) override {
+        DiffVisitor v1(var);
+        n.a->accept(v1);
+        result = neg(std::move(v1.result));
+    }
+    
+    void visit(const Pow& n) override {
+        if (n.exponent == 0.0) {
+            result = num(0.0);
+        } else if (n.exponent == 1.0) {
+            DiffVisitor v1(var);
+            n.base->accept(v1);
+            result = std::move(v1.result);
+        } else {
+            // For u^n, derivative is n*u^(n-1)*u'
+            DiffVisitor v1(var);
+            n.base->accept(v1);
+            result = mul(num(n.exponent), mul(pow_(n.base->clone(), n.exponent - 1), std::move(v1.result)));
+        }
+    }
+    
+    void visit(const Exp& n) override {
+        DiffVisitor v1(var);
+        n.a->accept(v1);
+        // Derivative of exp(u) is exp(u)*u'
+        result = mul(exp_(n.a->clone()), std::move(v1.result));
+    }
+    
+    void visit(const Log& n) override {
+        DiffVisitor v1(var);
+        n.a->accept(v1);
+        // Derivative of log(u) is 1/u*u'
+        result = div(v1.result, n.a->clone());
+    }
+    
+    void visit(const Div& n) override {
+        DiffVisitor v1(var);
+        DiffVisitor v2(var);
+        n.a->accept(v1);
+        n.b->accept(v2);
+        // Derivative of (u/v) is (u'*v - u*v')/(v^2)
+        result = div(sub(mul(std::move(v1.result), n.b->clone()), mul(n.a->clone(), std::move(v2.result))), 
+                    pow_(n.b->clone(), 2.0));
+    }
+};
+
+// Free functions implementation
+Ptr num(double v) {
+    return Ptr(new Num(v));
 }
+
+Ptr var(std::string name) {
+    return Ptr(new Var(std::move(name)));
+}
+
+Ptr add(Ptr a, Ptr b) {
+    return Ptr(new Add(std::move(a), std::move(b)));
+}
+
+Ptr sub(Ptr a, Ptr b) {
+    return Ptr(new Sub(std::move(a), std::move(b)));
+}
+
+Ptr mul(Ptr a, Ptr b) {
+    return Ptr(new Mul(std::move(a), std::move(b)));
+}
+
+Ptr div(Ptr a, Ptr b) {
+    return Ptr(new Div(std::move(a), std::move(b)));
+}
+
+Ptr neg(Ptr a) {
+    return Ptr(new Neg(std::move(a)));
+}
+
+Ptr pow_(Ptr base, double exponent) {
+    return Ptr(new Pow(std::move(base), exponent));
+}
+
+Ptr exp_(Ptr a) {
+    return Ptr(new Exp(std::move(a)));
+}
+
+Ptr log_(Ptr a) {
+    return Ptr(new Log(std::move(a)));
+}
+
+double eval(const Node& n, const Env& env) {
+    EvalVisitor v(env);
+    n.accept(v);
+    return v.result;
+}
+
+std::string print(const Node& n) {
+    PrintVisitor v;
+    n.accept(v);
+    return v.result;
+}
+
+std::set<std::string> vars(const Node& n) {
+    VarsVisitor v;
+    n.accept(v);
+    return v.result;
+}
+
+Ptr clone(const Node& n) {
+    CloneVisitor v;
+    n.accept(v);
+    return std::move(v.result);
+}
+
+Ptr fold(const Node& n) {
+    // Apply fold until no more changes
+    Ptr current = clone(n);
+    Ptr next;
+    bool changed = true;
+    while (changed) {
+        changed = false;
+        FoldVisitor v;
+        current->accept(v);
+        next = std::move(v.result);
+        // Check if there's a change
+        if (next.get() != current.get()) {
+            changed = true;
+            current = std::move(next);
+        }
+    }
+    return current;
+}
+
+Ptr diff(const Node& n, const std::string& x) {
+    DiffVisitor v(x);
+    n.accept(v);
+    return std::move(v.result);
+}
+} // namespace ast
