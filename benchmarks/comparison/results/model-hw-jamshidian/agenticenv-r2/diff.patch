+++ b/test_hw.cpp
@@ -0,0 +1,30 @@
+#include "hw.hpp"
+#include <iostream>
+#include <cmath>
+
+int main() {
+    // Test with a flat discount curve (constant rate)
+    auto discount = [](double t) { return std::exp(-0.05 * t); };
+    
+    model::HullWhite hw(0.1, 0.01, discount);
+    
+    // Test bond price
+    double bond_price = hw.zcb(0.0, 1.0, 0.05);
+    std::cout << "Bond price P(0,1) = " << bond_price << std::endl;
+    
+    // Test option prices
+    double call_price = hw.zcb_call(0.95, 0.5, 1.0);
+    double put_price = hw.zcb_put(0.95, 0.5, 1.0);
+    std::cout << "Call option price = " << call_price << std::endl;
+    std::cout << "Put option price = " << put_price << std::endl;
+    
+    // Test swaption with a more reasonable strike
+    double swaption_price = hw.swaption(true, 0.0, 2, 0.5, 0.06);
+    std::cout << "Swaption price = " << swaption_price << std::endl;
+    
+    // Test forward swap rate
+    double swap_rate = hw.forward_swap_rate(0.0, 2, 0.5);
+    std::cout << "Forward swap rate = " << swap_rate << std::endl;
+    
+    return 0;
+}
