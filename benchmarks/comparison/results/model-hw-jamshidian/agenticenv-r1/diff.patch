+#include "hw.hpp"
+#include <iostream>
+#include <cmath>
+
+int main() {
+    // Test with a flat discount curve (flat yield curve)
+    auto flat_discount = [](double t) { return 0.05; }; // 5% flat rate
+    
+    model::HullWhite hw(0.1, 0.01, flat_discount); // a=0.1, sigma=0.01
+    
+    // Test bond price
+    double bond_price = hw.zcb(0.0, 1.0, 0.05);
+    std::cout << "Bond price P(0,1) = " << bond_price << std::endl;
+    
+    // Test option prices
+    double call_price = hw.zcb_call(0.95, 0.5, 1.0);
+    double put_price = hw.zcb_put(0.95, 0.5, 1.0);
+    std::cout << "Call option price = " << call_price << std::endl;
+    std::cout << "Put option price = " << put_price << std::endl;
+    
+    // Test swaption
+    double swaption_price = hw.swaption(true, 0.0, 4, 0.25, 0.05);
+    std::cout << "Swaption price = " << swaption_price << std::endl;
+    
+    // Test forward swap rate
+    double swap_rate = hw.forward_swap_rate(0.0, 4, 0.25);
+    std::cout << "Forward swap rate = " << swap_rate << std::endl;
+    
+    // Test with a more realistic example
+    std::cout << "\n--- Testing with different parameters ---" << std::endl;
+    model::HullWhite hw2(0.2, 0.02, flat_discount);
+    double bond_price2 = hw2.zcb(0.0, 2.0, 0.05);
+    std::cout << "Bond price P(0,2) with higher a = " << bond_price2 << std::endl;
+    
+    return 0;
+}
