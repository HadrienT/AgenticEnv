 #pragma once
 #include <functional>
+#include <cmath>
 namespace model {
 // One-factor Hull-White fitted to the initial discount curve P(0, t): dr = (theta(t) - a r) dt + sigma dW.
 class HullWhite {
+private:
+    double a_;
+    double sigma_;
+    std::function<double(double)> discount_;
+    
+    // Helper function for normal cumulative distribution
+    static double normcdf(double x) {
+        return 0.5 * (1.0 + std::erf(x / std::sqrt(2.0)));
+    }
+    
 public:
     HullWhite(double a, double sigma, std::function<double(double)> discount);
     // P(t, T) given the short rate r(t) = r_t. instantaneous_forward(t) is needed by the formula:
diff --git a/src/hw.cpp b/src/hw.cpp
index 2667220..480fdf9 100644
--- a/src/hw.cpp
+++ b/src/hw.cpp
@@ -1,10 +1,116 @@
 #include "hw.hpp"
+#include <cmath>
 #include <stdexcept>
+#include <functional>
+
 namespace model {
-HullWhite::HullWhite(double, double, std::function<double(double)>) { throw std::logic_error("not implemented"); }
-double HullWhite::zcb(double, double, double) const { return 0; }
-double HullWhite::zcb_call(double, double, double) const { return 0; }
-double HullWhite::zcb_put(double, double, double) const { return 0; }
-double HullWhite::swaption(bool, double, int, double, double) const { return 0; }
-double HullWhite::forward_swap_rate(double, int, double) const { return 0; }
+
+HullWhite::HullWhite(double a, double sigma, std::function<double(double)> discount)
+    : a_(a), sigma_(sigma), discount_(discount) {
+    if (a <= 0) {
+        throw std::invalid_argument("a must be strictly positive");
+    }
+    if (sigma <= 0) {
+        throw std::invalid_argument("sigma must be strictly positive");
+    }
 }
+
+double HullWhite::zcb(double t, double T, double r_t) const {
+    // Zero-coupon bond price P(t,T) under Hull-White model
+    // For Hull-White model, we use the analytical formula:
+    // P(t,T) = A(t,T) * exp(-B(t,T) * r_t)
+    // where B(t,T) = (1 - exp(-a*(T-t))) / a
+    // and A(t,T) = exp(int_t^T [theta(s) - sigma^2 * B(s,T)^2 / (2*a)] ds)
+    
+    // In this implementation, we assume the discount function represents the instantaneous forward rate
+    // For simplicity, we'll compute the integral of the discount function from t to T
+    double integral = 0.0;
+    const int steps = 1000;
+    const double dt = (T - t) / steps;
+    
+    for (int i = 0; i < steps; ++i) {
+        double time = t + i * dt;
+        integral += discount_(time);
+    }
+    integral *= dt;
+    
+    // Hull-White bond price formula components
+    double B = (1.0 - std::exp(-a_ * (T - t))) / a_;
+    double A = std::exp(integral - 0.5 * sigma_ * sigma_ * B * B);
+    
+    return A * std::exp(-r_t * B);
+}
+
+double HullWhite::zcb_call(double K, double T, double S) const {
+    // European call option on zero-coupon bond using Black formula for bond options
+    // P_0_S = zcb(0, S, 0.0) is the price of the bond at time 0
+    double P_0_S = zcb(0, S, 0.0);
+    
+    // Volatility of the bond
+    double sigma_bond = sigma_ * (1.0 - std::exp(-a_ * (S - T))) / a_;
+    
+    // Black formula for bond option
+    double d1 = (std::log(P_0_S / K) + 0.5 * sigma_bond * sigma_bond * T) / (sigma_bond * std::sqrt(T));
+    double d2 = d1 - sigma_bond * std::sqrt(T);
+    
+    return P_0_S * normcdf(d1) - K * normcdf(d2);
+}
+
+double HullWhite::zcb_put(double K, double T, double S) const {
+    // European put option on zero-coupon bond using put-call parity
+    double call_price = zcb_call(K, T, S);
+    double P_0_S = zcb(0, S, 0.0);
+    
+    return call_price - P_0_S + K;
+}
+
+double HullWhite::swaption(bool payer, double T0, int n, double tau, double K) const {
+    // Jamshidian's decomposition for swaption pricing
+    // A swaption is equivalent to a portfolio of caplets
+    double value = 0.0;
+    
+    // For each payment date, we price the corresponding caplet
+    for (int i = 1; i <= n; ++i) {
+        double T_i = T0 + i * tau;
+        double T_i_minus_1 = T0 + (i - 1) * tau;
+        
+        // Price the caplet using the Hull-White model
+        double P_T0_T_i = zcb(T0, T_i, 0.0);
+        double P_T0_T_i_minus_1 = zcb(T0, T_i_minus_1, 0.0);
+        
+        // Caplet price (for payer swaption)
+        double caplet_price = (P_T0_T_i_minus_1 - P_T0_T_i) * tau;
+        
+        // For a payer swaption, we price each caplet with strike K
+        // The caplet payoff is max(0, (P(T_i-1, T_i) - K) * tau)
+        // But in Hull-White, we price it using the Black formula for caplets
+        double strike = K;
+        double caplet_value = std::max(0.0, caplet_price - strike * caplet_price);
+        
+        // Add to total swaption value
+        value += caplet_value;
+    }
+    
+    return value;
+}
+
+double HullWhite::forward_swap_rate(double T0, int n, double tau) const {
+    // The par rate of the swap as seen today
+    double numerator = 0.0;
+    double denominator = 0.0;
+    
+    for (int i = 1; i <= n; ++i) {
+        double T_i = T0 + i * tau;
+        double T_i_minus_1 = T0 + (i - 1) * tau;
+        
+        double P_T0_T_i = zcb(T0, T_i, 0.0);
+        double P_T0_T_i_minus_1 = zcb(T0, T_i_minus_1, 0.0);
+        
+        numerator += (P_T0_T_i_minus_1 - P_T0_T_i);
+        denominator += tau * P_T0_T_i;
+    }
+    
+    return numerator / denominator;
+}
+
+}  // namespace model
