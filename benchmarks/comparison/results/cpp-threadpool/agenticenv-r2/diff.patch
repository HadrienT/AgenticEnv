diff --git a/test_exception.cpp b/test_exception.cpp
new file mode 100644
index 0000000..3f51f62
--- /dev/null
+++ b/test_exception.cpp
@@ -0,0 +1,26 @@
+#include "include/thread_pool.hpp"
+#include <iostream>
+#include <cassert>
+#include <stdexcept>
+
+int main() {
+    // Test exception handling in parallel_for
+    qm::ThreadPool pool(2);
+    
+    bool exception_thrown = false;
+    try {
+        pool.parallel_for(0, 10, [&](std::size_t i) {
+            if (i == 5) {
+                throw std::runtime_error("Test exception");
+            }
+        });
+    } catch (const std::runtime_error& e) {
+        exception_thrown = true;
+        assert(std::string(e.what()) == "Test exception");
+    }
+    
+    assert(exception_thrown);
+    
+    std::cout << "Exception test passed!" << std::endl;
+    return 0;
+}
