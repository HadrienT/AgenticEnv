+#include "include/thread_pool.hpp"
+#include <iostream>
+#include <cassert>
+#include <chrono>
+
+int main() {
+    // Test basic functionality
+    qm::ThreadPool pool(4);
+    
+    // Test submit and wait
+    auto future1 = pool.submit([]() { return 42; });
+    auto result1 = future1.get();
+    assert(result1 == 42);
+    
+    // Test wait method
+    auto future2 = pool.submit([]() { 
+        std::this_thread::sleep_for(std::chrono::milliseconds(100));
+        return 100; 
+    });
+    auto result2 = pool.wait(future2);
+    assert(result2 == 100);
+    
+    // Test parallel_for
+    std::vector<int> results(10);
+    pool.parallel_for(0, 10, [&](std::size_t i) {
+        results[i] = static_cast<int>(i * 2);
+    });
+    
+    for (std::size_t i = 0; i < results.size(); ++i) {
+        assert(results[i] == static_cast<int>(i * 2));
+    }
+    
+    std::cout << "All tests passed!" << std::endl;
+    return 0;
+}
