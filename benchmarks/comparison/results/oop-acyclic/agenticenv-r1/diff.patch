diff --git a/include/acyclic.hpp b/include/acyclic.hpp
index 6f70f09..2a1f916 100644
--- a/include/acyclic.hpp
+++ b/include/acyclic.hpp
@@ -1 +1,54 @@
 #pragma once
+#include <string>
+#include <stdexcept>
+
+namespace trade {
+
+class UnsupportedTrade : public std::runtime_error {
+public:
+    UnsupportedTrade(const std::string& type_name) 
+        : std::runtime_error("Unsupported trade type: " + type_name) {}
+};
+
+struct VisitorBase {
+    virtual ~VisitorBase() = default;
+};
+
+template <class T>
+struct Visitor : virtual public VisitorBase {
+    virtual ~Visitor() = default;
+    virtual void visit(const T&) = 0;
+};
+
+struct Trade {
+    virtual ~Trade() = default;
+    virtual void accept(VisitorBase&) const = 0;
+    virtual bool try_accept(VisitorBase&) const = 0;
+    virtual std::string type_name() const = 0;
+};
+
+template <class Derived>
+struct VisitableTrade : Trade {
+    void accept(VisitorBase& v) const override {
+        if (auto* visitor = dynamic_cast<Visitor<Derived>*>(&v)) {
+            visitor->visit(static_cast<const Derived&>(*this));
+        } else {
+            throw UnsupportedTrade{type_name()};
+        }
+    }
+
+    bool try_accept(VisitorBase& v) const override {
+        if (auto* visitor = dynamic_cast<Visitor<Derived>*>(&v)) {
+            visitor->visit(static_cast<const Derived&>(*this));
+            return true;
+        } else {
+            return false;
+        }
+    }
+
+    std::string type_name() const override {
+        return Derived::type_name_static();
+    }
+};
+
+} // namespace trade
diff --git a/include/trades.hpp b/include/trades.hpp
index 6f70f09..aa7aef5 100644
--- a/include/trades.hpp
+++ b/include/trades.hpp
@@ -1 +1,31 @@
 #pragma once
+#include "acyclic.hpp"
+#include <string>
+
+namespace trade {
+
+struct Swap : VisitableTrade<Swap> {
+    Swap(double notional, double rate);
+    double notional, rate;
+    static std::string type_name_static() { return "Swap"; }
+    std::string type_name() const override { return type_name_static(); }
+};
+
+struct Bond : VisitableTrade<Bond> {
+    Bond(double face);
+    double face;
+    static std::string type_name_static() { return "Bond"; }
+    std::string type_name() const override { return type_name_static(); }
+};
+
+class NotionalVisitor : public Visitor<Swap>, public Visitor<Bond> {
+public:
+    double total() const { return total_notional_; }
+    void visit(const Swap& swap) override { total_notional_ += swap.notional; }
+    void visit(const Bond& bond) override { total_notional_ += bond.face; }
+
+private:
+    double total_notional_ = 0.0;
+};
+
+} // namespace trade
