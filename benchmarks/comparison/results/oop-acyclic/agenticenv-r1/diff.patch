diff --git a/test_acyclic_advanced.cpp b/test_acyclic_advanced.cpp
new file mode 100644
index 0000000..66138e7
--- /dev/null
+++ b/test_acyclic_advanced.cpp
@@ -0,0 +1,76 @@
+#include "trades.hpp"
+#include <iostream>
+
+// Create a new trade type in a separate translation unit
+struct Future : trade::VisitableTrade<Future> {
+    Future(double notional) : notional(notional) {}
+    double notional;
+    static std::string type_name_static() { return "Future"; }
+    std::string type_name() const override { return type_name_static(); }
+};
+
+// Create a new visitor for Future trades
+class FutureVisitor : public trade::Visitor<Future> {
+public:
+    double total() const { return total_notional_; }
+    void visit(const Future& future) override { total_notional_ += future.notional; }
+
+private:
+    double total_notional_ = 0.0;
+};
+
+int main() {
+    trade::Swap swap(1000000.0, 0.05);
+    trade::Bond bond(500000.0);
+    Future future(2000000.0);
+    
+    // Test that we can create trades and access their type names
+    std::cout << "Swap type: " << swap.type_name() << std::endl;
+    std::cout << "Bond type: " << bond.type_name() << std::endl;
+    std::cout << "Future type: " << future.type_name() << std::endl;
+    
+    // Test that we can create a visitor for existing trades
+    trade::NotionalVisitor notional_visitor;
+    
+    // Test that the visitor can visit existing trade types
+    try {
+        swap.accept(notional_visitor);
+        bond.accept(notional_visitor);
+        std::cout << "Total notional (existing trades): " << notional_visitor.total() << std::endl;
+    } catch (const std::exception& e) {
+        std::cout << "Error with existing trades: " << e.what() << std::endl;
+        return 1;
+    }
+    
+    // Test that we can create a visitor for new trade types
+    FutureVisitor future_visitor;
+    
+    try {
+        future.accept(future_visitor);
+        std::cout << "Total notional (future trade): " << future_visitor.total() << std::endl;
+    } catch (const std::exception& e) {
+        std::cout << "Error with future trade: " << e.what() << std::endl;
+        return 1;
+    }
+    
+    // Test that trying to accept a Future trade with NotionalVisitor throws an exception
+    try {
+        future.accept(notional_visitor);
+        std::cout << "ERROR: Future trade was accepted by NotionalVisitor (should have thrown)!" << std::endl;
+        return 1;
+    } catch (const trade::UnsupportedTrade& e) {
+        std::cout << "Correctly caught UnsupportedTrade: " << e.what() << std::endl;
+    } catch (const std::exception& e) {
+        std::cout << "Unexpected error: " << e.what() << std::endl;
+        return 1;
+    }
+    
+    // Test try_accept functionality
+    if (future.try_accept(notional_visitor)) {
+        std::cout << "Future trade was accepted by NotionalVisitor (unexpected)" << std::endl;
+    } else {
+        std::cout << "Future trade correctly rejected by NotionalVisitor (try_accept returned false)" << std::endl;
+    }
+    
+    return 0;
+}
