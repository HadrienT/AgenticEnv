+// Simple matrix operations for least squares regression
+std::vector<double> solve_least_squares(const std::vector<std::vector<double>>& A, 
+                                       const std::vector<double>& b) {
+    int n_points = A.size();
+    int n_basis = A[0].size();
+    
+    // Simple approach: solve using normal equations (A^T * A) * x = A^T * b
+    // Create A^T * A matrix (n_basis x n_basis)
+    std::vector<std::vector<double>> ATA(n_basis, std::vector<double>(n_basis, 0.0));
+    for (int i = 0; i < n_basis; ++i) {
+        for (int j = 0; j < n_basis; ++j) {
+            for (int k = 0; k < n_points; ++k) {
+                ATA[i][j] += A[k][i] * A[k][j];
+            }
+        }
+    }
+    
+    // Create A^T * b vector (n_basis)
+    std::vector<double> ATb(n_basis, 0.0);
+    for (int i = 0; i < n_basis; ++i) {
+        for (int k = 0; k < n_points; ++k) {
+            ATb[i] += A[k][i] * b[k];
+        }
+    }
+    
+    // Solve using Gaussian elimination with partial pivoting
+    std::vector<std::vector<double>> augmented(ATA);
+    for (int i = 0; i < n_basis; ++i) {
+        augmented[i].push_back(ATb[i]);
+    }
+    
+    // Forward elimination
+    for (int i = 0; i < n_basis; ++i) {
+        // Find pivot
+        int pivot_row = i;
+        for (int j = i + 1; j < n_basis; ++j) {
+            if (std::abs(augmented[j][i]) > std::abs(augmented[pivot_row][i])) {
+                pivot_row = j;
+            }
+        }
+        
+        // Swap rows
+        if (pivot_row != i) {
+            std::swap(augmented[i], augmented[pivot_row]);
+        }
+        
+        // Eliminate
+        for (int j = i + 1; j < n_basis; ++j) {
+            double factor = augmented[j][i] / augmented[i][i];
+            for (int k = i; k <= n_basis; ++k) {
+                augmented[j][k] -= factor * augmented[i][k];
+            }
+        }
+    }
+    
+    // Back substitution
+    std::vector<double> x(n_basis, 0.0);
+    for (int i = n_basis - 1; i >= 0; --i) {
+        double sum = 0.0;
+        for (int j = i + 1; j < n_basis; ++j) {
+            sum += augmented[i][j] * x[j];
+        }
+        x[i] = (augmented[i][n_basis] - sum) / augmented[i][i];
+    }
+    
+    return x;
+}
