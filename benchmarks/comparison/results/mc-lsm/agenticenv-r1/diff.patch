+// Polynomial basis functions of degree 3
+inline double basis_func(int i, double x) {
+    switch (i) {
+        case 0: return 1.0;
+        case 1: return x;
+        case 2: return x * x;
+        case 3: return x * x * x;
+        default: return 0.0;
+    }
 }
