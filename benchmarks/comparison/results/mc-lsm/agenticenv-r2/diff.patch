+// Helper function to generate standard normal random numbers
+inline double normal_random(std::mt19937& gen) {
+    static std::normal_distribution<double> dist(0.0, 1.0);
+    return dist(gen);
 }
+
+// Polynomial basis functions of degree 3
+inline std::vector<double> polynomial_basis(double x) {
+    return {1.0, x, x*x, x*x*x};
+}
+
+// Simple linear regression for polynomial fitting (using normal equation)
+std::vector<double> least_squares_regression(const std::vector<std::vector<double>>& X, 
+                                           const std::vector<double>& y) {
+    int n = X.size();
+    int m = X[0].size();
+    
+    // Create matrix X^T * X and vector X^T * y
+    std::vector<std::vector<double>> XtX(m, std::vector<double>(m, 0.0));
+    std::vector<double> XtY(m, 0.0);
+    
+    for (int i = 0; i < n; ++i) {
+        for (int j = 0; j < m; ++j) {
+            XtY[j] += X[i][j] * y[i];
+            for (int k = 0; k < m; ++k) {
+                XtX[j][k] += X[i][j] * X[i][k];
+            }
+        }
+    }
+    
+    // Solve the linear system XtX * coeffs = XtY using Gaussian elimination
+    std::vector<double> coeffs(m, 0.0);
+    
+    // Forward elimination
+    for (int i = 0; i < m; ++i) {
+        double pivot = XtX[i][i];
+        if (std::abs(pivot) < 1e-12) {
+            // Handle singular matrix - return zeros
+            return std::vector<double>(m, 0.0);
+        }
+        for (int j = i; j < m; ++j) {
+            XtX[i][j] /= pivot;
+        }
+        XtY[i] /= pivot;
+        
+        for (int k = i + 1; k < m; ++k) {
+            double factor = XtX[k][i];
+            for (int j = i; j < m; ++j) {
+                XtX[k][j] -= factor * XtX[i][j];
+            }
+            XtY[k] -= factor * XtY[i];
+        }
+    }
+    
+    // Back substitution
+    for (int i = m - 1; i >= 0; --i) {
+        coeffs[i] = XtY[i];
+        for (int j = i + 1; j < m; ++j) {
+            coeffs[i] -= XtX[i][j] * coeffs[j];
+        }
+    }
+    
+    return coeffs;
+}
+
+McResult american_put_lsm(double S0, double K, double r, double sigma, double T, int steps,
+                          std::int64_t paths, std::uint64_t seed) {
+    // Generate random number generator
+    std::mt19937 gen(seed);
+    
+    // Time step
+    double dt = T / steps;
+    
+    // Precompute discount factor
+    double discount = std::exp(-r * dt);
+    
+    // Generate all paths at once for efficiency
+    std::vector<std::vector<double>> paths_data(paths, std::vector<double>(steps + 1));
+    
+    // Generate paths using the Euler method
+    for (std::int64_t i = 0; i < paths; ++i) {
+        paths_data[i][0] = S0;
+        for (int j = 1; j <= steps; ++j) {
+            double z = normal_random(gen);
+            paths_data[i][j] = paths_data[i][j-1] * std::exp((r - 0.5 * sigma * sigma) * dt + sigma * std::sqrt(dt) * z);
+        }
+    }
+    
+    // Initialize exercise values (put option)
+    std::vector<std::vector<double>> exercise_values(paths, std::vector<double>(steps + 1));
+    for (std::int64_t i = 0; i < paths; ++i) {
+        for (int j = 0; j <= steps; ++j) {
+            exercise_values[i][j] = std::max(0.0, K - paths_data[i][j]);
+        }
+    }
+    
+    // Backward induction for continuation values
+    // Work backwards from step steps-1 to step 1
+    for (int step = steps - 1; step >= 1; --step) {
+        // For each path, determine if it's in the money at this step
+        std::vector<std::int64_t> in_the_money_indices;
+        
+        for (std::int64_t i = 0; i < paths; ++i) {
+            if (exercise_values[i][step] > 0.0) {
+                in_the_money_indices.push_back(i);
+            }
+        }
+        
+        // If no paths are in the money, no regression needed
+        if (in_the_money_indices.empty()) {
+            continue;
+        }
+        
+        // Perform least squares regression
+        std::vector<std::vector<double>> X(in_the_money_indices.size(), std::vector<double>(4));
+        std::vector<double> y(in_the_money_indices.size());
+        
+        for (size_t idx = 0; idx < in_the_money_indices.size(); ++idx) {
+            int i = in_the_money_indices[idx];
+            auto basis = polynomial_basis(paths_data[i][step]);
+            for (size_t j = 0; j < basis.size(); ++j) {
+                X[idx][j] = basis[j];
+            }
+            // Use the continuation value from the next step (discounted)
+            y[idx] = exercise_values[i][step+1] * discount;
+        }
+        
+        // Perform regression
+        std::vector<double> coeffs = least_squares_regression(X, y);
+        
+        // For each path, calculate continuation value and decide whether to exercise
+        for (std::int64_t i = 0; i < paths; ++i) {
+            auto basis = polynomial_basis(paths_data[i][step]);
+            double continuation_value = 0.0;
+            for (size_t j = 0; j < basis.size(); ++j) {
+                continuation_value += coeffs[j] * basis[j];
+            }
+            
+            // If exercise value is greater than continuation value, exercise
+            if (exercise_values[i][step] > continuation_value) {
+                // Update exercise values for all future steps (including current)
+                for (int j = step; j <= steps; ++j) {
+                    exercise_values[i][j] = exercise_values[i][step];
+                }
+            }
+        }
+    }
+    
+    // Calculate the final price
+    std::vector<double> prices(paths);
+    for (std::int64_t i = 0; i < paths; ++i) {
+        prices[i] = exercise_values[i][0];
+    }
+    
+    // Calculate mean price and standard error
+    double mean_price = std::accumulate(prices.begin(), prices.end(), 0.0) / paths;
+    
+    // Calculate standard error
+    double variance = 0.0;
+    for (std::int64_t i = 0; i < paths; ++i) {
+        variance += (prices[i] - mean_price) * (prices[i] - mean_price);
+    }
+    variance /= paths;
+    double std_error = std::sqrt(variance / paths);
+    
+    // Ensure price is never below immediate exercise at t = 0
+    // This is a safety check - in a proper implementation, this should not happen
+    double immediate_exercise = std::max(0.0, K - S0);
+    if (mean_price < immediate_exercise) {
+        mean_price = immediate_exercise;
+    }
+    
+    return {mean_price, std_error};
+}
+
+}  // namespace mc
