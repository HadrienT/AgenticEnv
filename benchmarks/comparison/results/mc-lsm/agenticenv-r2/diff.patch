+#include "lsm.hpp"
+#include <iostream>
+#include <iomanip>
+#include <random>
+
+// Simple test to verify basic functionality
+int main() {
+    // Test with very simple parameters
+    double S0 = 40.0;
+    double K = 40.0;
+    double r = 0.05;
+    double sigma = 0.2;
+    double T = 1.0;
+    int steps = 5;        // Reduced for testing
+    std::int64_t paths = 1000;  // Reduced for testing
+    std::uint64_t seed = 42;
+    
+    std::cout << "Simple test of Longstaff-Schwartz implementation\n";
+    std::cout << "S0 = " << S0 << ", K = " << K << ", r = " << r << ", sigma = " << sigma << ", T = " << T << "\n";
+    std::cout << "Steps = " << steps << ", Paths = " << paths << "\n\n";
+    
+    // Generate some paths manually to verify
+    std::mt19937 gen(seed);
+    std::normal_distribution<double> dist(0.0, 1.0);
+    
+    double dt = T / steps;
+    std::cout << "Time step: " << dt << "\n";
+    
+    // Generate one path manually to see what happens
+    std::vector<double> path(6);
+    path[0] = S0;
+    std::cout << "Path[0] = " << path[0] << "\n";
+    
+    for (int j = 1; j <= steps; ++j) {
+        double z = dist(gen);
+        path[j] = path[j-1] * std::exp((r - 0.5 * sigma * sigma) * dt + sigma * std::sqrt(dt) * z);
+        std::cout << "Path[" << j << "] = " << path[j] << "\n";
+    }
+    
+    // Calculate exercise values
+    std::cout << "\nExercise values:\n";
+    for (int j = 0; j <= steps; ++j) {
+        double exercise = std::max(0.0, K - path[j]);
+        std::cout << "Exercise[" << j << "] = " << exercise << "\n";
+    }
+    
+    return 0;
+}
