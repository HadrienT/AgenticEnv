+#ifndef INSTRUMENT_EQUITY_GAP_HPP
+#define INSTRUMENT_EQUITY_GAP_HPP
+
+#include "quantModeling/instruments/base.hpp"
+#include <memory>
+
+namespace quantModeling
+{
+    struct GapOption final : Instrument
+    {
+        std::shared_ptr<const IPayoff> payoff;
+        std::shared_ptr<const IExercise> exercise;
+        Real trigger;
+        Real notional;
+
+        GapOption(std::shared_ptr<const IPayoff> p, std::shared_ptr<const IExercise> e, Real t, Real n = 1.0)
+            : payoff(std::move(p)), exercise(std::move(e)), trigger(t), notional(n)
+        {
+        }
+
+        void accept(IInstrumentVisitor &v) const override { v.visit(*this); }
+    };
+} // namespace quantModeling
+#endif
