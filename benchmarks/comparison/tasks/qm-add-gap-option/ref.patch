diff --git a/tests/testGap.cpp b/tests/testGap.cpp
new file mode 100644
index 0000000..b0e37ee
--- /dev/null
+++ b/tests/testGap.cpp
@@ -0,0 +1,8 @@
+#include <gtest/gtest.h>
+#include "quantModeling/pricers/registry.hpp"
+namespace quantModeling {
+static PricingResult px(Real K, Real H, bool c) { GapBSInput in{100, K, H, 1, .03, 0, .2, c}; return default_registry().price({InstrumentKind::EquityGapOption, ModelKind::BlackScholes, EngineKind::Analytic, PricingInput{in}}); }
+TEST(Gap, Finite) { EXPECT_TRUE(std::isfinite(px(100, 110, true).npv)); }
+TEST(Gap, CallFallsWithStrike) { EXPECT_GT(px(90, 110, true).npv, px(100, 110, true).npv); }
+TEST(Gap, HasDelta) { EXPECT_TRUE(px(100, 110, false).greeks.delta.has_value()); }
+}
