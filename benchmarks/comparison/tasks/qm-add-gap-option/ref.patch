diff --git a/src/engines/analytic/gap.cpp b/src/engines/analytic/gap.cpp
new file mode 100644
index 0000000..1a44257
--- /dev/null
+++ b/src/engines/analytic/gap.cpp
@@ -0,0 +1,22 @@
+#include "quantModeling/engines/analytic/gap.hpp"
+#include "quantModeling/models/equity/local_vol_model.hpp"
+#include "quantModeling/utils/stats.hpp"
+#include <cmath>
+
+namespace quantModeling
+{
+    void BSGapAnalyticEngine::visit(const GapOption &opt)
+    {
+        const auto &m = require_model<ILocalVolModel>("BSGapAnalyticEngine");
+        const Real S = m.spot0(), r = m.rate_r(), q = m.yield_q(), v = m.vol_sigma();
+        const Real T = opt.exercise->dates().front(), K = opt.payoff->strike(), H = opt.trigger;
+        const bool call = opt.payoff->type() == OptionType::Call;
+        const Real sd = v * std::sqrt(T), d1 = (std::log(S / H) + (r - q + 0.5 * v * v) * T) / sd, d2 = d1 - sd;
+        const Real dfr = m.discount_curve().discount(T), dfq = std::exp(-q * T);
+        PricingResult out;
+        out.npv = opt.notional * (call ? S * dfq * norm_cdf(d1) - K * dfr * norm_cdf(d2) : K * dfr * norm_cdf(-d2) - S * dfq * norm_cdf(-d1));
+        const Real gam = norm_pdf(d1) / (S * sd), gam2 = norm_pdf(d2) / (S * sd);
+        out.greeks.delta = opt.notional * (call ? dfq * norm_cdf(d1) + S * dfq * gam - K * dfr * gam2 : -dfq * norm_cdf(-d1) - S * dfq * gam + K * dfr * gam2);
+        res_ = out;
+    }
+} // namespace quantModeling
diff --git a/src/pricers/adapters/equity_gap.cpp b/src/pricers/adapters/equity_gap.cpp
new file mode 100644
index 0000000..3c34463
--- /dev/null
+++ b/src/pricers/adapters/equity_gap.cpp
@@ -0,0 +1,21 @@
+#include "quantModeling/pricers/adapters/equity_gap.hpp"
+#include "quantModeling/engines/analytic/gap.hpp"
+#include "quantModeling/models/equity/black_scholes.hpp"
+#include "quantModeling/pricers/context.hpp"
+#include "quantModeling/pricers/pricer.hpp"
+#include <memory>
+namespace quantModeling
+{
+    PricingResult price_equity_gap_bs_analytic(const GapBSInput &in)
+    {
+        auto payoff = std::make_shared<PlainVanillaPayoff>(in.is_call ? OptionType::Call : OptionType::Put, static_cast<Real>(in.strike));
+        auto exercise = std::make_shared<EuropeanExercise>(static_cast<Real>(in.maturity));
+        GapOption opt(payoff, exercise, in.trigger);
+        auto model = std::make_shared<BlackScholesModel>(in.spot, in.rate, in.dividend, in.vol);
+        PricingSettings settings;
+        MarketView market = {};
+        PricingContext ctx{market, settings, model};
+        BSGapAnalyticEngine engine(ctx);
+        return price(opt, engine);
+    }
+}
