+#include "quantModeling/instruments/rates/fixed_rate_bond.hpp"
+#include "quantModeling/instruments/rates/zero_coupon_bond.hpp"
+
+namespace quantModeling
+{
+    class BSGapAnalyticEngine final : public EngineBase
+    {
+      public:
+        using EngineBase::EngineBase;
+        void visit(const GapOption &opt) override;
+        void visit(const VanillaOption &) override { throw UnsupportedInstrument("BSGapAnalyticEngine: vanilla."); }
+        void visit(const AsianOption &) override { throw UnsupportedInstrument("BSGapAnalyticEngine: Asian."); }
+        void visit(const BarrierOption &) override { throw UnsupportedInstrument("BSGapAnalyticEngine: barrier."); }
+        void visit(const DigitalOption &) override { throw UnsupportedInstrument("BSGapAnalyticEngine: digital."); }
+        void visit(const EquityFuture &) override { throw UnsupportedInstrument("BSGapAnalyticEngine: future."); }
+        void visit(const ZeroCouponBond &) override { throw UnsupportedInstrument("BSGapAnalyticEngine: bond."); }
+        void visit(const FixedRateBond &) override { throw UnsupportedInstrument("BSGapAnalyticEngine: bond."); }
+    };
+} // namespace quantModeling
+#endif
