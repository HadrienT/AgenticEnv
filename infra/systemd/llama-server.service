[Unit]
Description=llama.cpp server (local LLM inference)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=llm
Group=llm
EnvironmentFile=/etc/llm/llama-server.env
ExecStart=/opt/llm/scripts/run-llama-server.sh
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/llm/logs
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
