[Unit]
Description=llama.cpp server (local LLM inference)
# The CUDA backend needs the driver fully up (issue #15): without it llama.cpp
# silently falls back to CPU. run-llama-server.sh also refuses to start without
# a CUDA device when no_cpu_offload is on.
After=network-online.target nvidia-persistenced.service
Wants=network-online.target nvidia-persistenced.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=llm
Group=llm
EnvironmentFile=/etc/llm/llama-server.env
# /dev/nvidia-uvm is created lazily by the setuid nvidia-modprobe, which
# NoNewPrivileges blocks for the service itself: create it up front as root
# ("+" = full privileges for this line only).
ExecStartPre=+/usr/bin/nvidia-modprobe -u -c=0
ExecStart=/opt/llm/scripts/run-llama-server.sh
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/llm/logs
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
