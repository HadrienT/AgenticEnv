[Unit]
Description=MCP server — kbase (hybrid RAG retrieval)
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=agents
Group=agents
EnvironmentFile=-/etc/agenticenv/mcp-kbase.env
ExecStart=/opt/agents/venvs/kbase-mcp/bin/python -m kbase_mcp.server
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
